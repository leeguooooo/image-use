def _find_agent_browser() -> str | None:
    """Return the chrome-use binary path, or None if it isn't installed."""
    for name in AB_BIN_CANDIDATES:
        path = shutil.which(name)
        if path:
            return path
    return None


def _version_tuple(v: str) -> tuple[int, ...]:
    """Parse a dotted version like '1.5.23' into (1, 5, 23); junk → (0,)."""
    nums = re.findall(r"\d+", v or "")
    return tuple(int(n) for n in nums[:3]) or (0,)


# ---------- terminal output (color, TTY-aware) ----------
# Color is only ever applied to the stderr progress timeline and the `doctor`
# report — stdout stays plain (it carries exactly the saved path, for `$(...)`).

_WARN_WORDS = ("warning", "unavailable", "could not", "couldn't", "failed",
               "stall", "not connected")


def _use_color(stream=None) -> bool:
    """True if we should emit ANSI color to ``stream`` (default stderr).

    Only when it's a real TTY and color isn't disabled — honors NO_COLOR
    (https://no-color.org), IMAGE_USE_NO_COLOR, and TERM=dumb. So piping
    or redirecting (e.g. `2>log`) yields clean plain text automatically."""
    if stream is None:
        stream = sys.stderr
    if os.environ.get("NO_COLOR") or _env("IMAGE_USE_NO_COLOR"):
        return False
    if (os.environ.get("TERM") or "").lower() == "dumb":
        return False
    try:
        return bool(stream.isatty())
    except Exception:  # noqa: BLE001
        return False


def _paint(code: str, s: str, *, stream=None) -> str:
    """Wrap ``s`` in ANSI SGR ``code`` when color is on for ``stream``, else
    return it unchanged."""
    return f"\033[{code}m{s}\033[0m" if _use_color(stream) else s


def _dim(s: str, **kw) -> str: return _paint("2", s, **kw)
def _red(s: str, **kw) -> str: return _paint("31", s, **kw)
def _green(s: str, **kw) -> str: return _paint("32", s, **kw)
def _yellow(s: str, **kw) -> str: return _paint("33", s, **kw)


def _fmt_progress(elapsed: float, msg: str) -> str:
    """One stderr progress line: a dimmed `[  N.Ns]` timestamp + message, with
    warning-ish messages tinted yellow. Plain when color is off."""
    line = f"{_dim(f'[{elapsed:6.1f}s]')} "
    low = msg.lower()
    return line + (_yellow(msg) if any(w in low for w in _WARN_WORDS) else msg)


def _chrome_use_version(ab: str) -> str | None:
    """chrome-use's dotted version (e.g. '1.5.28'), or None if unreadable.
    Shared by the old-version warning and `doctor`."""
    try:
        out = subprocess.run([ab, "--version"], capture_output=True, text=True,
                             timeout=10)
    except Exception:  # noqa: BLE001
        return None
    m = re.search(r"\d+\.\d+\.\d+", (out.stdout or out.stderr or "").strip())
    return m.group(0) if m else None


def _warn_if_chrome_use_old(ab: str, emit) -> None:
    """Soft-warn (never block) if chrome-use is below AB_MIN_VERSION.

    The web backend's img2img (`upload`) and model switch (coordinate `click`)
    need a recent chrome-use; an old binary fails them with an opaque exit code.
    Best-effort: if `--version` can't be read or parsed, stay quiet.
    """
    v = _chrome_use_version(ab)
    if v and _version_tuple(v) < _version_tuple(AB_MIN_VERSION):
        emit(
            f"warning: chrome-use {v} is older than {AB_MIN_VERSION}; "
            f"image-to-image / model-switch may fail. Update with the installer "
            f"at github.com/leeguooooo/chrome-use."
        )


def _codex_token_present() -> bool:
    """True if ~/.codex/auth.json carries a usable ChatGPT OAuth access_token."""
    try:
        auth = json.loads(AUTH_PATH.read_text(encoding="utf-8"))
    except Exception:
        return False
    access, _account, _refresh = _extract_access_token(auth)
    return bool(access)


def _chrome_user_data_dirs() -> list[Path]:
    home = Path.home()
    return [
        home / "Library" / "Application Support" / "Google" / "Chrome",  # macOS
        home / ".config" / "google-chrome",                              # Linux
        home / ".config" / "chromium",
    ]


def _detect_logged_in_profiles(
    host_like: str = "%chatgpt.com%",
    name_clause: str = "name LIKE '__Secure-next-auth.session-token%'",
) -> list[str]:
    """Chrome profile names with a live session for a site, freshest first.

    Read-only and offline: each profile's `Cookies` SQLite is copied and queried
    only for the session cookie's host/expiry — the encrypted value is never read
    or decrypted. Detects *whether* a profile is logged in, not which account.

    Defaults describe chatgpt.com. `_detect_google_profiles` passes the Google
    equivalent; the two differ only in these two SQL fragments, so the scan,
    the safe-copy, and the freshest-first ordering stay in one place.
    """
    import sqlite3

    # Chrome stores expiry as microseconds since 1601-01-01; convert "now".
    chrome_now_us = (time.time() + 11644473600) * 1_000_000
    found: list[tuple[str, int]] = []
    for base in _chrome_user_data_dirs():
        if not base.is_dir():
            continue
        for prof in base.iterdir():
            if not prof.is_dir() or not (prof / "Preferences").exists():
                continue
            db = next((c for c in (prof / "Network" / "Cookies", prof / "Cookies")
                       if c.exists()), None)
            if not db:
                continue
            tmp = None
            try:
                fd, tmp = tempfile.mkstemp(suffix=".db")
                os.close(fd)
                shutil.copy2(db, tmp)
                con = sqlite3.connect(f"file:{tmp}?mode=ro", uri=True)
                row = con.execute(
                    "SELECT MAX(expires_utc) FROM cookies "
                    f"WHERE host_key LIKE '{host_like}' AND {name_clause}"
                ).fetchone()
                con.close()
                exp = row[0] if row else None
                if exp and exp > chrome_now_us:
                    found.append((prof.name, exp))
            except Exception:
                pass
            finally:
                if tmp:
                    try:
                        os.remove(tmp)
                    except Exception:
                        pass
    found.sort(key=lambda r: r[1], reverse=True)
    return [name for name, _exp in found]


def _detect_google_profiles() -> list[str]:
    """Chrome profiles signed in to a Google account, freshest cookie first.

    CAVEAT worth knowing before you trust this: a Google sign-in is far less
    discriminating than a chatgpt.com one. On a normal machine most profiles are
    signed in to *some* Google account, and the cookie says nothing about which
    account or whether it carries a Gemini subscription — a probe run hit a
    profile whose "Google AI Pro subscription has expired" page has no composer
    at all. So this is a candidate list, not an answer: pin the right profile
    with --profile / IMAGE_USE_GEMINI_PROFILE.
    """
    return _detect_logged_in_profiles(
        "%google.com",
        "name IN ('__Secure-1PSID', '__Secure-3PSID', 'SID')")


def _relay_connected(ab: str) -> bool:
    """True if chrome-use's ab-connect relay is attached to a live Chrome.

    Reads `chrome-use daemon status --json` → data.relay — instant, no browser
    launch. The relay is the only way chrome-use can drive an ALREADY-open
    Chrome (a normally-launched Chrome has no debug port); knowing whether it's
    connected lets us tell a user with a logged-in-but-unreachable browser the
    right fix (connect the relay) instead of the misleading "not logged in".

    Best-effort: any error → False, so guidance degrades to generic remedies."""
    try:
        out = subprocess.run([ab, "daemon", "status", "--json"],
                             capture_output=True, text=True, timeout=10)
        data = json.loads(out.stdout or "{}")
        return bool(isinstance(data, dict)
                    and isinstance(data.get("data"), dict)
                    and data["data"].get("relay"))
    except Exception:  # noqa: BLE001 — diagnostics only, never fatal
        return False


def _auto_candidates(profiles: list[str], relay: bool) -> list[str | None]:
    """Order auto-mode browser candidates by where a usable browser most likely is.

    ``None`` is the relay (your already-open Chrome), which only drives a usable
    session when the ab-connect extension is connected. When it isn't, the relay
    candidate just launches a throwaway, signed-OUT temp profile that's bound to
    fail (and wastes a launch) — so when relay is down, try the offline-detected
    logged-in ``profiles`` FIRST and keep relay last (it still covers a Chrome
    manually exposed on a CDP port). Relay up → keep it first (best for
    anti-detection). Pure; no I/O."""
    return [None, *profiles] if relay else [*profiles, None]


def _web_unavailable_message(
    detected_profiles: list[str], reasons: list[str], relay: bool,
) -> str:
    """Build the WebUnavailable error after every browser candidate failed.

    Pure (no I/O) so it's unit-testable. ``reasons`` is the per-candidate
    failure list (each already prefixed with its label); ``detected_profiles``
    are the offline-detected logged-in Chrome profiles; ``relay`` is whether the
    ab-connect relay is attached.

    The point is to surface chrome-use's ACTUAL error (which the candidate loop
    used to swallow) plus a remedy tailored to the real situation, rather than a
    flat "no logged-in browser" that misreads a logged-in-but-unreachable Chrome
    as signed-out (issue #15)."""
    lines = ["no logged-in ChatGPT browser available."]
    if reasons:
        lines.append("tried:")
        lines += [f"  • {r}" for r in reasons]
    if detected_profiles and not relay:
        # A login WAS found on disk, but we couldn't drive it and the relay
        # isn't connected — so chrome-use can't reach the already-open Chrome.
        prof = detected_profiles[0]
        lines.append(
            f"a ChatGPT login was detected in Chrome profile {prof!r}, but it "
            "couldn't be driven. Fix any one:")
        lines.append(
            "  1. connect the relay (best — drives your already-open tab, no "
            "Codex-usage): run `chrome-use extension install`, load the "
            "ab-connect extension (chrome://extensions → Developer mode → Load "
            "unpacked), restart Chrome, then rerun.")
        lines.append(
            "  2. fully quit Chrome, then rerun — chrome-use can then launch the "
            f"logged-in profile {prof!r} itself.")
        lines.append("  3. use --backend codex (headless; bills Codex-usage).")
    elif relay:
        # The relay is up but the relayed Chrome still didn't yield a composer —
        # most likely that Chrome isn't signed in to chatgpt.com.
        lines.append(
            "the relay is connected but the open Chrome isn't usable — sign in "
            "to chatgpt.com in it, or use --backend codex.")
    else:
        lines.append(
            "no logged-in Chrome profile was detected and the relay isn't "
            "connected. Sign in to chatgpt.com (and/or set up the chrome-use "
            "relay), or use --backend codex.")
    return "\n".join(lines)


def _ab(ab: str, *ab_args: str, session: str, timeout: float, profile: str | None = None,
        input_text: str | None = None) -> str:
    """Run one chrome-use subcommand, return stdout. Raises GatewayError on failure.

    ``profile`` (a Chrome profile name/path) is passed as chrome-use's global
    ``--profile`` flag, which must precede the subcommand. Only the launching
    ``open`` call needs it; later calls reuse the session's browser.
    Large or multiline text can be passed via stdin without shell/argv limits.
    """
    cmd = [ab]
    if profile:
        cmd += ["--profile", profile]
    cmd += [*ab_args, "--session", session]
    try:
        proc = subprocess.run(
            cmd, capture_output=True, text=True, timeout=max(5.0, timeout),
            **({"input": input_text} if input_text is not None else {})
        )
    except subprocess.TimeoutExpired:
        raise GatewayError(f"chrome-use timed out: {' '.join(ab_args[:2])}") from None
    except FileNotFoundError:
        raise GatewayError("chrome-use binary vanished mid-run") from None
    if proc.returncode != 0:
        tail = (proc.stderr or proc.stdout or "").strip().splitlines()[-3:]
        raise GatewayError(
            f"chrome-use {ab_args[0] if ab_args else ''} failed "
            f"(exit {proc.returncode}): {' / '.join(tail)[:300]}"
        )
    return proc.stdout


def _ab_eval(ab: str, js: str, session: str, timeout: float) -> Any:
    """Run JS in the page and decode the value it returns.

    Convention: the JS always `return JSON.stringify(value)`. chrome-use
    prints that string JSON-encoded, so we decode twice — once to recover the
    JSON text the page returned, once to parse it into a Python object.
    """
    out = _ab(ab, "eval", js, session=session, timeout=timeout)
    # Scan from the last non-empty line for the first that decodes to a string.
    for line in reversed([l for l in out.splitlines() if l.strip()]):
        try:
            inner = json.loads(line)
        except Exception:
            continue
        if isinstance(inner, str):
            try:
                return json.loads(inner)
            except Exception:
                return inner
        return inner
    raise GatewayError(f"could not parse chrome-use eval output: {out[:200]!r}")


# JS: snapshot the generation state — whether a stop/streaming control is still
# present, and the newest image asset src that was NOT already on the page when
# we started (baseline list passed in). Returned as a JSON string.
# Both the baseline and the freshness scan are scoped to `main img` — this
# tab's conversation thread — never document-wide. ChatGPT pushes an "Image
# created" toast (with a thumbnail whose src matches the asset regex) into ANY
# open chatgpt.com tab when some OTHER conversation finishes an image; the
# toast lives in a portal outside <main>, so a document-wide scan grabs that
# sibling's image (the cross-contaminated/duplicate outputs of issue #7) while
# a main-scoped scan can't. NOTE the generated <img> is NOT inside the
# [data-message-author-role="assistant"] element (verified in the live DOM:
# main#main > #thread > section[data-testid=conversation-turn-N] > … > img),
# so don't be tempted to scope tighter than <main>.
_JS_STATE = r"""(() => {
  const seen = new Set(%s);
  const stop = !!document.querySelector(
    'button[data-testid="stop-button"], button[aria-label*="Stop" i]'
  );
  const re = new RegExp(%s);
  // The generated image renders in <main> but OUTSIDE any message bubble (it's
  // an image-generation card, not an assistant text turn — so we can't scope to
  // the assistant role). An img2img reference, however, is echoed INSIDE the
  // user bubble with a fresh estuary/content src not in the pre-submit baseline.
  // So detect fresh main images but exclude any that belong to a user message.
  const userSrcs = new Set();
  document.querySelectorAll('[data-message-author-role="user"] img')
    .forEach(i => { const s = i.currentSrc || i.src; if (s) userSrcs.add(s); });
  const fresh = [...document.querySelectorAll('main img')]
    .map(i => i.currentSrc || i.src)
    .filter(s => re.test(s) && !seen.has(s) && !userSrcs.has(s));
  const a = document.querySelectorAll('[data-message-author-role="assistant"]');
  const lastA = a[a.length - 1];
  const dlg = [...document.querySelectorAll('[role="dialog"]')]
    .map(d => d.textContent || '').join(' ');
  return JSON.stringify({stop, last: fresh[fresh.length - 1] || null,
                         assistant: a.length > 0,
                         limited: /too many requests|requests too quickly/i.test(dlg),
                         atext: lastA ? lastA.textContent.trim().slice(0, 240) : ""});
})()"""

_JS_BASELINE = r"""(() => {
  const re = new RegExp(%s);
  const srcs = [...document.querySelectorAll('main img')]
    .map(i => i.currentSrc || i.src).filter(s => re.test(s));
  return JSON.stringify(srcs);
})()"""

# JS: fetch the asset bytes from inside the authenticated page and hand them
# back base64-encoded along with the content type. credentials:'include' reuses
# the browser's session cookies, so the signed/asset URL resolves.
_JS_FETCH = r"""(async () => {
  try {
    const r = await fetch(%s, {credentials: 'include'});
    if (!r.ok) return JSON.stringify({ok: false, status: r.status});
    const buf = new Uint8Array(await (await r.blob()).arrayBuffer());
    let bin = '';
    const CH = 0x8000;
    for (let i = 0; i < buf.length; i += CH)
      bin += String.fromCharCode.apply(null, buf.subarray(i, i + CH));
    return JSON.stringify({ok: true, type: r.headers.get('content-type'),
                           bytes: buf.length, b64: btoa(bin)});
  } catch (e) { return JSON.stringify({ok: false, error: String(e)}); }
})()"""

# JS: resolve a ChatGPT Project (a "snorlax" gizmo, id g-p-…) by exact display
# name, creating it if absent. Runs inside the authenticated page so the
# session cookies + accessToken are free. Endpoints (probed live, undocumented):
#   GET  /backend-api/gizmos/snorlax/sidebar   → list projects
#   POST /backend-api/projects {name, instructions} → create one
_JS_ENSURE_PROJECT = r"""(async () => {
  try {
    const name = %s;
    const sess = await fetch('/api/auth/session', {credentials: 'include'})
      .then(r => r.json()).catch(() => null);
    if (!sess || !sess.accessToken)
      return JSON.stringify({ok: false, error: 'no accessToken in /api/auth/session'});
    const h = {Authorization: 'Bearer ' + sess.accessToken,
               'Content-Type': 'application/json'};
    const find = async () => {
      const r = await fetch(
        '/backend-api/gizmos/snorlax/sidebar?conversations_per_gizmo=0',
        {credentials: 'include', headers: h});
      if (!r.ok) throw new Error('project list HTTP ' + r.status);
      for (const it of (await r.json()).items || []) {
        const g = it.gizmo && it.gizmo.gizmo;
        if (g && g.display && g.display.name === name) return g.id;
      }
      return null;
    };
    let id = await find();
    if (id) return JSON.stringify({ok: true, id, created: false});
    const mk = await fetch('/backend-api/projects', {
      method: 'POST', credentials: 'include', headers: h,
      body: JSON.stringify({name: name, instructions: ''})});
    if (!mk.ok) return JSON.stringify({ok: false, error: 'project create HTTP ' + mk.status});
    const j = await mk.json().catch(() => null);
    id = j && ((j.gizmo && (j.gizmo.id || (j.gizmo.gizmo && j.gizmo.gizmo.id))) || j.id);
    if (!id) id = await find();  // response shape unknown-proof: re-list by name
    if (!id) return JSON.stringify({ok: false, error: 'created but could not resolve id'});
    return JSON.stringify({ok: true, id, created: true});
  } catch (e) { return JSON.stringify({ok: false, error: String(e)}); }
})()"""


# JS: is the composer up — and is chatgpt.com showing its rate-limit dialog?
# ("Too many requests — You're making requests too quickly. We've temporarily
# limited access to your conversations…"). The dialog means every further page
# action is pointless for a few minutes, so surface it instead of timing out.
_JS_COMPOSER = r"""(() => {
  const dlg = [...document.querySelectorAll('[role="dialog"]')]
    .map(d => d.textContent || '').join(' ');
  return JSON.stringify({
    composer: !!document.querySelector('#prompt-textarea'),
    limited: /too many requests|requests too quickly/i.test(dlg),
  });
})()"""

_RATE_LIMIT_MSG = (
    "chatgpt.com rate-limited this account ('Too many requests') — the page "
    "surface needs a few minutes of quiet before it will serve again."
)


def _wait_composer(ab: str, session: str, remaining, tries: int = 15) -> bool:
    """Poll until the chat composer (#prompt-textarea) is on the page.

    Raises WebRateLimited if the page shows the "Too many requests" dialog —
    waiting out the poll budget (and then other profile candidates) would just
    burn ~45s each on an account-level block."""
    for _ in range(tries):
        try:
            st = _ab_eval(ab, _JS_COMPOSER, session=session,
                          timeout=min(20.0, remaining()))
            if isinstance(st, dict):
                if st.get("limited"):
                    raise WebRateLimited(_RATE_LIMIT_MSG)
                if st.get("composer"):
                    return True
        except WebRateLimited:
            raise
        except GatewayError:
            pass
        time.sleep(1.0)
    return False


def _enter_project(ab: str, session: str, name: str, remaining, emit) -> None:
    """Navigate the open session into the named ChatGPT Project, creating the
    project on first use — so each run's conversation files under the project
    instead of littering the top-level chat history.

    Best-effort: organization is a nicety, the generation is the point. On any
    failure this warns and restores a plain new chat, never aborts the run.
    """
    navigated = False
    try:
        res = _ab_eval(ab, _JS_ENSURE_PROJECT % json.dumps(name),
                       session=session, timeout=min(30.0, remaining()))
        if not isinstance(res, dict) or not res.get("ok") or not res.get("id"):
            detail = res.get("error") if isinstance(res, dict) else res
            raise GatewayError(f"could not resolve project: {detail}")
        emit(f"using project {name!r}" + (" (created)" if res.get("created") else ""))
        navigated = True
        _ab(ab, "open", WEB_PROJECT_URL.format(gizmo_id=res["id"]),
            session=session, timeout=min(30.0, remaining()))
        if not _wait_composer(ab, session, remaining):
            raise GatewayError("project page composer never appeared")
    except WebRateLimited:
        raise  # account-level block; a plain chat would be just as dead
    except GatewayError as e:
        emit(f"warning: project {name!r} unavailable ({e}); using a plain chat")
        if navigated:
            # We may have left the plain-chat page; restore it so the normal
            # submit flow still has a composer to type into.
            try:
                _ab(ab, "open", WEB_NEW_CHAT_URL, session=session,
                    timeout=min(30.0, remaining()))
                _wait_composer(ab, session, remaining)
            except GatewayError:
                pass


# JS: delete (hide) the conversation currently open in the tab. ChatGPT's own
# "delete" is a PATCH with `is_visible:false` — it drops the chat from history,
# search, and the sidebar. Conversation id comes from the `/c/<id>` URL segment
# (works for both plain `/c/…` and project `/g/g-p-…/c/…` URLs). accessToken is
# read from the in-page session, same as _JS_ENSURE_PROJECT.
_JS_DELETE_CONV = r"""(async () => {
  try {
    const m = location.pathname.match(/\/c\/([0-9a-f-]{16,})/i);
    if (!m) return JSON.stringify({ok: false, error: 'no conversation id in URL'});
    const id = m[1];
    const sess = await fetch('/api/auth/session', {credentials: 'include'})
      .then(r => r.json()).catch(() => null);
    if (!sess || !sess.accessToken)
      return JSON.stringify({ok: false, error: 'no accessToken in /api/auth/session'});
    const r = await fetch('/backend-api/conversation/' + id, {
      method: 'PATCH', credentials: 'include',
      headers: {Authorization: 'Bearer ' + sess.accessToken,
                'Content-Type': 'application/json'},
      body: JSON.stringify({is_visible: false})});
    if (!r.ok) return JSON.stringify({ok: false, error: 'delete HTTP ' + r.status});
    return JSON.stringify({ok: true, id});
  } catch (e) { return JSON.stringify({ok: false, error: String(e)}); }
})()"""


def _delete_conversation(ab, session, remaining, emit) -> None:
    """Delete the conversation just used so the run leaves no history.

    Best-effort: the image is already saved by the time we get here, so a delete
    failure only warns — it never fails the run or loses the image.
    """
    try:
        res = _ab_eval(ab, _JS_DELETE_CONV, session=session,
                       timeout=min(20.0, remaining()))
    except GatewayError as e:
        emit(f"warning: could not delete conversation ({e}); it stays in history")
        return
    if isinstance(res, dict) and res.get("ok"):
        emit("conversation deleted (no history kept)")
    else:
        detail = res.get("error") if isinstance(res, dict) else res
        emit(f"warning: could not delete conversation ({detail}); it stays in history")


# JS: locate the composer model-picker button and return its label + viewport
# center {text, x, y}, or null. The picker has no stable selector, so match the
# one menu-opening button whose short label names a model/effort.
_JS_MODEL_BTN = r"""(() => {
  const b = [...document.querySelectorAll('button')].find(b =>
    b.getAttribute('aria-haspopup') === 'menu' &&
    (b.innerText || '').trim().length > 0 &&
    (b.innerText || '').trim().length < 25 &&
    /\b(Auto|Pro|Instant|Medium|High|Thinking|Fast|GPT)\b/.test(b.innerText || ''));
  if (!b) return JSON.stringify(null);
  const r = b.getBoundingClientRect();
  return JSON.stringify({text: b.innerText.replace(/\s+/g, ' ').trim(),
                         x: Math.round(r.x + r.width / 2),
                         y: Math.round(r.y + r.height / 2)});
})()"""

# JS: find an open-menu radio/item by exact label, return its center {x, y}.
_JS_MENU_ITEM = r"""(() => {
  const name = %s;
  const m = [...document.querySelectorAll('[role="menuitemradio"],[role="menuitem"]')]
    .find(e => (e.innerText || '').replace(/\s+/g, ' ').trim() === name);
  if (!m) return JSON.stringify(null);
  const r = m.getBoundingClientRect();
  return JSON.stringify({x: Math.round(r.x + r.width / 2),
                         y: Math.round(r.y + r.height / 2)});
})()"""


def _ensure_web_model(ab, session, model_label, remaining, emit) -> None:
    """Switch the composer to the first available of ``model_label`` (a
    comma-separated candidate list, e.g. "Instant,Auto").

    Needed because "Pro" has no native image generator (see WEB_MODEL_DEFAULT).
    Different plans label the image-capable tier differently (Plus/Pro expose
    Instant/Medium/…; other plans an "Auto"), so we try a list and take the first
    that exists in the picker — more robust than one hardcoded label. The menu
    renders in a React portal that ignores synthetic ``.click()`` and re-renders
    away injected ids, so we drive it by real coordinate clicks read fresh from
    getBoundingClientRect each step.

    Best-effort: on any failure this warns and proceeds with the current model,
    exactly like _enter_project — selection is a nicety, not worth aborting over.
    """
    candidates = [c.strip() for c in (model_label or "").split(",") if c.strip()]
    if not candidates:
        return
    wants = [c.lower() for c in candidates]
    try:
        btn = _ab_eval(ab, _JS_MODEL_BTN, session=session,
                       timeout=min(15.0, remaining()))
        if not isinstance(btn, dict):
            emit("warning: model picker not found; leaving model as-is")
            return
        cur_text = btn.get("text", "").strip().lower()
        if any(cur_text.startswith(w) for w in wants):
            return  # already on an acceptable model (picker is sticky)
        emit(f"switching model {btn.get('text')!r} → first of {candidates}")
        _ab(ab, "click", str(btn["x"]), str(btn["y"]),
            session=session, timeout=min(15.0, remaining()))
        time.sleep(0.6)
        chosen = None
        item = None
        for cand in candidates:  # first candidate present in the open menu wins
            it = _ab_eval(ab, _JS_MENU_ITEM % json.dumps(cand),
                          session=session, timeout=min(15.0, remaining()))
            if isinstance(it, dict):
                chosen, item = cand, it
                break
        if item is None:
            emit(f"warning: none of {candidates} in the picker; leaving as-is")
            try:  # close the menu so it can't swallow the prompt
                _ab(ab, "press", "Escape", session=session,
                    timeout=min(10.0, remaining()))
            except GatewayError:
                pass
            return
        _ab(ab, "click", str(item["x"]), str(item["y"]),
            session=session, timeout=min(15.0, remaining()))
        time.sleep(0.4)
        now = _ab_eval(ab, _JS_MODEL_BTN, session=session,
                       timeout=min(15.0, remaining()))
        cur = now.get("text") if isinstance(now, dict) else None
        if isinstance(cur, str) and cur.strip().lower().startswith(chosen.lower()):
            emit(f"model set to {chosen!r}")
        else:
            emit(f"warning: model may not have switched (now {cur!r})")
    except WebRateLimited:
        raise
    except GatewayError as e:
        emit(f"warning: could not switch model ({e}); using the current one")


def _env_bool(name: str) -> bool:
    """True if env var ``name`` is set to a truthy value (1/true/yes/on)."""
    return (_env(name) or "").strip().lower() in ("1", "true", "yes", "on")


def _backend_limit(kind: str, default: int) -> int:
    """Concurrency cap for a backend, via IMAGE_USE_<KIND>_CONCURRENCY.

    0 or a negative value means unlimited. Unset / unparsable → the default.
    """
    raw = _env(f"IMAGE_USE_{kind.upper()}_CONCURRENCY", "").strip()
    try:
        return int(raw) if raw else default
    except ValueError:
        return default


# Per-backend defaults. They differ because the backends hit different limits:
#   web   — drives the ONE shared logged-in Chrome AND the chatgpt.com page
#           surface, which rate-limits aggressively ("Too many requests …
#           temporarily limited access to your conversations"). Keep it at 1.
#   codex — independent HTTP POSTs; measured fine at 4 concurrent on a Plus
#           account (no 429s, no serialization). Cap it anyway so an agent
#           fanning out a big batch can't trip the per-account limiter.
WEB_CONCURRENCY_DEFAULT = 1
CODEX_CONCURRENCY_DEFAULT = 4

# The codex/responses image path needs a *driver* model that reads the prompt and
# calls the `image_generation` tool — the picture itself is rendered by the
# server's own image model (observed: `gpt-image-2-codex`), and the tool config
# we send is rewritten server-side. So a frontier "coding" model is pure waste
# here: it bills the metered Codex bucket and buys no better image. Default to a
# Codex-account model advertised as "fast and affordable"; override with
# `--model` / IMAGE_USE_MODEL. The account has its own model allowlist
# (GET /backend-api/codex/models), so an unsupported model falls back cleanly.
CODEX_MODEL_DEFAULT = "gpt-5.6-luna"
CODEX_MODEL_FALLBACK = "gpt-5.5"


# Whether this platform gives us a cross-process file lock at all. Both
# primitives are kernel-owned, so a slot is released when its holder dies —
# that is the property the queue below relies on.
_HAVE_FILE_LOCK = fcntl is not None or msvcrt is not None


def _try_lock(f) -> bool:
    """Take an exclusive non-blocking lock on ``f``; False if someone holds it.

    ``fcntl.flock`` locks the whole file; ``msvcrt.locking`` locks a byte range
    from the current offset, so we pin both to byte 0 and lock one byte. Only
    called when :data:`_HAVE_FILE_LOCK` — a False here always means contention,
    never a missing primitive.
    """
    try:
        if fcntl is not None:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        else:
            f.seek(0)
            msvcrt.locking(f.fileno(), msvcrt.LK_NBLCK, 1)
        return True
    except OSError:
        return False


def _unlock(f) -> None:
    """Release a lock taken by :func:`_try_lock`. Best-effort: closing the file
    (and exiting the process) drops it anyway."""
    try:
        if fcntl is not None:
            fcntl.flock(f, fcntl.LOCK_UN)
        else:
            f.seek(0)
            msvcrt.locking(f.fileno(), msvcrt.LK_UNLCK, 1)
    except OSError:
        pass


@contextmanager
def _concurrency_slot(kind: str, limit: int, progress: bool, start: float) -> "Iterator[None]":
    """Cross-process counting semaphore: at most ``limit`` concurrent runs.

    Implemented as ``limit`` flock slot files in the temp dir — a run holds
    exactly one slot for its whole generation. Excess runs queue (0.5s poll)
    instead of failing or corrupting each other (issue #7: parallel web runs
    cross-contaminated images; the page surface also rate-limits hard). The
    kernel releases a slot when its holder dies, so a crash can't wedge the
    queue. ``limit <= 0`` disables the gate entirely, as does a platform with
    no file-locking primitive at all (see :data:`_HAVE_FILE_LOCK`).
    """
    if limit <= 0 or not _HAVE_FILE_LOCK:
        yield
        return
    base = tempfile.gettempdir()
    slot = None
    announced = False
    try:
        while slot is None:
            for i in range(limit):
                # "a+" not "w": truncating a slot file another process has
                # byte-range-locked is a sharing violation on Windows. The
                # pre-rename file name is kept so image-use and a not-yet-
                # updated chatgpt-imagegen still share one slot pool.
                f = open(os.path.join(base, f"chatgpt-imagegen-{kind}-{i}.lock"), "a+")
                if _try_lock(f):
                    slot = f
                    break
                f.close()
            else:
                if progress and not announced:
                    announced = True
                    print(
                        f"[{time.monotonic() - start:6.1f}s] waiting for a free "
                        f"{kind} slot (max {limit} concurrent {kind} generation"
                        f"{'s' if limit != 1 else ''})",
                        file=sys.stderr,
                    )
                time.sleep(0.5)
        yield
    finally:
        if slot is not None:
            _unlock(slot)
            slot.close()


# ---------------------------------------------------------------------------
# Cross-TOOL serialization for the chatgpt.com page surface
#
# The gate above only serializes *this* program against itself. It does not see
# other tools driving the same account: chatgpt-use (leeguooooo/chatgpt-use)
# held its own lock at ~/.chatgpt-use/channel.lock, so the two projects could
# drive chatgpt.com simultaneously with neither noticing. That produces exactly
# the damage each project had already fixed internally — two processes typing
# into one composer concatenate their prompts (chatgpt-use proved this live:
# "42 non-whitespace chars present, 21 expected"), and a second tab makes the
# "Image created" toast leak a sibling conversation's image into this run
# (issue #7).
#
# So the lock has to be owned by the SURFACE, not by either project. Both
# projects now take this one path, agreed with chatgpt-use:
#   * ~/.chatgpt-web.lock — neither tool's namespace, so neither owns it.
#   * held for a WHOLE generation, never per HTTP call. A half-held lock is
#     worse than none because it still looks safe.
#   * advisory flock (std::fs::File::lock on their side, fcntl/msvcrt here), so
#     the kernel releases it if a holder dies and the two languages interop.
#   * an unopenable lock file warns and proceeds rather than refusing to work —
#     losing serialization is bad, but refusing to generate is worse.
CHATGPT_WEB_LOCK = ".chatgpt-web.lock"

# The one chrome-use session name both projects drive, so there is exactly one
# chatgpt.com tab on the machine instead of one per tool per pid. Stable on
# purpose: a pid-suffixed name defeats reuse and is how a dozen tabs get opened
# in an afternoon.
CHATGPT_WEB_SESSION = "chatgpt-web"

# Whether this process actually holds CHATGPT_WEB_LOCK. False means the lock
# was unavailable as a primitive (no flock on this platform, or the file could
# not be opened) — NOT that it is merely uncontended. Read by the session-name
# choice below: without real serialization, sharing one tab is unsafe.
_chatgpt_web_lock_held = False


def _chatgpt_web_lock_path() -> Path:
    """Where the shared lock lives. Overridable for tests via
    IMAGE_USE_WEB_LOCK (an absolute path); otherwise ~/.chatgpt-web.lock.
    """
    override = _env("IMAGE_USE_WEB_LOCK", "").strip()
    if override:
        return Path(override)
    return Path.home() / CHATGPT_WEB_LOCK


@contextmanager
def _chatgpt_web_turn(progress: bool, start: float) -> "Iterator[None]":
    """Hold the cross-tool chatgpt.com lock for one whole generation.

    Blocks (0.5s poll) while another process — this tool or chatgpt-use — is
    mid-turn, announcing the wait once on stderr so a stall is explainable
    rather than looking like a hang.
    """
    global _chatgpt_web_lock_held
    if not _HAVE_FILE_LOCK:
        # No locking primitive at all. Say so once: the user is running two
        # tools against one account with no gate, and should know.
        print("warning: no file-locking primitive on this platform — cannot "
              "serialize against other chatgpt.com tools (chatgpt-use). Run "
              "one at a time.", file=sys.stderr)
        yield
        return
    path = _chatgpt_web_lock_path()
    try:
        # O_RDWR|O_CREAT, deliberately NOT "a+" and NOT "w":
        #   * no O_TRUNC — truncating a file another process has byte-range
        #     locked is a sharing violation on Windows;
        #   * no O_APPEND — append mode forces every write to end-of-file and
        #     silently ignores seek(0), which would append our holder name after
        #     a previous holder's line instead of replacing it, so readers would
        #     report a stale holder.
        f = os.fdopen(os.open(path, os.O_RDWR | os.O_CREAT, 0o644), "r+")
    except OSError as e:
        print(f"warning: cannot open {path} ({e}) — proceeding without "
              f"cross-tool chatgpt.com serialization.", file=sys.stderr)
        yield
        return
    announced = False
    try:
        while not _try_lock(f):
            if progress and not announced:
                announced = True
                # Name the holder. A 90s image generation behind another tool's
                # turn is the difference between "queued" and "hung" for whoever
                # is watching stderr.
                print(
                    _fmt_progress(
                        time.monotonic() - start,
                        f"waiting for {_chatgpt_web_holder(f)} to finish its "
                        f"chatgpt turn (chatgpt.com allows one at a time)",
                    ),
                    file=sys.stderr,
                )
            time.sleep(0.5)
        # Record who holds it, for the other side's waiter line. Best-effort:
        # failing to write our name is not a reason to abandon a lock we hold.
        # Deliberately NOT truncated first — truncating a file whose byte range
        # is locked is a sharing violation on Windows (same trap as the slot
        # files above). Our line ends in \n, so any longer remnant from a
        # previous holder lands on line 2, which the reader ignores.
        try:
            f.seek(0)
            f.write(f"image-use {os.getpid()}\n")
            f.flush()
        except OSError:
            pass
        _chatgpt_web_lock_held = True
        yield
    finally:
        _chatgpt_web_lock_held = False
        _unlock(f)
        f.close()


def _chatgpt_web_holder(f) -> str:
    """Describe whoever currently holds the lock, for a waiter message.

    The file contains `<tool> <pid>`, written by whichever side took it. Agreed
    with chatgpt-use that an empty or unparsable file means "unknown holder" and
    is NOT an error — the warn-and-proceed paths leave the file empty on purpose,
    and an old holder may predate this convention.
    """
    try:
        f.seek(0)
        line = f.read(200).strip().splitlines()[0].strip()
    except (OSError, IndexError):
        return "another chatgpt tool"
    if not line:
        return "another chatgpt tool"
    parts = line.split()
    # Accept a bare tool name too; only the first field is load-bearing.
    tool = parts[0]
    if len(parts) > 1 and parts[1].isdigit():
        return f"{tool} (pid {parts[1]})"
    return tool


def run_web(
    args: argparse.Namespace, progress: bool, start: float,
    refs: list[str] | None = None,
) -> tuple[bytes, JsonDict]:
    """Generate an image by driving the user's logged-in ChatGPT browser.

    When ``refs`` (reference image paths/URLs) are supplied, runs image-to-image:
    each reference is attached to the composer via `chrome-use upload` before the
    edit prompt is submitted — no Codex-usage, same surface as text-to-image.

    Returns (image_bytes, meta). Raises GatewayError / exits on failure.
    """
    ab = _find_agent_browser()
    if ab is None:
        raise WebUnavailable(f"`chrome-use` is not installed — {_AB_INSTALL_HINT}")
    # Default to the STABLE, CROSS-TOOL session name so the whole machine shares
    # one chatgpt.com tab — this process, a second copy of it, and chatgpt-use
    # all drive `chatgpt-web`. That reuses one chrome-use daemon instead of
    # leaking a fresh one per run (chrome-use has no clean daemon-reap command
    # yet — see leeguooooo/chrome-use#48), and it is what keeps the account from
    # being rate-limited by a pile of tabs.
    #
    # Sharing a tab is only safe while turns are actually serialized, and the
    # cross-tool lock (_chatgpt_web_turn) is what guarantees that — so the stable
    # name applies whenever the lock is genuinely held, even if the user lifted
    # the per-process concurrency cap.
    #
    # The two degraded cases are split deliberately, and neither is free:
    #   * cap lifted AND no real lock → parallel runs really can overlap, so
    #     fall back to a per-pid session and accept an extra tab as the lesser
    #     evil against cross-contamination (issue #7).
    #   * cap at 1 but no real lock (no flock primitive, or an unopenable lock
    #     file) → KNOWINGLY keep the shared name. Nothing we do to the session
    #     name would restore serialization here, and one tab is the explicit
    #     requirement; _chatgpt_web_turn has already warned on stderr that the
    #     user must run one tool at a time.
    if args.session:
        session = args.session
    elif _chatgpt_web_lock_held or _backend_limit("web", WEB_CONCURRENCY_DEFAULT) == 1:
        session = CHATGPT_WEB_SESSION
    else:
        session = f"imagegen-{os.getpid()}"
    # Budget the generation from NOW, not from process start: web runs may have
    # blocked on the serialize lock (issue #7) before reaching here, and that
    # queue wait must not eat into the --timeout image budget.
    deadline = time.monotonic() + args.timeout
    _n_char, _n_style, _n_comp = _ref_counts(args, refs)
    user_text = _build_web_text(
        args.gen_prompt, args.size,
        n_character_refs=_n_char, n_style_refs=_n_style,
        n_composition_refs=_n_comp)

    def emit(msg: str) -> None:
        if progress:
            print(_fmt_progress(time.monotonic() - start, msg), file=sys.stderr)

    def remaining() -> float:
        return max(2.0, deadline - time.monotonic())

    _warn_if_chrome_use_old(ab, emit)

    # Decide which browser(s) to try, in order.
    #   relay/off  → only the currently-open Chrome (extension relay).
    #   auto       → relay FIRST (your open Chrome usually works and is best for
    #                anti-detection), then any offline-detected profile that's
    #                logged in to chatgpt.com — so we only switch profiles when
    #                the open browser isn't logged in.
    #   <name>     → only that profile.
    # `None` in the list means "relay" (no --profile flag).
    pl = (args.profile or "auto").strip().lower()
    # Probe the relay once up front: it decides candidate ORDER (below) and the
    # remedy in the final error (so we don't re-shell `daemon status`).
    relay = _relay_connected(ab)
    if pl in ("relay", "off", "current"):
        candidates: list[str | None] = [None]
    elif pl == "auto":
        candidates = _auto_candidates(_detect_logged_in_profiles(), relay)
    else:
        candidates = [args.profile.strip()]
    if pl == "auto":
        emit(f"relay {'connected' if relay else 'not connected'}")

    def _try_open(prof: str | None) -> str | None:
        """Open a fresh chat and wait for the composer.

        Returns None on success, or a short reason string on failure — the
        chrome-use error verbatim, or "composer never appeared". We surface that
        reason instead of swallowing it (the old bool dropped chrome-use's
        actual diagnostic, e.g. "extension not connected …", leaving the user
        only our generic message — issue #15). WebRateLimited still propagates."""
        try:
            _ab(ab, "open", WEB_NEW_CHAT_URL, session=session,
                timeout=min(30.0, remaining()), profile=prof)
        except GatewayError as e:
            return str(e)
        if _wait_composer(ab, session, remaining):
            return None
        return ("composer never appeared (likely a login wall — that Chrome "
                "isn't signed in to chatgpt.com — or the page was blocked)")

    def _close() -> None:
        """Close the session's browser/tab. Best-effort; never raises."""
        try:
            _ab(ab, "close", session=session, timeout=15.0)
        except Exception:
            pass  # leftover tab is harmless; never fail the run over cleanup

    chosen: str | None = None
    opened = False
    reasons: list[str] = []  # per-candidate failure, surfaced if all fail
    for prof in candidates:
        label = "current Chrome (relay)" if prof is None else f"profile {prof!r}"
        emit(f"opening ChatGPT via {label}")
        try:
            reason = _try_open(prof)
        except WebRateLimited:
            _close()  # account-level block: stop burning 45s per candidate
            raise
        if reason is None:
            chosen, opened = prof, True
            emit(f"using {label}")
            break
        emit(f"{label} unavailable: {reason}")
        reasons.append(f"{label} — {reason}")
        _close()  # always tear down a failed attempt, including the last
    if not opened:
        detected = [c for c in candidates if c is not None]
        raise WebUnavailable(_web_unavailable_message(detected, reasons, relay))

    # Everything past here drives the now-open browser. Wrap it so the tab is
    # ALWAYS closed on the way out — success, failure (quota/refusal/timeout), or
    # exception — instead of leaking a window on every non-happy path.
    try:
        project = (args.project or "").strip()
        if project:
            _enter_project(ab, session, project, remaining, emit)
        _ensure_web_model(
            ab, session,
            getattr(args, "web_model", WEB_MODEL_DEFAULT) or WEB_MODEL_DEFAULT,
            remaining, emit)
        result = _generate_in_browser(
            ab, session, user_text, args, deadline, remaining, emit, refs=refs)
        # Image is saved by now. Delete the conversation so no history is left —
        # the default. `--keep-conversation` opts out; `--keep-tab` (debugging)
        # implies keeping it, since an open tab on a deleted chat is useless.
        if not getattr(args, "keep_conversation", False) and not args.keep_tab:
            _delete_conversation(ab, session, remaining, emit)
        return result
    finally:
        if not args.keep_tab:
            _close()


def _resolve_ref_path(ref: str) -> tuple[str, str | None]:
    """Return (local_path, cleanup_path|None) for a local path or http(s) URL.

    Web img2img hands a real file to `chrome-use upload`, so — unlike the codex
    helper `_load_reference` — we keep the file on disk rather than base64ing it.
    URLs download to a temp file the caller deletes via the returned cleanup
    path. Exits cleanly on a missing file / unsupported type / download failure.
    """
    if _is_url(ref):
        raw = _download_ref_url(ref)
        mime = _sniff_mime(raw)
        if mime is None:
            sys.exit(f"unsupported reference image type for {ref!r} (need PNG, JPEG, or WEBP)")
        ext = {"image/png": ".png", "image/jpeg": ".jpg",
               "image/webp": ".webp"}.get(mime, ".img")
        fd, tmp = tempfile.mkstemp(suffix=ext)
        os.close(fd)
        Path(tmp).write_bytes(raw)
        return tmp, tmp
    p = Path(ref).expanduser()
    if not p.is_file():
        sys.exit(f"reference image not found: {ref}")
    with p.open("rb") as fh:
        if _sniff_mime(fh.read(16)) is None:
            sys.exit(f"unsupported reference image type for {ref!r} (need PNG, JPEG, or WEBP)")
    return str(p), None


# Read the editor's logical text, not innerText (which adds visual paragraph
# spacing) or textContent (which loses paragraph breaks). A ProseMirror trailing
# BR is an empty-paragraph placeholder, not an extra newline.
_JS_WEB_COMPOSER_STATE = r"""(() => {
  const composer = document.querySelector('#prompt-textarea');
  const form = composer && composer.closest('form');
  const read = n => {
    if (n.nodeType === 3) return n.textContent;
    if (n.nodeName === 'BR')
      return n.classList.contains('ProseMirror-trailingBreak') ? '' : '\n';
    return [...n.childNodes].map(read).join('');
  };
  let text = null;
  if (composer) {
    const nodes = [...composer.childNodes];
    text = 'value' in composer ? composer.value :
      nodes.some(n => /^(P|DIV)$/.test(n.nodeName))
        ? nodes.map(read).join('\n') : read(composer);
  }
  const images = form ? [...form.querySelectorAll('img')]
    .filter(i => /blob:|estuary\/content|oaiusercontent/.test(i.src || '')) : [];
  const send = form && form.querySelector('button[data-testid="send-button"]');
  return JSON.stringify({
    exists: !!composer, text,
    attachments: images.length,
    // Blob thumbnails appear before the upload finishes. Only server-backed
    // images count as ready; don't send with a partially uploaded batch.
    ready: images.filter(i => !i.src.startsWith('blob:')).length,
    busy: !!(form && form.querySelector('[role="progressbar"], [aria-busy="true"]')),
    send_ready: !!send && !send.disabled && send.getAttribute('aria-disabled') !== 'true',
    user_turns: document.querySelectorAll('[data-message-author-role="user"]').length,
  });
})()"""


def _web_composer_state(ab, session, remaining) -> dict:
    """Read logical editor text and upload/send state, requiring a live composer."""
    state = _ab_eval(ab, _JS_WEB_COMPOSER_STATE, session=session,
                     timeout=min(15.0, remaining()))
    if not isinstance(state, dict) or not state.get("exists"):
        raise GatewayError("ChatGPT composer is unavailable; submission cannot be verified")
    return state


def _wait_web_uploads(ab, session, expected, remaining, emit) -> None:
    """Wait for every expected server upload, rejecting incomplete or excess files."""
    deadline = time.monotonic() + min(90.0, remaining())
    state = {}
    last_counts = None
    for _ in range(90):
        state = _web_composer_state(ab, session, remaining)
        counts = (state.get("ready", 0), state.get("attachments", 0))
        if counts[1] > expected:
            raise GatewayError(f"ChatGPT has {counts[1]} attachments, expected {expected}; "
                               "prompt not submitted (possible duplicate upload)")
        if counts == (expected, expected) and not state.get("busy"):
            emit(f"all {expected} reference image(s) uploaded")
            return
        if counts != last_counts:
            emit(f"waiting for reference uploads: {counts[0]}/{expected} ready")
            last_counts = counts
        if time.monotonic() >= deadline:
            break
        time.sleep(1.0)
    raise GatewayError(
        f"reference upload incomplete: {state.get('ready', 0)}/{expected} ready "
        f"({state.get('attachments', 0)} thumbnails); prompt not submitted. "
        "Check the ChatGPT upload controls or retry in a fresh chat.")


# Composer file inputs to hand `chrome-use upload`, in order. ChatGPT reshuffled
# these (issue #19, seen 2026-07): the composer's REAL input is `#upload-files`,
# and the elements matching the old `input[accept="image/*"]` selector are now
# `sr-only` 1x1 decoys sitting OUTSIDE the composer form — files handed to those
# are silently dropped, which is exactly the "file input is still empty after
# upload" failure. `#upload-files` renders 0x0, but `upload` resolves and drives
# hidden inputs fine, so no page-side injection is needed. The later entries keep
# older / A-B-tested layouts working.
_UPLOAD_SELECTORS = ("#upload-files", "form input[type=file]",
                     'input[accept="image/*"]')


def _upload_references(ab, session, ref_paths, remaining, emit) -> None:
    """Attach reference image files to the composer via `chrome-use upload`.

    Fall back only when a selector is definitely missing. After a possibly
    dispatched upload, observe completion instead of uploading the batch again.
    Every requested image must finish uploading before the prompt can be sent.
    """
    if not ref_paths:
        return
    initial = _web_composer_state(ab, session, remaining)
    if initial.get("text"):
        raise GatewayError("ChatGPT composer is not empty; references not uploaded. "
                           + _DRAFT_HINT)
    if initial.get("attachments"):
        raise GatewayError("ChatGPT composer already has attachments; use a fresh chat "
                           "to avoid mixing or duplicating references")
    emit(f"attaching {len(ref_paths)} reference image(s)")
    for sel in _UPLOAD_SELECTORS:
        try:
            _ab(ab, "upload", sel, *ref_paths,
                session=session, timeout=min(90.0, remaining()))
        except GatewayError as e:
            state = _web_composer_state(ab, session, remaining)
            missing = any(marker in str(e).lower() for marker in
                          ("not found", "no element matches", "matched 0"))
            if not state.get("attachments") and missing:
                if sel == _UPLOAD_SELECTORS[-1]:
                    raise
                continue
            if not state.get("attachments"):
                raise GatewayError(f"reference upload outcome is uncertain; prompt not "
                                   f"submitted and upload not repeated: {e}") from e
        _wait_web_uploads(ab, session, len(ref_paths), remaining, emit)
        return


# ChatGPT restores an unsent composer draft in every new chat, so a draft left
# behind by a failed run blocks the next one at the empty-composer check.
_DRAFT_HINT = ("Clear the ChatGPT composer at https://chatgpt.com/ (a leftover draft "
               "is restored in new chats) or start a fresh chat, then retry.")


def _clear_web_composer(ab, session, remaining) -> None:
    """Best-effort: empty the composer so our own text is not left as a draft."""
    try:
        _ab(ab, "fill", "#prompt-textarea", "--stdin", input_text="",
            session=session, timeout=min(20.0, remaining()))
    except GatewayError:
        pass


def _canonicalize_composer_text(text: str) -> str:
    """Normalize editor-equivalent whitespace before composer verification."""
    return text.replace("\r\n", "\n").replace("\r", "\n").replace("\u00a0", " ")


def _submit_web_prompt(ab, session, user_text, n_refs, remaining, emit) -> None:
    """Paste, verify exact editor text and attachments, then click Send once.

    `keyboard type` dispatches Enter for newlines and can submit several partial
    messages. `fill --stdin` inserts paragraphs without any submit key events.
    Never replay an uncertain send: a retry could consume quota twice.
    """
    initial = _web_composer_state(ab, session, remaining)
    if initial.get("text"):
        raise GatewayError("ChatGPT composer is not empty; prompt not submitted. " + _DRAFT_HINT)
    emit("pasting prompt")
    _ab(ab, "fill", "#prompt-textarea", "--stdin", input_text=user_text,
        session=session, timeout=min(60.0, remaining()))
    # Everything below until the click is a "nothing was sent" failure. ChatGPT
    # keeps composer drafts across chats, so leaving our text in the box would
    # make every LATER run stop at the empty-composer check above until the user
    # clears it by hand — undo the paste before propagating.
    try:
        ready_deadline = time.monotonic() + min(30.0, remaining())
        for _ in range(30):
            state = _web_composer_state(ab, session, remaining)
            if state.get("user_turns") != initial.get("user_turns"):
                raise GatewayError("ChatGPT submitted while entering the prompt; "
                                   "stopped without sending again. Check the conversation.")
            if _canonicalize_composer_text(state.get("text") or "") != _canonicalize_composer_text(user_text):
                raise GatewayError(
                    f"ChatGPT composer text differs from the supplied prompt "
                    f"(expected {len(user_text)} characters, got "
                    f"{len(state.get('text') or '')}); prompt not submitted.")
            if state.get("attachments") != n_refs or state.get("ready") != n_refs:
                raise GatewayError("ChatGPT attachments changed before sending; "
                                   "prompt not submitted. Check the reference uploads.")
            if state.get("send_ready") and not state.get("busy"):
                break
            if time.monotonic() >= ready_deadline:
                raise GatewayError("ChatGPT Send button did not become ready; prompt not submitted")
            time.sleep(1.0)
        else:
            raise GatewayError("ChatGPT Send button did not become ready; prompt not submitted")
    except GatewayError:
        _clear_web_composer(ab, session, remaining)
        raise
    emit(f"verified prompt ({len(user_text)} characters) and {n_refs} reference image(s)")
    send_error = None
    try:
        _ab(ab, "click", 'button[data-testid="send-button"]',
            session=session, timeout=min(20.0, remaining()))
    except GatewayError as error:
        send_error = error
    sent_deadline = time.monotonic() + min(30.0, remaining())
    for _ in range(30):
        try:
            state = _web_composer_state(ab, session, remaining)
        except GatewayError:
            state = {}
        new_turns = state.get("user_turns", 0) - initial.get("user_turns", 0)
        if new_turns > 1:
            raise GatewayError("multiple ChatGPT user messages appeared after Send; "
                               "stopped without sending again. Check the conversation.")
        if state.get("text") == "" and new_turns == 1:
            emit("prompt submitted once")
            return
        if time.monotonic() >= sent_deadline:
            break
        time.sleep(1.0)
    detail = f" ({send_error})" if send_error else ""
    raise GatewayError("could not confirm ChatGPT received the prompt; Send was not "
                       f"repeated to avoid duplicate requests{detail}. Check the conversation.")


def _generate_in_browser(ab, session, user_text, args, deadline, remaining, emit,
                         refs=None):
    """Upload references, submit verified text once, and download the new image."""
    # Image-to-image: attach the reference(s) to the composer FIRST, then delete
    # any temp downloads — the browser has uploaded the bytes to ChatGPT by the
    # time the thumbnail renders, so the local copy is no longer needed.
    if refs:
        ref_paths: list[str] = []
        cleanups: list[str] = []
        try:
            for r in refs:
                path, cleanup = _resolve_ref_path(r)
                ref_paths.append(path)
                if cleanup:
                    cleanups.append(cleanup)
            _upload_references(ab, session, ref_paths, remaining, emit)
        finally:
            for c in cleanups:
                try:
                    os.unlink(c)
                except OSError:
                    pass

    # Capture the baseline set of image srcs already on the page so we never
    # mistake a prior image — INCLUDING a just-uploaded reference, whose src is
    # also an estuary/content URL — for the new one.
    baseline = _ab_eval(ab, _JS_BASELINE % json.dumps(WEB_IMG_SRC_RE),
                        session=session, timeout=min(20.0, remaining()))
    if not isinstance(baseline, list):
        baseline = []

    _submit_web_prompt(ab, session, user_text, len(refs or []), remaining, emit)

    # Poll until the stream stops AND a brand-new image asset is present and
    # stable across two reads (guards against grabbing a mid-render partial).
    state_js = _JS_STATE % (json.dumps(baseline), json.dumps(WEB_IMG_SRC_RE))
    last_phase = ""
    final_src: str | None = None
    stable_src: str | None = None
    # Idle = an assistant turn exists, nothing is streaming, and still no image.
    # After ~16s of that we conclude the reply finished without an image (refusal,
    # text-only, or an empty turn) instead of hanging until the total timeout.
    idle_polls = 0
    IDLE_LIMIT = 8
    last_atext = ""
    while time.monotonic() < deadline:
        time.sleep(2.0)
        try:
            st = _ab_eval(ab, state_js, session=session, timeout=min(20.0, remaining()))
        except GatewayError:
            continue
        if not isinstance(st, dict):
            continue
        if st.get("limited"):
            # Post-submit rate limit: a plain GatewayError on purpose — the
            # prompt already went in, so auto mode must NOT double-spend by
            # silently retrying on codex.
            raise GatewayError(
                _RATE_LIMIT_MSG + " The prompt was already submitted; check "
                "the conversation later or retry in a few minutes."
            )
        if st.get("stop"):
            if last_phase != "generating":
                last_phase = "generating"
                emit("generating")
            stable_src = None
            idle_polls = 0
            continue
        cur = st.get("last")
        if cur:
            if last_phase not in ("receiving image", "done"):
                last_phase = "receiving image"
                emit("receiving image")
            idle_polls = 0
            # Require the same fresh src twice in a row before trusting it.
            if cur == stable_src:
                final_src = cur
                break
            stable_src = cur
        elif st.get("assistant"):
            # Assistant turn present, not streaming, no new image yet.
            if isinstance(st.get("atext"), str) and st["atext"]:
                last_atext = st["atext"]
            idle_polls += 1
            if idle_polls >= IDLE_LIMIT:
                reason = f' ChatGPT said: "{last_atext}"' if last_atext else ""
                raise GatewayError(
                    "ChatGPT finished without producing an image (text reply, "
                    "refusal, or image quota reached)." + reason +
                    " Try rephrasing, a different --profile, or --backend codex."
                )

    if not final_src:
        raise GatewayError(
            f"timed out after {args.timeout}s waiting for the image "
            f"(last phase: {last_phase or 'connecting'})."
        )

    emit("downloading image bytes")
    res = _ab_eval(ab, _JS_FETCH % json.dumps(final_src),
                  session=session, timeout=min(60.0, remaining()))
    if not isinstance(res, dict) or not res.get("ok"):
        detail = res.get("status") or res.get("error") if isinstance(res, dict) else res
        raise GatewayError(f"failed to download the generated image: {detail}")
    try:
        image_bytes = base64.b64decode(res["b64"], validate=True)
    except Exception:
        raise GatewayError("generated image came back as invalid base64") from None

    meta: JsonDict = {"content_type": res.get("type"), "source": "web"}
    # Cleanup (closing the tab) is handled by run_web's finally, so it runs on
    # every exit path — not just this success one.
    return image_bytes, meta


# ---------- gemini backend (drive the logged-in Gemini browser) ----------

_JS_GEMINI_COMPOSER = r"""(() => {
  const sels = %s;
  let found = null;
  for (const s of sels) {
    try { if (document.querySelector(s)) { found = s; break; } } catch (e) {}
  }
  const t = document.body ? (document.body.innerText || '') : '';
  return JSON.stringify({
    composer: found,
    // No composer AND a sign-in prompt = a login wall, not a slow app boot.
    signin: !found && /sign in|登录|ログイン/i.test(t),
    // Seen live: an expired Google AI subscription renders this and no composer.
    expired: /订阅已到期|subscription (has )?expired/i.test(t),
    limited: /reached your limit|try again later|请稍后再试/i.test(t),
  });
})()"""

_JS_GEMINI_BASELINE = r"""(() => {
  const re = new RegExp(%s);
  return JSON.stringify([...document.querySelectorAll('img')]
    .map(i => i.currentSrc || i.src).filter(s => s && re.test(s)));
})()"""

_JS_GEMINI_STATE = r"""(() => {
  const seen = new Set(%s);
  const re = new RegExp(%s);
  const stop = !!document.querySelector(
    'button[aria-label*="Stop" i], button[aria-label*="停止"]');
  // Exclude images echoed inside the user's own turn: an img2img reference is
  // itself a fresh blob: img and would otherwise be mistaken for the result.
  const userSrcs = new Set();
  document.querySelectorAll('user-query img, [class*="user-query"] img')
    .forEach(i => { const s = i.currentSrc || i.src; if (s) userSrcs.add(s); });
  const fresh = [...document.querySelectorAll('img')]
    .map(i => i.currentSrc || i.src)
    .filter(s => s && re.test(s) && !seen.has(s) && !userSrcs.has(s));
  const resp = document.querySelectorAll('model-response');
  const last = resp[resp.length - 1];
  const t = document.body ? (document.body.innerText || '') : '';
  return JSON.stringify({
    stop, last: fresh[fresh.length - 1] || null,
    answered: resp.length > 0,
    limited: /reached your limit|try again later|请稍后再试/i.test(t),
    atext: last ? (last.innerText || '').trim().slice(0, 240) : '',
  });
})()"""

# Read the bytes out of the rendered <img> through a canvas.
#
# This is deliberately NOT the _JS_FETCH approach the ChatGPT path uses, because
# neither of the obvious routes works here: Gemini renders results from a
# `blob:` src, which in-page fetch() rejects from chrome-use's eval context
# ("TypeError: Failed to fetch") and which `chrome-use download-url` refuses
# outright ("expected http:// or https://"). The <img> is same-origin, so the
# canvas is untainted and toDataURL is permitted.
#
# COST, and it is a real one: this re-encodes to PNG, which strips the image's
# metadata — including the C2PA provenance manifest Google signs its generated
# images with. The imperceptible SynthID watermark lives in the pixels and
# survives; the signed manifest does not. `--verbose` says so on every run.
_JS_GEMINI_CANVAS = r"""(() => {
  try {
    const want = %s;
    const img = [...document.querySelectorAll('img')]
      .find(i => (i.currentSrc || i.src) === want);
    if (!img) return JSON.stringify({ok: false, error: 'img element is gone'});
    if (!img.complete || !img.naturalWidth)
      return JSON.stringify({ok: false, error: 'img not decoded yet'});
    const c = document.createElement('canvas');
    c.width = img.naturalWidth; c.height = img.naturalHeight;
    c.getContext('2d').drawImage(img, 0, 0);
    return JSON.stringify({ok: true, type: 'image/png', w: c.width, h: c.height,
                           b64: c.toDataURL('image/png').split(',')[1]});
  } catch (e) { return JSON.stringify({ok: false, error: String(e)}); }
})()"""

_JS_GEMINI_UPLOADED = r"""(() => {
  const t = document.body ? (document.body.innerText || '') : '';
  return JSON.stringify(/图片已上传|image uploaded|已上传/i.test(t)
    || [...document.querySelectorAll('img')]
         .some(i => (i.currentSrc || i.src || '').startsWith('blob:')));
})()"""


def _find_agy() -> str | None:
    for name in AGY_BIN_CANDIDATES:
        p = shutil.which(name)
        if p:
            return p
    return None


def _build_reference_framing(n_character_refs: int, n_style_refs: int,
                             n_composition_refs: int = 0) -> str:
    """One sentence describing what the attached references ARE.

    Shared by the gemini and agy backends, and deliberately mirrors
    `_build_web_text`'s distinction: character refs are the subject and must be
    reproduced, style refs only set the aesthetic and must NOT have their
    content copied. Collapsing the two is not a cosmetic error — a first agy run
    that called every reference "the subject" answered a prompt about a glass
    bottle with a four-panel comic strip of the style reference's cartoon dog.
    """
    tail = _composition_clause(n_composition_refs, bool(n_character_refs or n_style_refs))
    if n_character_refs and n_style_refs:
        which = "next" if n_composition_refs else "remaining"
        return (f"The first {n_character_refs} reference image(s) show a "
                f"recurring character — reproduce them faithfully as the "
                f"subject. The {which} {n_style_refs} are style references: "
                f"match their aesthetic, do NOT copy their content." + tail)
    if n_character_refs:
        return ("Keep the reference image(s) as the canonical subject — "
                "reproduce their shapes, colours, and texture faithfully." + tail)
    if n_style_refs:
        return ("Match the visual style of the reference image(s); "
                "do NOT copy their content or subject matter." + tail)
    return tail.strip()


def _build_gemini_text(prompt: str, size: str,
                       n_character_refs: int = 0, n_style_refs: int = 0,
                       n_composition_refs: int = 0) -> str:
    """Prompt text for the Gemini composer.

    Gemini's chat surface has no size control, so the aspect ratio has to be
    asked for in words — and it *is* honoured. Measured: asking for square
    returned 1024x1024, asking for portrait 2:3 returned 687x1024 (2:3 to within
    a pixel). What is NOT controllable is the absolute pixel count.

    Which is why the ratio sentence is emitted even when the caller left --size
    at "auto": with nothing requested Gemini defaults to 16:9 (five probe runs,
    all 1024x559), so staying silent is itself a choice — and a surprising one
    for a caller who asked for no particular shape. The real dimensions are
    recorded in the run meta either way.
    """
    ratio = {"1024x1024": "square 1:1", "1024x1536": "portrait 2:3",
             "1536x1024": "landscape 3:2"}.get(size)
    if ratio is None and (not size or size == "auto"):
        ratio = "square 1:1"
    bits = ["Generate an image."
            if not (n_character_refs or n_style_refs or n_composition_refs)
            else "Using the attached reference image(s), generate a new image."]
    framing = _build_reference_framing(n_character_refs, n_style_refs,
                                       n_composition_refs)
    if framing:
        bits.append(framing)
    bits.append(f"Scene: {prompt}.")
    if ratio:
        bits.append(f"Compose it as a {ratio} image.")
    return " ".join(bits)


def _gemini_wait_composer(ab: str, session: str, remaining, tries: int = 20) -> str:
    """Poll until Gemini's composer exists; return the selector that matched."""
    js = _JS_GEMINI_COMPOSER % json.dumps(list(GEMINI_COMPOSER_SELECTORS))
    for _ in range(tries):
        try:
            st = _ab_eval(ab, js, session=session, timeout=min(20.0, remaining()))
        except GatewayError:
            st = None
        if isinstance(st, dict):
            if st.get("expired"):
                raise WebUnavailable(
                    "this Google account's Gemini subscription has expired — "
                    "pin a subscribed profile with --profile / "
                    "IMAGE_USE_GEMINI_PROFILE")
            if st.get("limited"):
                raise WebRateLimited(
                    "gemini.google.com rate-limited this account — it needs a "
                    "few minutes of quiet before it will serve again.")
            if st.get("signin"):
                raise WebUnavailable(
                    "that Chrome isn't signed in to gemini.google.com")
            if st.get("composer"):
                return st["composer"]
        time.sleep(1.5)
    raise WebUnavailable("Gemini's composer never appeared (login wall, or the "
                         "page was blocked)")


def _gemini_enable_image_tool(ab, session, remaining, emit) -> bool:
    """Switch the composer to Gemini's dedicated image tool before generating.

    Without it a prompt is answered by the chat model currently selected (the
    picker showed "Flash-Lite" on a live run); with it, the composer reports
    "generated using Nano Banana 2" — Google's image model. Same idea as the
    ChatGPT backend forcing Instant over Pro.

    Best-effort by design: it returns False and the caller proceeds anyway,
    because the plain chat path demonstrably produces images too (8 verified
    runs). A menu reshuffle should cost image *quality*, never the whole run.

    Note what this does NOT fix — both were checked directly against it: results
    still carry the visible bottom-right watermark, and the default aspect ratio
    is still 16:9. The ratio is steered by the prompt (see _build_gemini_text).
    """
    opened = False
    for sel in GEMINI_UPLOAD_MENU_SELECTORS:
        try:
            _ab(ab, "click", sel, session=session, timeout=min(20.0, remaining()))
            opened = True
            break
        except GatewayError:
            continue
    if not opened:
        emit("note: could not open Gemini's tool menu; using the chat default")
        return False
    time.sleep(1.5)
    # Match on the item's own text: the labels are localised and the Angular
    # class names are not contractual, so text is the most durable handle.
    js = r"""(() => {
      const want = %s;
      const b = [...document.querySelectorAll('button, [role=menuitem]')]
        .find(e => want.includes((e.innerText || '').trim()));
      if (!b) return JSON.stringify(false);
      b.click();
      return JSON.stringify(true);
    })()""" % json.dumps(list(GEMINI_IMAGE_TOOL_LABELS))
    try:
        if _ab_eval(ab, js, session=session, timeout=min(20.0, remaining())):
            time.sleep(1.5)
            emit("image tool enabled")
            return True
    except GatewayError:
        pass
    emit("note: image tool not found in the menu; using the chat default")
    return False


def _gemini_upload_references(ab, session, ref_paths, remaining, emit) -> None:
    """Attach reference images to Gemini's composer.

    Unlike ChatGPT, Gemini mounts NO file input until the upload menu is opened,
    so the menu click is a required step rather than a nicety — without it the
    upload fails with "element not found".
    """
    emit(f"attaching {len(ref_paths)} reference image(s)")
    opened = False
    for sel in GEMINI_UPLOAD_MENU_SELECTORS:
        try:
            _ab(ab, "click", sel, session=session, timeout=min(20.0, remaining()))
            opened = True
            break
        except GatewayError:
            continue
    if not opened:
        raise GatewayError("could not open Gemini's upload menu — img2img needs "
                           "it to mount the file input")
    time.sleep(1.5)

    err: GatewayError | None = None
    for sel in GEMINI_UPLOAD_SELECTORS:
        try:
            _ab(ab, "upload", sel, *ref_paths,
                session=session, timeout=min(90.0, remaining()))
            err = None
            break
        except GatewayError as e:
            err = e
    if err is not None:
        raise err

    for _ in range(15):
        try:
            if _ab_eval(ab, _JS_GEMINI_UPLOADED, session=session,
                        timeout=min(10.0, remaining())):
                emit("reference attached")
                time.sleep(2.0)  # let it finalise server-side before we send
                return
        except GatewayError:
            pass
        time.sleep(1.0)
    emit("warning: reference attachment not confirmed; submitting anyway")


def _gemini_submit(ab, session, composer, text, remaining, emit) -> None:
    """Type into the composer and send.

    `keyboard type` rather than `fill`: the composer is a Quill contenteditable
    and a DOM-only mutation leaves the send button bound to empty state. Enter
    submits reliably (verified over 8 runs); the localised send button is only a
    fallback, since aria-label="Send" does not exist on a non-English UI.
    """
    _ab(ab, "click", composer, session=session, timeout=min(20.0, remaining()))
    _ab(ab, "keyboard", "type", text, session=session, timeout=min(60.0, remaining()))
    empty_js = ("(() => { const e = document.querySelector(%s);"
                " return JSON.stringify(!e || (e.innerText||'').trim().length===0); })()"
                % json.dumps(composer))

    def _cleared() -> bool:
        try:
            return bool(_ab_eval(ab, empty_js, session=session,
                                 timeout=min(15.0, remaining())))
        except GatewayError:
            return False

    for _ in range(6):
        _ab(ab, "press", "Enter", session=session, timeout=min(20.0, remaining()))
        time.sleep(1.2)
        if _cleared():
            emit("submitted")
            return
        for sel in ('button[aria-label*="Send" i]', 'button[aria-label*="发送"]',
                    "button.send-button"):
            try:
                _ab(ab, "click", sel, session=session, timeout=min(15.0, remaining()))
                break
            except GatewayError:
                continue
        time.sleep(1.5)
        if _cleared():
            emit("submitted")
            return
    emit("warning: composer did not clear — the prompt may not have sent")


def _gemini_poll(ab, session, baseline, deadline, remaining, emit) -> str:
    """Poll until a brand-new image src is present and stable across two reads."""
    js = _JS_GEMINI_STATE % (json.dumps(baseline), json.dumps(GEMINI_IMG_SRC_RE))
    stable = None
    idle = 0
    phase = ""
    atext = ""
    while time.monotonic() < deadline:
        time.sleep(2.0)
        try:
            st = _ab_eval(ab, js, session=session, timeout=min(20.0, remaining()))
        except GatewayError:
            continue
        if not isinstance(st, dict):
            continue
        if st.get("limited"):
            # Post-submit: a plain GatewayError on purpose, so nothing silently
            # retries elsewhere after the prompt has already been spent.
            raise GatewayError("gemini.google.com rate-limited this account "
                               "mid-generation; the prompt was already submitted")
        if st.get("stop"):
            if phase != "generating":
                phase = "generating"
                emit("generating")
            stable, idle = None, 0
            continue
        cur = st.get("last")
        if cur:
            if phase != "receiving":
                phase = "receiving"
                emit("receiving image")
            idle = 0
            if cur == stable:
                return cur
            stable = cur
        elif st.get("answered"):
            if st.get("atext"):
                atext = st["atext"]
            idle += 1
            if idle >= 10:   # ~20s answered-but-no-image → text reply or refusal
                said = f' Gemini said: "{atext}"' if atext else ""
                raise GatewayError(
                    "Gemini finished without producing an image (text reply, "
                    "refusal, or image quota reached)." + said)
    raise GatewayError(f"timed out waiting for the image "
                       f"(last phase: {phase or 'connecting'})")


def _gemini_blob_download(ab, session, src, remaining) -> tuple[bytes, JsonDict] | None:
    """Pull a blob: src byte-exact via `chrome-use download-url`, or None.

    This is the route that preserves Google's signed C2PA provenance manifest
    (issue #27). chrome-use used to reject blob: URLs outright
    (leeguooooo/chrome-use#169), which left only the canvas re-encode below —
    and a canvas holds pixels, not files, so every metadata block died with it.
    Upstream now resolves the blob inside the page and streams the original
    bytes out, so the manifest survives.

    Returns None (never raises) on any failure — an old chrome-use, a dead
    blob, a >32MB payload. The caller falls back to the canvas, which always
    worked; losing provenance beats losing the image.
    """
    if not src.startswith("blob:"):
        return None
    tmpdir = tempfile.mkdtemp(prefix="imagegen-gemini-")
    dest = Path(tmpdir) / "out.bin"
    try:
        _ab(ab, "download-url", src, str(dest),
            session=session, timeout=min(60.0, remaining()))
        data = dest.read_bytes()
    except (GatewayError, OSError):
        return None
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)
    ctype = _sniff_mime(data[:16])
    if not data or not ctype:
        return None  # not an image — treat as a miss, let the canvas try
    return data, {"content_type": ctype, "source": "gemini",
                  "transport": "blob-download", "provenance": "preserved"}


def _gemini_fetch(ab, session, src, remaining, emit) -> tuple[bytes, JsonDict]:
    emit("downloading image bytes")
    got = _gemini_blob_download(ab, session, src, remaining)
    if got is not None:
        emit(f"read {len(got[0])} bytes byte-exact off the blob "
             f"(C2PA provenance intact)")
        return got
    last = None
    for _ in range(5):
        try:
            res = _ab_eval(ab, _JS_GEMINI_CANVAS % json.dumps(src),
                           session=session, timeout=min(60.0, remaining()))
        except GatewayError as e:
            res = {"ok": False, "error": str(e)}
        if isinstance(res, dict) and res.get("ok"):
            try:
                data = base64.b64decode(res["b64"], validate=True)
            except Exception:
                raise GatewayError(
                    "generated image came back as invalid base64") from None
            return data, {"content_type": "image/png", "source": "gemini",
                          "width": res.get("w"), "height": res.get("h"),
                          "transport": "canvas", "provenance": "stripped"}
        last = res
        time.sleep(2.0)  # nearly always just "img not decoded yet"
    raise GatewayError(f"failed to read the generated image off the page: {last}")


def run_gemini(
    args: argparse.Namespace, progress: bool, start: float,
    refs: list[str] | None = None,
) -> tuple[bytes, JsonDict]:
    """Generate an image by driving the user's logged-in Gemini browser.

    Same shape as `run_web` — open, wait for the composer, submit, poll, read the
    bytes, close — but every step differs enough from ChatGPT's DOM that sharing
    the code would be worse than repeating its structure.

    Two behaviours to know before choosing this backend:
      • Text-to-image results carry a VISIBLE Gemini "sparkle" watermark, fixed
        at 65px in from the bottom-right corner. Image-to-image results do not.
      • Size is a hint, not a setting — see `_build_gemini_text`.
    """
    ab = _find_agent_browser()
    if ab is None:
        raise WebUnavailable(f"`chrome-use` is not installed — {_AB_INSTALL_HINT}")
    session = args.session or "imagegen-gemini"
    deadline = time.monotonic() + args.timeout

    def emit(msg: str) -> None:
        if progress:
            print(_fmt_progress(time.monotonic() - start, msg), file=sys.stderr)

    def remaining() -> float:
        return max(2.0, deadline - time.monotonic())

    _warn_if_chrome_use_old(ab, emit)

    pl = (getattr(args, "gemini_profile", None) or args.profile or "auto").strip()
    if pl.lower() in ("relay", "off", "current"):
        candidates: list[str | None] = [None]
    elif pl.lower() == "auto":
        # Ordering only; a Google cookie is a weak signal (see
        # _detect_google_profiles), so auto is a convenience, not a guarantee.
        candidates = _auto_candidates(_detect_google_profiles(),
                                      _relay_connected(ab))
    else:
        candidates = [pl]

    def _close() -> None:
        try:
            _ab(ab, "close", session=session, timeout=15.0)
        except Exception:
            pass

    chosen_composer = None
    reasons: list[str] = []
    for prof in candidates:
        label = "current Chrome (relay)" if prof is None else f"profile {prof!r}"
        emit(f"opening Gemini via {label}")
        try:
            _ab(ab, "open", GEMINI_URL, session=session,
                timeout=min(45.0, remaining()), profile=prof)
            chosen_composer = _gemini_wait_composer(ab, session, remaining)
            emit(f"using {label}")
            break
        except WebRateLimited:
            _close()
            raise
        except GatewayError as e:
            emit(f"{label} unavailable: {e}")
            reasons.append(f"{label} — {e}")
            _close()
    if chosen_composer is None:
        raise WebUnavailable(
            "no Chrome profile could reach a usable Gemini:\n  • "
            + "\n  • ".join(reasons or ["no candidate profiles"])
            + "\nPin the subscribed one with --profile / "
              "IMAGE_USE_GEMINI_PROFILE.")

    try:
        if getattr(args, "gemini_image_tool", True):
            _gemini_enable_image_tool(ab, session, remaining, emit)
        cleanups: list[str] = []
        if refs:
            paths = []
            for r in refs:
                p, tmp = _resolve_ref_path(r)
                paths.append(p)
                if tmp:
                    cleanups.append(tmp)
            try:
                _gemini_upload_references(ab, session, paths, remaining, emit)
            finally:
                for c in cleanups:
                    try:
                        os.remove(c)
                    except Exception:
                        pass
        # Baseline AFTER any upload: the reference thumbnail is itself a fresh
        # blob: <img>, so a baseline taken before it would let the poll return
        # the user's own reference as the "generated" image.
        baseline = _ab_eval(ab, _JS_GEMINI_BASELINE % json.dumps(GEMINI_IMG_SRC_RE),
                            session=session, timeout=min(20.0, remaining()))
        if not isinstance(baseline, list):
            baseline = []

        n_char, n_style, n_comp = _ref_counts(args, refs)
        text = _build_gemini_text(args.gen_prompt, args.size,
                                  n_character_refs=n_char, n_style_refs=n_style,
                                  n_composition_refs=n_comp)
        _gemini_submit(ab, session, chosen_composer, text, remaining, emit)
        src = _gemini_poll(ab, session, baseline, deadline, remaining, emit)
        data, meta = _gemini_fetch(ab, session, src, remaining, emit)
        if meta.get("provenance") == "stripped":
            emit("note: the blob could not be downloaded byte-exact, so the "
                 "PNG was re-encoded off a canvas — that drops Google's C2PA "
                 "provenance manifest (the imperceptible SynthID watermark in "
                 "the pixels is unaffected). Upgrading chrome-use usually "
                 "restores the byte-exact path")
        if not refs:
            emit("note: text-to-image results carry a visible Gemini watermark "
                 "at the bottom-right")
        return data, meta
    finally:
        if not args.keep_tab:
            _close()


# ---------- agy backend (Antigravity CLI, headless) ----------

# The CLI is an agent, not an image endpoint: it decides on its own where to put
# the file, and a sandboxed run redirects cwd (observed: it wrote to
# ~/.gemini/antigravity-cli/scratch/ despite being told "the current directory").
# So instead of guessing the path, we make it TELL us — the last line of stdout.
# Verified stable across three runs.
_AGY_PROMPT = (
    "{intent}\n\n"
    "Requirements:\n"
    "- Use a real image-generation model. Do NOT draw the image with code "
    "(no PIL/matplotlib/SVG/canvas).\n"
    "- Save the result to this exact path: {out}\n"
    "- Print that absolute path, alone, as the very last line of your reply.\n"
    "- Do not ask questions; if something is ambiguous, choose and proceed."
)


def _agy_extract_path(stdout: str) -> str | None:
    """Pull the saved-file path out of agy's reply (last path-looking line)."""
    for line in reversed([l.strip() for l in stdout.splitlines() if l.strip()]):
        # Strip a markdown link wrapper — agy sometimes answers with
        # `[teapot.png](file:///abs/path)` rather than a bare path. Excluding
        # `)` from the path is what keeps the link's closing paren out of it.
        m = re.search(r"file://([^\s)>\]\"']+)", line)
        if m:
            cand = urllib.parse.unquote(m.group(1))
            # file:///C:/path is the canonical Windows form; some tools emit
            # file://C:\\path instead. Path accepts either after dropping the
            # URI-only leading slash from a drive-letter path.
            if re.match(r"^/[A-Za-z]:[\\/]", cand):
                cand = cand[1:]
            if Path(cand).is_file():
                return cand
        cand = line.strip("`'\" ")
        if Path(cand).is_absolute() and Path(cand).is_file():
            return cand
    return None


def _run_agy_watched(
    cmd: list[str], cwd: str, total_timeout: float, stall_timeout: float,
) -> tuple[int, str, str]:
    """Run `cmd`, killing it after `stall_timeout` seconds of total silence.

    `subprocess.run(timeout=...)` only enforces the *total* budget, so a
    wedged agy stayed alive for the full --timeout no matter what
    --stall-timeout said (issue #24). Draining both pipes on reader threads and
    stamping the time of every chunk gives agy the same idle contract the codex
    and web backends already honour. The wait for the *first* chunk gets
    `_AGY_STARTUP_GRACE` of slack so agy's own boot isn't read as a stall.
    Returns (returncode, stdout, stderr).
    """
    proc = subprocess.Popen(cmd, cwd=cwd, text=True,
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    chunks: dict[str, list[str]] = {"out": [], "err": []}
    last = [time.monotonic()]
    started = [False]

    def drain(stream, key: str) -> None:
        for line in iter(stream.readline, ""):
            last[0] = time.monotonic()
            started[0] = True
            chunks[key].append(line)
        stream.close()

    threads = [
        threading.Thread(target=drain, args=(proc.stdout, "out"), daemon=True),
        threading.Thread(target=drain, args=(proc.stderr, "err"), daemon=True),
    ]
    for t in threads:
        t.start()

    deadline = time.monotonic() + total_timeout
    stalled = False
    while proc.poll() is None:
        now = time.monotonic()
        if now >= deadline:
            break
        idle_budget = (stall_timeout if started[0]
                       else max(stall_timeout, _AGY_STARTUP_GRACE))
        if stall_timeout > 0 and now - last[0] >= idle_budget:
            stalled = True
            break
        time.sleep(0.2)

    if proc.poll() is None:
        idle = time.monotonic() - last[0]
        proc.kill()
        proc.wait()
        for t in threads:
            t.join(timeout=1.0)
        if stalled:
            raise GatewayError(
                f"agy stalled: no output for ~{round(idle)}s "
                f"(raise --stall-timeout, or drop it to 0 to wait out the "
                f"full --timeout)")
        raise subprocess.TimeoutExpired(cmd, total_timeout)
    for t in threads:
        t.join(timeout=2.0)
    return proc.returncode, "".join(chunks["out"]), "".join(chunks["err"])


def run_agy(
    args: argparse.Namespace, progress: bool, start: float,
    refs: list[str] | None = None, stall_timeout: float = 0.0,
) -> tuple[bytes, JsonDict]:
    """Generate an image through the Antigravity CLI (`agy`), headless.

    Compared with the browser path this is slower (~20-25s vs ~11s) but produces
    squarer, unwatermarked-looking output — "looking" because the image is in
    fact marked, just not visibly: its metadata carries a Google-signed C2PA
    manifest whose own description reads "Applied imperceptible SynthID
    watermark". Unlike the gemini browser backend, that manifest survives here,
    because the bytes are copied rather than re-encoded.
    """
    agy = _find_agy()
    if agy is None:
        raise WebUnavailable(
            "`agy` (Antigravity CLI) is not installed or not on PATH")

    def emit(msg: str) -> None:
        if progress:
            print(_fmt_progress(time.monotonic() - start, msg), file=sys.stderr)

    tmpdir = tempfile.mkdtemp(prefix="imagegen-agy-")
    out_hint = str(Path(tmpdir) / "out.png")
    intent = f"Generate an image. Scene: {args.gen_prompt}."
    if refs:
        resolved = [_resolve_ref_path(r)[0] for r in refs]
        n_char, n_style, n_comp = _ref_counts(args, refs)
        intent += ("\nReference images, in order: " + ", ".join(resolved)
                   + "\n" + _build_reference_framing(n_char, n_style, n_comp))
    if args.size and args.size != "auto":
        intent += f"\nTarget size: {args.size} pixels."

    prompt = _AGY_PROMPT.format(intent=intent, out=out_hint)
    cmd = [agy, "-p", prompt, "--output-format", "text"]
    if getattr(args, "agy_yolo", True):
        # Headless agy cannot prompt for tool permissions, and image generation
        # needs at least one tool — without pre-approval every run dies with
        # "no output produced". The alternative is a permissions.allow entry in
        # the user's agy settings.json; --no-agy-yolo leaves that to them.
        cmd.append("--dangerously-skip-permissions")

    emit("running agy (this bills the Antigravity account, not Codex)")
    try:
        rc, out, err = _run_agy_watched(
            cmd, tmpdir, max(60.0, args.timeout), stall_timeout)
    except subprocess.TimeoutExpired:
        raise GatewayError(f"agy timed out after {args.timeout}s") from None
    if rc != 0:
        tail = (err or out or "").strip().splitlines()[-3:]
        raise GatewayError(f"agy failed (exit {rc}): "
                           f"{' / '.join(tail)[:300]}")

    path = out_hint if Path(out_hint).is_file() else _agy_extract_path(out)
    if not path or not Path(path).is_file():
        tail = " / ".join(out.strip().splitlines()[-3:])[:300]
        raise GatewayError(
            "agy ran but no image file was produced. It said: " + tail)

    data = Path(path).read_bytes()
    # Never trust the extension agy chose: a run that saved "teapot.png" in fact
    # wrote a JPEG. Sniff the real type so the file lands with a truthful name.
    ctype = _sniff_mime(data[:16]) or "application/octet-stream"
    emit(f"agy produced {len(data)} bytes ({ctype})")
    return data, {"content_type": ctype, "source": "agy", "agy_path": path}


# ---------- save ----------

def _default_out_path(prompt: str, fmt: str) -> Path:
    slug = re.sub(r"[^a-z0-9]+", "-", prompt.lower()).strip("-")[:60] or "image"
    base = Path("assets/generated")
    base.mkdir(parents=True, exist_ok=True)
    i = 1
    while True:
        candidate = base / (f"{slug}.{fmt}" if i == 1 else f"{slug}-{i}.{fmt}")
        if not candidate.exists():
            return candidate
        i += 1


def _maybe_warn_extension_mismatch(out_path: Path, fmt: str) -> None:
    ext = out_path.suffix.lower().lstrip(".")
    # Map jpg <-> jpeg as equivalent.
    canon = "jpeg" if ext == "jpg" else ext
    if canon and canon != fmt:
        print(
            f"   .. warning: --format={fmt} but {out_path.name} has .{ext} extension; "
            f"writing {fmt} bytes anyway",
            file=sys.stderr,
        )


_MIME_TO_FMT = {"image/png": "png", "image/jpeg": "jpeg", "image/webp": "webp",
                "image/gif": "gif"}


def _fmt_from_mime(content_type: str | None) -> str | None:
    """'image/png' → 'png'. None when the type is unknown/unsniffable."""
    return _MIME_TO_FMT.get((content_type or "").split(";")[0].strip().lower())


def _warn_content_type_mismatch(out_path: Path, fmt: str,
                                content_type: str | None) -> None:
    """Warn when the bytes we're about to write are NOT the requested format.

    `_maybe_warn_extension_mismatch` only compares --format against the
    filename, so an agy run that answered `--format jpeg` with PNG bytes wrote
    PNG into a .jpg and said nothing (issue #25). We cannot transcode — the CLI
    is standard-library-only, no Pillow — so the contract is: always write the
    real bytes, never lie about them silently.
    """
    actual = _fmt_from_mime(content_type)
    if not actual or actual == fmt:
        return
    print(
        f"   .. warning: asked for --format={fmt} but the backend returned "
        f"{actual} bytes; {out_path.name} contains {actual}, not {fmt} "
        f"(no transcode: this CLI is standard-library-only)",
        file=sys.stderr,
    )


def _positive_int(value: str) -> int:
    try:
        v = int(value)
    except ValueError:
        raise argparse.ArgumentTypeError(f"must be a positive integer: {value!r}")
    if v <= 0:
        raise argparse.ArgumentTypeError(f"must be a positive integer: {value!r}")
    return v


def _non_negative_int(value: str) -> int:
    """Like `_positive_int`, but 0 is a legal value meaning "disabled".

    `--stall-timeout` needs this: its own stall message tells the user to drop
    the timeout to 0 to wait out the full --timeout, and argparse used to
    reject exactly that advice (issue #30).
    """
    try:
        v = int(value)
    except ValueError:
        raise argparse.ArgumentTypeError(
            f"must be 0 or a positive integer: {value!r}")
    if v < 0:
        raise argparse.ArgumentTypeError(
            f"must be 0 or a positive integer: {value!r}")
    return v


def _compression_int(value: str) -> int:
    """`--compression`: an integer percentage 0-100 for jpeg/webp output."""
    try:
        v = int(value)
    except (TypeError, ValueError):
        raise argparse.ArgumentTypeError(
            f"must be an integer 0-100: {value!r}")
    if not 0 <= v <= 100:
        raise argparse.ArgumentTypeError(
            f"must be an integer 0-100: {value!r}")
    return v


def _partial_images_int(value: str) -> int:
    """`--partial-images`: how many progressive previews to stream (1-3)."""
    try:
        v = int(value)
    except (TypeError, ValueError):
        raise argparse.ArgumentTypeError(
            f"must be an integer 1-3: {value!r}")
    if not 1 <= v <= 3:
        raise argparse.ArgumentTypeError(
            f"must be an integer 1-3: {value!r}")
    return v


def _opt_int_env(name: str) -> str | None:
    """An integer option's env default, returned as the raw string so
    argparse's `type` converts it — or None when unset/blank, so an empty env
    var is never handed to `int()`."""
    v = (_env(name) or "").strip()
    return v or None


_IMAGE_AUTO_VALUES = {"", "auto", "default"}


def _image_opt(value: str | None) -> str | None:
    """Normalise a codex image-tool string option. '' / 'auto' / 'default' all
    mean "let the backend choose", so they collapse to None and the field is
    omitted from the request — payloads stay byte-identical for callers that
    never set one."""
    if value is None:
        return None
    v = value.strip()
    return None if v.lower() in _IMAGE_AUTO_VALUES else v


_CODEX_IMAGE_OPTION_FLAGS = (
    ("image_model", "--image-model"),
    ("quality", "--quality"),
    ("background", "--background"),
    ("compression", "--compression"),
    ("action", "--action"),
    ("partial_images", "--partial-images"),
)


def _warn_codex_tool_overrides(args: argparse.Namespace, effective: dict) -> None:
    """The codex path rewrites the image tool server-side (observed: model →
    gpt-image-2-codex, quality/size/background → auto). When a requested knob
    did not survive, say so — silently ignoring it is what makes the flag look
    broken. Not gated on `progress`: this must survive --no-progress."""
    if not effective:
        return
    asked = {
        "model": getattr(args, "image_model", None),
        "quality": getattr(args, "quality", None),
        "background": getattr(args, "background", None),
        "output_compression": getattr(args, "compression", None),
    }
    changed = [f"{k}={v}→{effective.get(k)}" for k, v in asked.items()
               if v is not None and str(effective.get(k)).lower() != str(v).lower()]
    if changed:
        print(_fmt_progress(
            0.0,
            "warning: codex rewrote the image tool server-side "
            f"({', '.join(changed)}); the server decides these on this path."),
            file=sys.stderr)


def _codex_only_options(args: argparse.Namespace) -> list[str]:
    """Flags the user set that the image tool can only honour on the codex
    backend — web/gemini/agy have no such knobs."""
    return [flag for attr, flag in _CODEX_IMAGE_OPTION_FLAGS
            if getattr(args, attr, None) is not None]


# ---------- animation sprite sheets ----------

def _build_animation_prompt(prompt: str) -> str:
    """Wrap a normal image prompt as a strict, crop-safe 4x2 animation sheet.

    Models still choose the final pixel dimensions, so layout correctness is
    enforced twice: strongly here, then deterministically in
    ``_render_animation``. The wording deliberately fixes the body and camera;
    this v1 is for loops such as waving/blinking/tail-wagging, not walk cycles
    that intentionally translate across the canvas.
    """
    return (
        f"Create an animation sprite sheet for this request: {prompt}\n\n"
        "LAYOUT: exactly 4 columns by 2 rows, exactly eight equal rectangular "
        "cells, read left-to-right across the top row and then the bottom row. "
        "Fill the full canvas edge-to-edge. Do not draw borders, gutters, panel "
        "frames, captions, labels, numbers, or instructions.\n"
        "CONTINUITY: show the same single subject in all eight cells. Keep its "
        "identity, body center, scale, camera, ground contact, baseline, and "
        "background absolutely fixed. Only the requested moving part or small "
        "pose detail may change. No character drift, zoom, squash, stretch, or "
        "background movement.\n"
        "MOTION: frame 1 is the resting pose; frames 2-4 move gradually toward "
        "the action peak; frame 5 is the peak; frames 6-8 return gradually "
        "toward frame 1. Use small, smooth increments suitable for a seamless "
        "loop. Every cell must remain a clean independent animation frame."
    )


def _png_dimensions(data: bytes) -> tuple[int, int]:
    """Read PNG IHDR dimensions without adding a Pillow dependency."""
    if len(data) < 24 or data[:8] != b"\x89PNG\r\n\x1a\n" or data[12:16] != b"IHDR":
        raise AnimationError("animation source is not a valid PNG sprite sheet")
    width = int.from_bytes(data[16:20], "big")
    height = int.from_bytes(data[20:24], "big")
    if width < ANIMATION_COLS or height < ANIMATION_ROWS:
        raise AnimationError(f"animation sprite sheet is too small: {width}x{height}")
    return width, height


def _animation_frame_order(frame_count: int = ANIMATION_FRAME_COUNT,
                           ping_pong: bool = True) -> list[int]:
    order = list(range(frame_count))
    if ping_pong and frame_count > 2:
        order.extend(range(frame_count - 2, 0, -1))
    return order


def _animation_output_path(prompt: str, requested: str | None,
                           fmt: str | None) -> tuple[Path, str]:
    """Resolve the primary animation path and format.

    An explicit .gif/.webp suffix is authoritative unless --animation-format
    explicitly contradicts it, which is treated as an error rather than writing
    bytes under the wrong extension.
    """
    explicit = Path(requested) if requested else None
    suffix = explicit.suffix.lower().lstrip(".") if explicit else ""
    if suffix in ("gif", "webp"):
        if fmt and fmt != suffix:
            raise AnimationError(
                f"--animation-format={fmt} conflicts with output extension .{suffix}")
        resolved_fmt = suffix
    else:
        resolved_fmt = fmt or "webp"
    if explicit:
        path = explicit if explicit.suffix else explicit.with_suffix(f".{resolved_fmt}")
    else:
        path = _default_out_path(prompt, resolved_fmt)
    return path, resolved_fmt


def _animation_preflight(fmt: str, also_gif: bool) -> None:
    """Fail before spending an image generation when encoders are unavailable."""
    if fmt == "gif" and also_gif:
        raise AnimationError("--also-gif is redundant with --animation-format gif")
    if not shutil.which("magick"):
        raise AnimationError(
            "animation needs ImageMagick (`magick`); install it, then rerun")
    if fmt == "webp" and not shutil.which("img2webp"):
        raise AnimationError(
            "animated WebP needs `img2webp` (libwebp); install it or use "
            "--animation-format gif")


_CC_RE = re.compile(
    r"^\s*\d+:\s+\d+x\d+\+[-\d]+\+[-\d]+\s+"
    r"([\d.]+),([\d.]+)\s+(\d+)\s+gray\(255(?:\.0+)?\)\s*$"
)


def _connected_component_candidates(output: str, pixels: int,
                                    height: int) -> list[tuple[float, float, int]]:
    """Parse plausible subject anchors from ImageMagick verbose output."""
    candidates: list[tuple[float, float, int]] = []
    for line in output.splitlines():
        match = _CC_RE.match(line)
        if not match:
            continue
        x, y, area = float(match.group(1)), float(match.group(2)), int(match.group(3))
        # Ignore specks and a thresholded background that fills most of a cell.
        if pixels * 0.01 <= area <= pixels * 0.45:
            candidates.append((x, y, area))
    # Prefer a large component in the upper/middle part of the cell. This picks
    # a stable head/torso anchor over grass or a moving tail in comic artwork.
    candidates.sort(key=lambda item: item[2] * (1.35 if item[1] < height * 0.68 else 1.0),
                    reverse=True)
    return candidates


def _subject_anchor(frame: Path, magick: str,
                    width: int, height: int) -> tuple[float, float] | None:
    """Best-effort dominant-subject anchor for drift rejection.

    Two masks cover the common generated-art cases: a dense dark subject on a
    light background, and a light subject on a colored/dark background. If no
    trustworthy component exists we skip the heuristic instead of inventing a
    coordinate. ImageMagick is already required for cropping/GIF encoding.
    """
    variants = [
        ["-threshold", "35%", "-negate", "-morphology", "Erode", "Disk:3"],
        ["-threshold", "85%", "-morphology", "Erode", "Disk:2"],
    ]
    found: list[tuple[float, float, int]] = []
    for ops in variants:
        proc = subprocess.run(
            [magick, str(frame), "-colorspace", "gray", *ops,
             "-define", "connected-components:verbose=true",
             "-connected-components", "4", "null:"],
            capture_output=True, text=True,
        )
        if proc.returncode not in (0, 1):
            continue
        found.extend(_connected_component_candidates(
            proc.stdout + proc.stderr, width * height, height))
    if not found:
        return None
    found.sort(key=lambda item: item[2] * (1.35 if item[1] < height * 0.68 else 1.0),
               reverse=True)
    return found[0][0], found[0][1]


def _subject_drift(frames: list[Path], magick: str,
                   width: int, height: int) -> tuple[float, float] | None:
    anchors = [_subject_anchor(frame, magick, width, height) for frame in frames]
    if any(anchor is None for anchor in anchors):
        return None
    xs = [anchor[0] for anchor in anchors if anchor is not None]
    ys = [anchor[1] for anchor in anchors if anchor is not None]
    mid_x = sorted(xs)[len(xs) // 2]
    mid_y = sorted(ys)[len(ys) // 2]
    return max(abs(x - mid_x) for x in xs), max(abs(y - mid_y) for y in ys)


def _run_checked(command: list[str], label: str) -> None:
    try:
        proc = subprocess.run(command, capture_output=True, text=True)
    except OSError as error:
        raise AnimationError(f"could not run {label}: {error}") from error
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout).strip()[-500:]
        raise AnimationError(f"{label} failed: {detail or f'exit {proc.returncode}'}")


def _render_animation(sprite_path: Path, sprite_bytes: bytes, out_path: Path,
                      fmt: str, fps: int, also_gif: bool, keep_frames: bool,
                      ping_pong: bool, max_drift: float,
                      allow_drift: bool, progress: bool) -> list[Path]:
    """Crop a generated 4x2 sheet, reject obvious drift, and encode outputs."""
    _animation_preflight(fmt, also_gif)
    magick = shutil.which("magick")
    assert magick is not None

    width, height = _png_dimensions(sprite_bytes)
    cell_w, cell_h = width // ANIMATION_COLS, height // ANIMATION_ROWS
    discarded_w = width - cell_w * ANIMATION_COLS
    discarded_h = height - cell_h * ANIMATION_ROWS
    out_path.parent.mkdir(parents=True, exist_ok=True)

    permanent_dir = out_path.with_name(f"{out_path.stem}-frames")
    temp_ctx = None
    if keep_frames:
        permanent_dir.mkdir(parents=True, exist_ok=True)
        frame_dir = permanent_dir
    else:
        temp_ctx = tempfile.TemporaryDirectory(prefix="image-use-frames-")
        frame_dir = Path(temp_ctx.name)

    try:
        frames: list[Path] = []
        for index in range(ANIMATION_FRAME_COUNT):
            row, col = divmod(index, ANIMATION_COLS)
            frame = frame_dir / f"frame-{index:02d}.png"
            _run_checked(
                [magick, str(sprite_path), "-crop",
                 f"{cell_w}x{cell_h}+{col * cell_w}+{row * cell_h}",
                 "+repage", str(frame)],
                f"crop frame {index + 1}",
            )
            frames.append(frame)

        drift = _subject_drift(frames, magick, cell_w, cell_h)
        if drift is not None and max(drift) > max_drift and not allow_drift:
            raise AnimationError(
                f"subject drift is too large (x={drift[0]:.1f}px, "
                f"y={drift[1]:.1f}px; limit={max_drift:.1f}px). "
                "The sprite sheet was kept; regenerate it or pass --allow-drift "
                "for intentional translation."
            )
        if progress:
            normalized = (f"; discarded edge pixels {discarded_w}x{discarded_h}"
                          if discarded_w or discarded_h else "")
            if drift is None:
                drift_text = "subject drift check skipped (no stable anchor)"
            else:
                drift_text = f"subject drift x={drift[0]:.1f}px y={drift[1]:.1f}px"
            print(f"   .. animation cells {cell_w}x{cell_h}{normalized}; {drift_text}",
                  file=sys.stderr)

        order = _animation_frame_order(ping_pong=ping_pong)
        sequence = [frames[index] for index in order]
        outputs: list[Path] = []
        duration_ms = max(1, round(1000 / fps))

        if fmt == "webp":
            img2webp = shutil.which("img2webp")
            assert img2webp is not None
            command = [img2webp, "-loop", "0", "-sharp_yuv"]
            for frame in sequence:
                command.extend(["-d", str(duration_ms), "-lossy", "-q", "82",
                                "-m", "4", str(frame)])
            command.extend(["-o", str(out_path)])
            _run_checked(command, "animated WebP encoding")
            outputs.append(out_path)
            if also_gif:
                gif_path = out_path.with_suffix(".gif")
                delay = max(1, round(100 / fps))
                _run_checked(
                    [magick, "-delay", str(delay), "-loop", "0",
                     *map(str, sequence), "-layers", "Optimize", str(gif_path)],
                    "GIF encoding",
                )
                outputs.append(gif_path)
        else:
            delay = max(1, round(100 / fps))
            _run_checked(
                [magick, "-delay", str(delay), "-loop", "0",
                 *map(str, sequence), "-layers", "Optimize", str(out_path)],
                "GIF encoding",
            )
            outputs.append(out_path)
        return outputs
    finally:
        if temp_ctx is not None:
            temp_ctx.cleanup()


# ---------- codex backend (headless responses API) ----------

def _model_unsupported_error(err: GatewayError) -> bool:
    """True for the Codex account-allowlist rejection (HTTP 400 naming the model
    and the ChatGPT account), as opposed to a generic bad request."""
    return err.status == 400 and "not supported when using Codex" in str(err)


def run_codex(
    args: argparse.Namespace, progress: bool, stall_timeout: float, start: float,
    refs: list[str] | None = None,
) -> tuple[bytes, JsonDict]:
    """Generate an image via the headless codex/responses endpoint.

    Fast and dependency-free, but every call bills the metered Codex-usage
    bucket. Returns (image_bytes, meta); exits on unrecoverable failure.

    When `refs` (reference image paths/URLs) are supplied, runs image-to-image:
    each reference is attached as an `input_image` content part and the image
    tool is forced (`tool_choice: required`).

    Concurrency is gated at CODEX_CONCURRENCY_DEFAULT (4) parallel runs by a
    cross-process semaphore — wide enough for real fan-out, tight enough that a
    big agent batch can't trip the per-account limiter. Tune (or disable with
    0) via IMAGE_USE_CODEX_CONCURRENCY.
    """
    auth = _load_auth()
    access, account_id, refresh = _extract_access_token(auth)
    if not access:
        sys.exit(
            "no ChatGPT OAuth access_token in ~/.codex/auth.json. "
            "Run `codex login` to sign into your ChatGPT subscription. "
            "(An OPENAI_API_KEY in this file is not a substitute — the backend "
            "requires a subscription OAuth token.)"
        )

    loaded_refs: list[tuple[str, str]] | None = None
    if refs:
        loaded_refs = [_load_reference(r) for r in refs]
        if progress:
            approx = sum(len(b64) for b64, _ in loaded_refs)
            print(
                f"[{time.monotonic() - start:6.1f}s] image-to-image: "
                f"{len(loaded_refs)} reference(s), ~{approx // 1024} KB base64",
                file=sys.stderr,
            )

    version = _detect_codex_version()
    n_char, n_style, n_comp = _ref_counts(args, refs)
    payload = _build_payload(
        args.gen_prompt, args.size, args.format, args.model,
        refs=loaded_refs,
        n_character_refs=n_char, n_style_refs=n_style,
        n_composition_refs=n_comp,
        image_model=getattr(args, "image_model", None),
        quality=getattr(args, "quality", None),
        background=getattr(args, "background", None),
        output_compression=getattr(args, "compression", None),
        action=getattr(args, "action", None),
        partial_images=getattr(args, "partial_images", None))

    with _concurrency_slot("codex", _backend_limit("codex", CODEX_CONCURRENCY_DEFAULT),
                           progress, start):
        return _run_codex_locked(
            args, progress, stall_timeout, start, payload, account_id, access,
            refresh, version, auth)


def _run_codex_locked(
    args, progress, stall_timeout, start, payload, account_id, access,
    refresh, version, auth,
) -> tuple[bytes, JsonDict]:
    # Budget from NOW, not process start: the run may have queued on the codex
    # concurrency slot, and that wait must not eat the --timeout image budget.
    deadline = time.monotonic() + args.timeout

    def _attempt(token: str) -> tuple[bytes, JsonDict]:
        headers = _build_headers(token, account_id, version)
        return _post_for_image(payload, headers, deadline, start, stall_timeout, progress)

    try:
        return _attempt(access)
    except GatewayError as e:
        # A Codex-account allowlist rejects unknown models with HTTP 400. The
        # default comes from that allowlist, but a user-supplied --model (or a
        # future rotation) can miss — fall back once instead of failing the run.
        if (_model_unsupported_error(e)
                and payload.get("model") != CODEX_MODEL_FALLBACK):
            if progress:
                print(f"[{time.monotonic() - start:6.1f}s] model "
                      f"{payload.get('model')!r} not supported by this Codex "
                      f"account; retrying with {CODEX_MODEL_FALLBACK}",
                      file=sys.stderr)
            payload["model"] = CODEX_MODEL_FALLBACK
            return _attempt(access)
        # Auto-refresh on 401/403 once, then retry. Any other error → fail clean.
        if e.status in (401, 403) and refresh:
            if progress:
                print(f"[{time.monotonic() - start:6.1f}s] access token expired; refreshing",
                      file=sys.stderr)
            try:
                refreshed = _refresh_access_token(refresh)
            except GatewayError as re_err:
                sys.exit(str(re_err))
            except Exception as re_err:
                # Never include the refresh response body / token material in the message.
                sys.exit(f"token refresh failed: {type(re_err).__name__}")
            new_access = refreshed.get("access_token")
            if not isinstance(new_access, str) or not new_access:
                # Avoid leaking the dict (may contain id_token / refresh_token).
                present = sorted(k for k in refreshed if isinstance(refreshed.get(k), str))
                sys.exit(
                    f"refresh response missing access_token "
                    f"(present string fields: {present})"
                )
            try:
                _persist_refreshed_auth(auth, refreshed)
            except Exception as p_err:
                # Always warn on persistence failure, even in quiet mode — stale
                # tokens on next run will look like a mysterious failure otherwise.
                print(
                    f"warning: could not persist refreshed token to {AUTH_PATH}: "
                    f"{type(p_err).__name__}: {p_err}",
                    file=sys.stderr,
                )
            try:
                return _attempt(new_access)
            except GatewayError as retry_err:
                sys.exit(str(retry_err))
        else:
            sys.exit(str(e))


# ---------- backend routing ----------

def _dispatch(
    args: argparse.Namespace, progress: bool, stall_timeout: float, start: float
) -> tuple[bytes, JsonDict]:
    """Pick a backend and run it.

    auto  : prefer web (spares Codex-usage); fall back to codex only when the
            web backend is *unavailable* (no chrome-use / browser not
            reachable / not logged in). A web failure that happens after the
            prompt was submitted is NOT silently retried on codex — that would
            spend the very bucket auto-mode is trying to protect.
    web   : force web; any failure is fatal (with guidance).
    codex : force codex.
    """
    def note(msg: str) -> None:
        if progress:
            print(_fmt_progress(time.monotonic() - start, msg), file=sys.stderr)

    _ignored = _codex_only_options(args)

    def warn_ignored(backend: str) -> None:
        # Deliberately NOT gated on `progress`: a silently dropped --quality is
        # exactly the surprise that must survive --no-progress.
        if _ignored:
            print(_fmt_progress(
                time.monotonic() - start,
                f"warning: {', '.join(_ignored)} only take effect on "
                f"--backend codex (ignored on {backend}); rerun with "
                f"--backend codex to use them."), file=sys.stderr)

    # main() has already resolved the active asset set, partitioned it into
    # character/style groups, applied the total-ref cap, and stored the ordered
    # file list (asset refs + ad-hoc --ref) on args. Fall back to the raw --ref
    # list if that machinery didn't run (defensive).
    refs = getattr(args, "resolved_refs", None)
    if refs is None:
        refs = getattr(args, "ref", None)
    refs = refs or None
    # Image-to-image (refs) is now supported on BOTH backends: web attaches the
    # reference to the composer via `chrome-use upload`, codex sends it as an
    # input_image part. So refs ride the normal backend selection below — auto
    # still prefers web (spares Codex-usage), exactly like text-to-image.

    if args.backend == "codex":
        return run_codex(args, progress, stall_timeout, start, refs=refs)

    # Any explicitly named non-codex backend cannot honour the image-tool knobs;
    # say so once, before the vendor-specific branches below.
    if _ignored and args.backend != "auto":
        warn_ignored(args.backend)

    # The two Gemini surfaces are explicit-only: they are never reached from
    # `auto`. That is a deliberate choice, not an omission — they hit a
    # different vendor and a different account, and their output differs in ways
    # a caller would notice (a visible watermark on text-to-image, an aspect
    # ratio that can only be requested rather than set). Silently rerouting an
    # existing `auto` user there would change their images without their asking.
    if args.backend == "agy":
        try:
            return run_agy(args, progress, start, refs=refs,
                           stall_timeout=stall_timeout)
        except GatewayError as e:
            msg = str(e)
            # The two Gemini surfaces draw on SEPARATE quotas — proven, not
            # assumed: a run that got "Image generation model quota
            # (gemini-3.1-flash-image) has been exhausted (429)" from agy was
            # followed seconds later by a successful --backend gemini run on the
            # same Google account. Worth telling the user, since the obvious
            # reading of a quota error is "this account is done for now".
            if "quota" in msg.lower() or "429" in msg:
                msg += ("\nagy and the gemini browser backend bill separate "
                        "quotas — `--backend gemini` may still work right now.")
            sys.exit(msg)

    if args.backend == "gemini":
        limit = _backend_limit("gemini", WEB_CONCURRENCY_DEFAULT)
        try:
            with _concurrency_slot("gemini", limit, progress, start):
                return run_gemini(args, progress, start, refs=refs)
        except GatewayError as e:
            sys.exit(str(e))

    web_limit = _backend_limit("web", WEB_CONCURRENCY_DEFAULT)

    if args.backend == "web":
        try:
            # Outer: the cross-tool chatgpt.com lock, so chatgpt-use and a second
            # copy of this tool queue behind us for the WHOLE generation.
            with _chatgpt_web_turn(progress, start):
                with _concurrency_slot("web", web_limit, progress, start):
                    return run_web(args, progress, start, refs=refs)
        except GatewayError as e:
            sys.exit(str(e))

    # auto
    try:
        with _chatgpt_web_turn(progress, start):
            with _concurrency_slot("web", web_limit, progress, start):
                result = run_web(args, progress, start, refs=refs)
    except WebUnavailable as e:
        if _codex_token_present():
            if _find_agent_browser() is None:
                # chrome-use isn't installed. Keep this to a *gentle* one-line
                # tip — never dump install commands here, and never install on
                # the user's behalf. Full setup guidance lives in the README /
                # skill and is for when the user explicitly opts in.
                note("chrome-use not installed; falling back to codex "
                     "(bills the metered Codex-usage bucket).")
                note("tip: with chrome-use installed, generation runs through "
                     "your logged-in browser and costs no Codex usage.")
            else:
                note(f"web backend unavailable ({e}); falling back to codex "
                     f"(this consumes Codex-usage).")
            return run_codex(args, progress, stall_timeout, start, refs=refs)
        sys.exit(
            "cannot generate an image — neither backend is ready:\n"
            f"  • web:   {e}\n"
            "  • codex: no ChatGPT OAuth token in ~/.codex/auth.json "
            "(run `npm i -g @openai/codex && codex login`).\n"
            "Set up either the logged-in browser (preferred — spares Codex-usage) "
            "or codex login."
        )
    except GatewayError as e:
        # Web was available but failed mid-generation. Don't silently burn the
        # Codex bucket; surface it and let the user decide (--backend codex).
        sys.exit(
            f"{e}\n(web backend was reachable, so auto-mode did not fall back to "
            f"codex — rerun with --backend codex to use the Codex-usage path.)"
        )
    # Web produced the image, so the codex-only knobs really were ignored (had
    # web been unavailable, we'd be in the codex branch above).
    warn_ignored("web (auto)")
    return result


# ── Style presets ──────────────────────────────────────────────────────────
# Named, reusable prompt snippets appended (as a comma-joined suffix) to the
# user's prompt. Stored in ~/.config/chatgpt-imagegen/styles.json. There are NO
# built-in styles: the library starts empty and fills from the gallery — either
# one-off via `--style-online SLUG`, or persisted via `style pull SLUG` (and
# `--style NAME` auto-pulls a missing name from the gallery on first use).
_STYLE_NAME_RE = re.compile(r"^[a-z0-9][a-z0-9_-]*$")

# An "asset" (a v2 styles entry) is either a recurring character (reproduce it
# faithfully as the subject) or a style (match the aesthetic, not the content).
_STYLE_KINDS = ("character", "style")
# Extension a copied reference is normalized to, by sniffed MIME.
_REF_EXT_BY_MIME = {"image/png": "png", "image/jpeg": "jpg", "image/webp": "webp"}
# Default cap on how many reference images one generation may attach. The
# resolved set is ordered character-first; anything past the cap is dropped with
# a logged warning (never silently truncated).
REF_ATTACH_CAP = 4


def _valid_style_name(name: str) -> bool:
    """A style name is a lowercase slug: alnum/-/_ , starting alphanumeric."""
    return bool(_STYLE_NAME_RE.match(name or ""))


def _compose_prompt(user_prompt: str, snippet: str | None) -> str:
    """Append a style snippet to the prompt as a comma-joined suffix.

    Blank/None snippet → prompt unchanged. A single trailing ','/'.' on the
    prompt is dropped so the join reads cleanly. Pure; no I/O.
    """
    if not snippet or not snippet.strip():
        return user_prompt
    base = user_prompt.rstrip()
    if base and base[-1] in ",.":
        base = base[:-1].rstrip()
    snippet = snippet.strip()
    return f"{base}, {snippet}" if base else snippet


# The config directory keeps its pre-rename name on purpose: moving it would
# strand every user's saved styles, pinned references and update cache.
CONFIG_DIRNAME = "chatgpt-imagegen"


def _styles_path() -> Path:
    base = os.environ.get("XDG_CONFIG_HOME", "").strip()
    root = Path(base) if base else Path.home() / ".config"
    return root / CONFIG_DIRNAME / "styles.json"


# ---------- asset library (reference images pinned per asset) ----------

def _assets_root() -> Path:
    """Directory holding each asset's copied reference images
    (~/.config/chatgpt-imagegen/assets/)."""
    return _styles_path().parent / "assets"


def _asset_dir(name: str) -> Path:
    """The on-disk directory that holds asset ``name``'s reference images."""
    return _assets_root() / name


def _last_output_path() -> Path:
    """Tiny state file recording the most recently generated image (for
    `--from-last`)."""
    return _styles_path().parent / "last-output.json"


def _record_last_output(path: Path) -> None:
    """Record the absolute path of the just-saved image so `--from-last` can pin
    it later. Best-effort: this bookkeeping never fails a real generation."""
    try:
        p = _last_output_path()
        p.parent.mkdir(parents=True, exist_ok=True)
        tmp = p.with_name(p.name + ".tmp")
        tmp.write_text(
            json.dumps({"path": str(path.resolve()), "ts": time.time()}),
            encoding="utf-8")
        os.replace(tmp, p)
    except Exception:  # noqa: BLE001 — capture is a nicety, never fatal
        pass


def _read_last_output() -> Path | None:
    """The path recorded by the last successful generation, or None."""
    try:
        data = json.loads(_last_output_path().read_text(encoding="utf-8"))
    except Exception:  # noqa: BLE001
        return None
    p = data.get("path") if isinstance(data, dict) else None
    return Path(p) if isinstance(p, str) and p else None


def _resolve_from_last() -> str:
    """Path of the most recently generated image, for `--from-last`. Exits with
    an actionable message if nothing was recorded or the file is gone."""
    p = _read_last_output()
    if p is None:
        raise SystemExit(
            "error: --from-last: no recently generated image was recorded yet. "
            "Generate one first, or pass an explicit --ref <path>.")
    if not p.is_file():
        raise SystemExit(
            f"error: --from-last: the last generated image is gone ({p}). "
            f"Pass an explicit --ref <path> instead.")
    return str(p)


# ── Platform (drawstyle) integration ────────────────────────────────────────
# All drawstyle.leeguoo.com I/O funnels through _platform_request so tests can
# patch one function and offline failures produce one consistent message.

DRAWSTYLE_API_DEFAULT = "https://drawstyle.leeguoo.com"
PLATFORM_TIMEOUT = 15  # seconds
OIDC_ISSUER = "https://account.leeguoo.com"
OIDC_CLIENT_ID = "drawstyle-cli"
OIDC_LOOPBACK_PORT = 45898
_PLATFORM_CATEGORIES = (
    "report", "slides", "tech-explainer", "social-cover",
    "avatar-ip", "cute", "retro-comic", "photo-real",
)
# Anonymous player-gallery uploads (drawstyle POST /api/uploads): no login, the
# quota is keyed on X-Drawstyle-Machine-Id per UTC day, and each file is capped.
UPLOAD_MAX_BYTES = 5 * 1024 * 1024
UPLOAD_DAILY_LIMIT = 10
UPLOAD_DOWNSCALE_EDGE = 2048


def _platform_base() -> str:
    return (os.environ.get("DRAWSTYLE_API", "").strip()
            or DRAWSTYLE_API_DEFAULT).rstrip("/")


def _urlopen(req, timeout):  # tiny seam so tests can fake the network
    return urllib.request.urlopen(req, timeout=timeout, context=_ssl_ctx())


def _platform_request(method: str, path: str, *, data: bytes | None = None,
                      headers: dict | None = None) -> dict:
    """One HTTP round-trip to the platform, JSON in/out.

    Raises SystemExit with the server's error.message (or a network hint) —
    callers never see raw urllib exceptions.
    """
    url = _platform_base() + path
    req_headers = {"User-Agent": f"chatgpt-imagegen/{__version__}"}
    req_headers.update(headers or {})
    req = urllib.request.Request(url, data=data, method=method,
                                 headers=req_headers)
    try:
        with _urlopen(req, timeout=PLATFORM_TIMEOUT) as resp:
            raw = resp.read().decode("utf-8", errors="ignore")
    except urllib.error.HTTPError as e:
        try:
            msg = json.loads(e.read().decode("utf-8"))["error"]["message"]
        except Exception:  # noqa: BLE001
            msg = f"HTTP {e.code}"
        raise SystemExit(f"error: platform: {msg}") from None
    except (urllib.error.URLError, TimeoutError, OSError) as e:
        raise SystemExit(
            f"error: cannot reach {_platform_base()} ({e}). "
            "Generation with local styles is unaffected; "
            "retry when online.") from None
    try:
        return json.loads(raw)
    except json.JSONDecodeError:
        raise SystemExit(
            "error: platform: unexpected response (not JSON)") from None


def _pkce_pair() -> tuple[str, str]:
    verifier = base64.urlsafe_b64encode(
        secrets.token_bytes(48)).rstrip(b"=").decode()
    challenge = base64.urlsafe_b64encode(
        hashlib.sha256(verifier.encode()).digest()).rstrip(b"=").decode()
    return verifier, challenge


def _platform_auth_path() -> Path:
    return _styles_path().parent / "drawstyle-auth.json"


def _tokens_with_expiry(tokens: dict,
                        fallback_refresh: str | None = None) -> dict:
    out = dict(tokens)
    if fallback_refresh and not isinstance(out.get("refresh_token"), str):
        out["refresh_token"] = fallback_refresh
    try:
        expires_in = int(out.get("expires_in") or 0)
    except (TypeError, ValueError):
        expires_in = 0
    if expires_in > 0:
        out["expires_at"] = time.time() + expires_in - 60
    return out


def _save_platform_auth(tokens: dict) -> None:
    path = _platform_auth_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    fd = os.open(str(tmp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(tokens, f, ensure_ascii=False, indent=2)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
        os.chmod(path, 0o600)
    except Exception:
        try:
            tmp.unlink()
        except FileNotFoundError:
            pass
        raise


def _load_platform_auth() -> dict | None:
    path = _platform_auth_path()
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return None
    except (OSError, json.JSONDecodeError):
        return None
    return data if isinstance(data, dict) else None


def _oidc_token_request(form: dict) -> dict:
    """POST a token form to account.leeguoo.com.

    Kept as a seam so tests can exercise refresh behavior without network.
    """
    body = urllib.parse.urlencode(form).encode("utf-8")
    req = urllib.request.Request(
        OIDC_ISSUER.rstrip("/") + "/token",
        data=body,
        method="POST",
        headers={"Content-Type": "application/x-www-form-urlencoded",
                 "Accept": "application/json"},
    )
    try:
        with _urlopen(req, timeout=PLATFORM_TIMEOUT) as resp:
            raw = resp.read().decode("utf-8", errors="ignore")
    except urllib.error.HTTPError as e:
        raise SystemExit(f"error: drawstyle login token exchange failed "
                         f"(HTTP {e.code})") from None
    except (urllib.error.URLError, TimeoutError, OSError) as e:
        raise SystemExit(
            f"error: cannot reach {OIDC_ISSUER} for login ({e})") from None
    try:
        data = json.loads(raw)
    except json.JSONDecodeError:
        raise SystemExit(
            "error: drawstyle login token exchange returned non-JSON") from None
    if not isinstance(data, dict) or not isinstance(data.get("access_token"), str):
        raise SystemExit(
            "error: drawstyle login token exchange missing access_token")
    return data


def _oidc_callback_match(path: str, expected_state: str) -> tuple[bool, str]:
    """Decide whether one loopback request is the OIDC callback we're waiting for.

    Returns ``(accept, code)``. ``accept`` is True only for a request to the
    ``/cb`` path whose ``state`` matches ``expected_state`` and that carries a
    non-empty ``code``. Non-``/cb`` paths (favicon probes, speculative fetches,
    another process poking the port) and state mismatches return ``(False, "")``
    so the caller keeps waiting instead of burning the single handshake. Pure;
    no I/O.
    """
    parsed = urllib.parse.urlparse(path)
    if parsed.path != "/cb":
        return (False, "")
    params = urllib.parse.parse_qs(parsed.query)
    state = (params.get("state") or [""])[0]
    code = (params.get("code") or [""])[0]
    if not code or state != expected_state:
        return (False, "")
    return (True, code)


def _oidc_login_interactive() -> dict:
    verifier, challenge = _pkce_pair()
    state = secrets.token_urlsafe(24)
    accepted: dict[str, str] = {"code": ""}

    class Handler(http.server.BaseHTTPRequestHandler):
        def do_GET(self):  # noqa: N802 - stdlib callback name
            ok, code = _oidc_callback_match(self.path, state)
            if ok:
                accepted["code"] = code
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.end_headers()
                self.wfile.write(
                    b"<html><body>You can close this tab.</body></html>")
            else:
                # Ignore stray requests (favicon, speculative prefetch, another
                # process): answer 404 and keep the server alive for the real
                # callback instead of consuming the one handshake.
                self.send_response(404)
                self.send_header("Content-Type", "text/plain; charset=utf-8")
                self.end_headers()
                self.wfile.write(b"waiting for drawstyle login callback")

        def log_message(self, fmt, *args):  # noqa: A003
            return

    try:
        server = http.server.HTTPServer(
            ("127.0.0.1", OIDC_LOOPBACK_PORT), Handler)
    except OSError as e:
        raise SystemExit(
            "error: drawstyle login callback port "
            f"127.0.0.1:{OIDC_LOOPBACK_PORT} is unavailable ({e}). "
            "Close the process using that port and retry.") from None
    try:
        redirect_uri = f"http://127.0.0.1:{OIDC_LOOPBACK_PORT}/cb"
        query = urllib.parse.urlencode({
            "response_type": "code",
            "client_id": OIDC_CLIENT_ID,
            "redirect_uri": redirect_uri,
            "scope": "openid email profile",
            "state": state,
            "code_challenge": challenge,
            "code_challenge_method": "S256",
        })
        url = OIDC_ISSUER.rstrip("/") + "/authorize?" + query
        if not webbrowser.open(url):
            print(f"Open this URL to log in: {url}", file=sys.stderr)
        else:
            print(f"Opened browser for drawstyle login: {url}", file=sys.stderr)
        # Loop past stray requests until the matching callback arrives or the
        # overall deadline fires; each handle_request() waits up to the time
        # remaining.
        deadline = time.time() + 180
        while not accepted["code"]:
            remaining = deadline - time.time()
            if remaining <= 0:
                break
            server.timeout = remaining
            server.handle_request()
    finally:
        server.server_close()
    if not accepted["code"]:
        raise SystemExit("error: drawstyle login failed or timed out")
    tokens = _oidc_token_request({
        "grant_type": "authorization_code",
        "code": accepted["code"],
        "redirect_uri": redirect_uri,
        "client_id": OIDC_CLIENT_ID,
        "code_verifier": verifier,
    })
    return _tokens_with_expiry(tokens)


def _platform_access_token(*, interactive: bool = True) -> str:
    tokens = _load_platform_auth() or {}
    access = tokens.get("access_token")
    try:
        expires_at = float(tokens.get("expires_at") or 0)
    except (TypeError, ValueError):
        expires_at = 0
    if isinstance(access, str) and expires_at > time.time():
        return access

    refresh = tokens.get("refresh_token")
    if isinstance(refresh, str):
        try:
            refreshed = _oidc_token_request({
                "grant_type": "refresh_token",
                "refresh_token": refresh,
                "client_id": OIDC_CLIENT_ID,
            })
        except SystemExit:
            # A revoked/expired refresh token must not permanently brick
            # `style publish`. In an interactive context we fall through to a
            # fresh browser login; a non-interactive caller (tests/automation)
            # keeps the fail-fast contract and gets the SystemExit.
            if not interactive:
                raise
        else:
            merged = _tokens_with_expiry(refreshed, fallback_refresh=refresh)
            _save_platform_auth(merged)
            token = merged.get("access_token")
            if isinstance(token, str):
                return token

    if not interactive:
        raise SystemExit("error: drawstyle login required")
    logged_in = _oidc_login_interactive()
    _save_platform_auth(logged_in)
    token = logged_in.get("access_token")
    if not isinstance(token, str):
        raise SystemExit("error: drawstyle login missing access_token")
    return token


def _multipart_escape(value: str) -> str:
    return value.replace("\\", "\\\\").replace('"', '\\"')


def _multipart_form(fields: list[tuple[str, str]],
                    files: list[tuple[str, Path, str, bytes]]) -> tuple[bytes, str]:
    """Build a small multipart/form-data body using stdlib only."""
    boundary = "----image-use-" + secrets.token_hex(16)
    chunks: list[bytes] = []
    for name, value in fields:
        chunks.append(f"--{boundary}\r\n".encode())
        chunks.append(
            f'Content-Disposition: form-data; name="{_multipart_escape(name)}"'
            "\r\n\r\n".encode())
        chunks.append(str(value).encode("utf-8"))
        chunks.append(b"\r\n")
    for name, path, content_type, data in files:
        filename = _multipart_escape(path.name)
        chunks.append(f"--{boundary}\r\n".encode())
        chunks.append(
            f'Content-Disposition: form-data; name="{_multipart_escape(name)}"; '
            f'filename="{filename}"\r\n'.encode())
        chunks.append(f"Content-Type: {content_type}\r\n\r\n".encode())
        chunks.append(data)
        chunks.append(b"\r\n")
    chunks.append(f"--{boundary}--\r\n".encode())
    return b"".join(chunks), boundary


def _read_publish_image(path: str, label: str) -> tuple[Path, str, bytes]:
    p = Path(path).expanduser()
    if not p.is_file():
        raise SystemExit(f"error: {label} image not found: {path}")
    data = p.read_bytes()
    mime = _sniff_mime(data)
    if not mime:
        raise SystemExit(f"error: {label} {path!r} is not an image "
                         "(need PNG, JPEG, or WEBP)")
    return p, mime, data


def _upload_machine_id() -> str:
    """Per-machine id for the platform's daily upload quota.

    Defaults to the plain hostname (the platform's own convention); the value
    IS the quota key, so keep it stable per box. IMAGE_USE_MACHINE_ID
    overrides it when a fleet wants to pool or split its 10/day budgets.
    """
    override = _env("IMAGE_USE_MACHINE_ID", "").strip()
    if override:
        return override
    try:
        return socket.gethostname() or "unknown"
    except OSError:  # a hostname lookup must never break a run
        return "unknown"


def _read_upload_image(path: str) -> tuple[Path, str, bytes]:
    """Read an upload candidate. Like `_read_publish_image`, but also accepts
    GIF (the platform allows animated examples; the reference path does not)."""
    p = Path(path).expanduser()
    if not p.is_file():
        raise SystemExit(f"error: image not found: {path}")
    data = p.read_bytes()
    mime = _sniff_mime(data)
    if mime is None and data[:6] in (b"GIF87a", b"GIF89a"):
        mime = "image/gif"
    if mime is None:
        raise SystemExit(f"error: {path!r} is not an image "
                         "(need PNG, JPEG, WEBP, or GIF)")
    return p, mime, data


def _downscale_for_upload(src_path: str) -> bytes | None:
    """Re-encode an over-cap upload to a <=UPLOAD_DOWNSCALE_EDGE JPEG via `sips`.

    The same no-pip-deps trade-off as `_downsize_reference`, but a separate edge
    so tuning one never silently changes the other. Returns None when `sips` is
    unavailable or failed.
    """
    if shutil.which("sips") is None:
        return None
    fd, tmp = tempfile.mkstemp(suffix=".jpg")
    os.close(fd)
    try:
        proc = subprocess.run(
            ["sips", "-s", "format", "jpeg", "-Z", str(UPLOAD_DOWNSCALE_EDGE),
             src_path, "--out", tmp],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        if proc.returncode != 0:
            return None
        return Path(tmp).read_bytes()
    except Exception:  # noqa: BLE001
        return None
    finally:
        try:
            os.unlink(tmp)
        except OSError:
            pass


def _upload_gallery_image(img_path: str, style_slug: str | None) -> dict:
    """Push one image to the drawstyle player gallery (POST /api/uploads).

    Anonymous — no login; the quota is keyed on the machine id. An over-cap file
    is downscaled ONCE (sips, <=UPLOAD_DOWNSCALE_EDGE, JPEG); anything still over
    the cap exits with a fix-it message rather than silently re-encoding the
    user's image. Returns the server's `upload` object.
    """
    p, mime, data = _read_upload_image(img_path)
    if len(data) > UPLOAD_MAX_BYTES:
        shrunk = _downscale_for_upload(str(p))
        if shrunk is not None and len(shrunk) <= UPLOAD_MAX_BYTES:
            mime, data = "image/jpeg", shrunk
        else:
            mb = UPLOAD_MAX_BYTES // (1024 * 1024)
            raise SystemExit(
                f"error: {p.name} is {len(data) / 1024 / 1024:.1f} MB — over the "
                f"platform's {mb} MB upload cap. Resize it first, e.g.\n"
                f"  magick {p.name} -resize {UPLOAD_DOWNSCALE_EDGE}x"
                f"{UPLOAD_DOWNSCALE_EDGE} smaller.jpg")
    fields = [("style_slug", style_slug)] if style_slug else []
    body, boundary = _multipart_form(fields, [("image", p, mime, data)])
    resp = _platform_request(
        "POST", "/api/uploads", data=body,
        headers={"X-Drawstyle-Machine-Id": _upload_machine_id(),
                 "Content-Type": f"multipart/form-data; boundary={boundary}"})
    upload = resp.get("upload") if isinstance(resp, dict) else None
    if not isinstance(upload, dict) or not isinstance(upload.get("url"), str):
        raise SystemExit("error: platform: unexpected upload response")
    return upload


def _format_upload_line(upload: dict, style_slug: str | None = None) -> str:
    """Human-readable upload result: direct image link, the style's gallery
    page, and the remaining daily quota."""
    lines = [f"uploaded → {upload['url']}"]
    if style_slug:
        lines.append(
            f"gallery  → {_platform_base()}/en/s/{style_slug}/generations")
    remaining = upload.get("remaining_today")
    if remaining is not None:
        lines.append(f"remaining today: {remaining}")
    return "\n".join(lines)


def _download_bytes(url: str) -> bytes:
    """Fetch one reference image from the platform.

    Kept as a seam so pull/update tests can exercise atomic style storage
    without reaching the network.
    """
    req = urllib.request.Request(
        url,
        headers={"User-Agent": f"chatgpt-imagegen/{__version__}"},
    )
    with _urlopen(req, timeout=PLATFORM_TIMEOUT) as resp:
        return resp.read()


def _pull_refs_to_tmp(refs: list[dict], tmp: Path) -> list[str]:
    """Download platform refs into ``tmp`` after MIME sniffing.

    Any failure raises before the caller touches styles.json or the real asset
    directory, so platform pulls are all-or-nothing from the local library's
    point of view.
    """
    stored: list[str] = []
    for i, ref in enumerate(refs, 1):
        url = ref["url"]
        try:
            data = _download_bytes(url)
        except SystemExit:
            raise
        except (urllib.error.URLError, TimeoutError, OSError) as e:
            raise SystemExit(
                f"error: failed to download ref {url}: {e}") from None
        mime = _sniff_mime(data)
        ext = _REF_EXT_BY_MIME.get(mime or "")
        if not ext:
            raise SystemExit(
                f"error: ref {url} is not an image "
                f"(sniffed {mime or 'unknown'})")
        fname = f"ref-{i}.{ext}"
        (tmp / fname).write_bytes(data)
        stored.append(fname)
    return stored


def _apply_package(doc: dict, name: str, pkg: dict) -> list[str]:
    """Apply one platform package to a local style entry.

    Refs are downloaded before touching the real asset dir, so a single entry
    is applied per-entry atomically. The caller decides when to save ``doc``;
    `style update` saves after each entry so a mid-list failure leaves a
    consistent partial state rather than on-disk refs out of sync with the doc.

    A malformed package payload (missing kind/slug/version) exits cleanly rather
    than raising a KeyError traceback.
    """
    if not isinstance(pkg, dict) or not all(
            k in pkg for k in ("kind", "slug", "version")):
        raise SystemExit("error: platform: malformed package response")
    with tempfile.TemporaryDirectory() as td:
        tmp = Path(td)
        stored = _pull_refs_to_tmp(pkg.get("refs") or [], tmp)
        asset_dir = _asset_dir(name)
        shutil.rmtree(asset_dir, ignore_errors=True)
        if stored:
            asset_dir.mkdir(parents=True, exist_ok=True)
            for fname in stored:
                shutil.move(str(tmp / fname), asset_dir / fname)
    doc["styles"][name] = {"kind": pkg["kind"],
                           "snippet": pkg.get("snippet") or "",
                           "refs": stored,
                           "origin": {"platform": "drawstyle",
                                      "slug": pkg["slug"],
                                      "version": pkg["version"]}}
    return stored


def _resolve_online_styles(slugs: list[str]) -> tuple[list[str], list[dict]]:
    """Fetch platform styles for ONE-SHOT use during a generation — no local
    persist. Returns (snippets, ref_records) where each ref_record is the
    ``{ref, group, label}`` shape `_collect_refs` produces. Reference images are
    downloaded to temp dirs cleaned up at process exit.

    This is what `--style-online SLUG` uses: an agent can generate with a gallery
    style immediately, without `style pull` writing anything to the library.
    """
    snippets: list[str] = []
    refs: list[dict] = []
    for slug in slugs:
        if not _valid_style_name(slug):
            raise SystemExit(f"error: invalid style slug {slug!r}")
        pkg = _platform_request("GET", f"/api/styles/{slug}/package")
        if not isinstance(pkg, dict) or "kind" not in pkg:
            raise SystemExit("error: platform: malformed package response")
        snip = pkg.get("snippet") or ""
        if snip:
            snippets.append(snip)
        group = "character" if pkg.get("kind") == "character" else "style"
        pkg_refs = pkg.get("refs") or []
        if pkg_refs:
            tmp = Path(tempfile.mkdtemp(prefix="cig-online-"))
            atexit.register(shutil.rmtree, str(tmp), ignore_errors=True)
            # _pull_refs_to_tmp returns filenames 1:1 with pkg_refs (all-or-
            # nothing), so zip recovers each ref's source URL for provenance.
            for fn, src in zip(_pull_refs_to_tmp(pkg_refs, tmp), pkg_refs):
                refs.append({"ref": str(tmp / fn), "group": group,
                             "label": f"online:{slug}/{fn}",
                             "source": src.get("url")})
    return snippets, refs


def _next_ref_index(asset_dir: Path, existing: list[str]) -> int:
    """Next free `ref-<n>` index, considering both the entry's recorded refs and
    whatever already sits in the asset dir (so copies never collide)."""
    nums = [0]
    names = list(existing)
    if asset_dir.is_dir():
        names += [f.name for f in asset_dir.iterdir()]
    for nm in names:
        m = re.match(r"ref-(\d+)\.", nm)
        if m:
            nums.append(int(m.group(1)))
    return max(nums) + 1


def _copy_ref_into_asset(asset_dir: Path, src: str, existing: list[str]) -> str:
    """Validate, downsize-if-needed, and copy ``src`` into ``asset_dir`` under a
    normalized ``ref-<n>.<ext>`` filename; return that filename.

    Validation uses `_sniff_mime` (PNG/JPEG/WEBP). Oversized images are shrunk by
    calling `_downsize_reference` DIRECTLY (not `_load_reference`, which is the
    codex-only base64 path). Exits cleanly on a missing file / unsupported type.
    """
    p = Path(src).expanduser()
    if not p.is_file():
        sys.exit(f"reference image not found: {src}")
    raw = p.read_bytes()
    mime = _sniff_mime(raw)
    if mime is None:
        sys.exit(f"unsupported reference image type for {src!r} (need PNG, JPEG, or WEBP)")
    ext = _REF_EXT_BY_MIME.get(mime, "png")
    data = raw
    # Downsize oversized references just like the codex path does — directly via
    # sips, keeping the no-pip-deps property — so the library stays portable.
    if len(base64.b64encode(raw)) > REF_B64_BUDGET:
        shrunk = _downsize_reference(str(p))
        if shrunk is not None:
            data = shrunk
            ext = "jpg"
    fname = f"ref-{_next_ref_index(asset_dir, existing)}.{ext}"
    asset_dir.mkdir(parents=True, exist_ok=True)
    dst = asset_dir / fname
    tmp = dst.with_name(dst.name + ".tmp")
    tmp.write_bytes(data)
    os.replace(tmp, dst)
    return fname


# ---------- self-update reminder ----------

def _update_cache_path() -> Path:
    base = os.environ.get("XDG_CONFIG_HOME", "").strip()
    root = Path(base) if base else Path.home() / ".config"
    return root / CONFIG_DIRNAME / "update-check.json"


def _parse_whatsnew(text: str) -> dict:
    """Map version → one-line note from `# WHATSNEW[ver]: note` comment lines."""
    out: dict[str, str] = {}
    for ver, note in re.findall(r"WHATSNEW\[([\d.]+)\]:\s*(.+)", text):
        out.setdefault(ver, note.strip())
    return out


def _fetch_latest_info(timeout: float = 4.0):
    """Best-effort `(latest_version, {ver: note})` from the script on main.

    Reads only an 8KB prefix (both `__version__` and the WHATSNEW lines live at
    the top), so it never pulls the whole file. Any network/parse failure returns
    `(None, {})` — this is a nicety, never a gate."""
    try:
        req = urllib.request.Request(
            UPDATE_CHECK_URL,
            headers={"User-Agent": f"chatgpt-imagegen/{__version__} update-check"},
        )
        with urllib.request.urlopen(req, timeout=timeout) as r:
            head = r.read(8192).decode("utf-8", "replace")
    except Exception:  # noqa: BLE001
        return None, {}
    m = re.search(r'__version__\s*=\s*"([\d.]+)"', head)
    return (m.group(1) if m else None), _parse_whatsnew(head)


def _changes_since(notes: dict, base: str = __version__) -> list[tuple[str, str]]:
    """WHATSNEW entries strictly newer than ``base``, newest first."""
    cur = _version_tuple(base)
    vers = sorted((v for v in notes if _version_tuple(v) > cur),
                  key=_version_tuple, reverse=True)
    return [(v, notes[v]) for v in vers]


def _format_update_notice(latest: str, notes: dict, max_lines: int = 3) -> str:
    """One header line + up to ``max_lines`` `• ver: what-changed` lines."""
    head = (f"提示:image-use {latest} 可用(当前 {__version__})。"
            f"更新:image-use update")
    changes = _changes_since(notes)
    lines = [head]
    for ver, note in changes[:max_lines]:
        lines.append(f"  • {ver}:{note}")
    extra = len(changes) - max_lines
    if extra > 0:
        lines.append(f"  • 另有 {extra} 项更新")
    return "\n".join(lines)


def _installed_script_version() -> str | None:
    """Version currently stored at the path this process was launched from."""
    try:
        head = Path(__file__).read_text(encoding="utf-8")[:8192]
    except OSError:
        return None
    match = re.search(r'^__version__\s*=\s*"([\d.]+)"', head, re.MULTILINE)
    return match.group(1) if match else None


def _maybe_notify_update(emit, *, auto_update: bool = False) -> None:
    """Once a day, handle a newer version found on main.

    Interactive callers pass ``auto_update=True``: use the same skills-manager
    path as the explicit ``update`` command and fall back to the ordinary notice
    if the runner is missing or fails. Tests and other callers default to the
    original notice-only behavior.

    Caches the result (timestamp, latest version, and the what's-new notes)
    under the config dir so normal runs do no network at all between daily
    checks. Fully skipped when IMAGE_USE_NO_UPDATE_CHECK is set. Never
    raises."""
    if _env("IMAGE_USE_NO_UPDATE_CHECK"):
        return
    cache = _update_cache_path()
    now = time.time()
    try:
        data = json.loads(cache.read_text(encoding="utf-8"))
        last = float(data.get("checked_at", 0))
        latest = data.get("latest")
        notes = data.get("notes") or {}
    except Exception:  # noqa: BLE001
        last, latest, notes = 0.0, None, {}

    if now - last >= UPDATE_CHECK_INTERVAL:
        fetched_latest, fetched_notes = _fetch_latest_info()
        if fetched_latest:                      # keep last-known if the fetch failed
            latest, notes = fetched_latest, fetched_notes
        try:
            cache.parent.mkdir(parents=True, exist_ok=True)
            cache.write_text(json.dumps(
                {"checked_at": now, "latest": latest, "notes": notes}), encoding="utf-8")
        except Exception:  # noqa: BLE001
            pass

    if not latest or _version_tuple(latest) <= _version_tuple(__version__):
        return

    if auto_update and not _env("IMAGE_USE_NO_AUTO_UPDATE"):
        argv = _update_runner()
        if argv:
            emit(f"检测到 image-use {latest},正在自动升级…")
            try:
                result = subprocess.run(
                    argv, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
                    text=True, timeout=120)
            except (OSError, subprocess.TimeoutExpired):
                result = None
            installed = _installed_script_version()
            if (result is not None and result.returncode == 0 and installed
                    and _version_tuple(installed) >= _version_tuple(latest)):
                emit(f"已自动升级到 v{latest};本次仍使用 v{__version__},下次运行生效。")
                return

    emit(_format_update_notice(latest, notes))


def _default_styles_doc() -> dict:
    # version 2: entries are {kind, snippet, refs} objects and `default` is a
    # list. A fresh install starts EMPTY — styles come from the gallery, never
    # from the CLI itself (no built-ins to seed).
    return {"version": 2, "default": [], "styles": {}}


def _normalize_entry(value: Any) -> dict:
    """Coerce one styles entry into the v2 object shape {kind, snippet, refs}.

    A legacy bare string → {kind: "style", snippet: <str>, refs: []}. An object
    is sanitized: kind clamped to the allowed set, snippet to a str, refs to a
    list of strings. An optional `origin` (platform provenance from `style
    pull`) is preserved when well-formed and dropped otherwise.
    """
    if isinstance(value, str):
        return {"kind": "style", "snippet": value, "refs": []}
    if isinstance(value, dict):
        kind = value.get("kind")
        if kind not in _STYLE_KINDS:
            kind = "style"
        snippet = value.get("snippet")
        if not isinstance(snippet, str):
            snippet = ""
        refs = value.get("refs")
        refs = [r for r in refs if isinstance(r, str)] if isinstance(refs, list) else []
        out = {"kind": kind, "snippet": snippet, "refs": refs}
        origin = value.get("origin")
        if (isinstance(origin, dict) and isinstance(origin.get("slug"), str)
                and isinstance(origin.get("version"), int)
                and not isinstance(origin.get("version"), bool)):
            p = origin.get("platform")
            platform = p if isinstance(p, str) and p else "drawstyle"
            out["origin"] = {"platform": platform,
                             "slug": origin["slug"], "version": origin["version"]}
        return out
    return {"kind": "style", "snippet": "", "refs": []}


def _normalize_doc(doc: dict) -> dict:
    """In-place upgrade a styles doc to version 2 so ALL downstream code sees
    objects + a list `default`.

    Centralizing this is what lets the generation hot path, `style list`, and
    `style show` stop assuming the value is a bare string. Mutating commands
    rewrite the upgraded shape; plain reads don't (no destructive auto-migration).
    """
    styles = doc.get("styles")
    if isinstance(styles, dict):
        for name, value in list(styles.items()):
            styles[name] = _normalize_entry(value)
    default = doc.get("default")
    if isinstance(default, str):
        doc["default"] = [default] if default else []
    elif isinstance(default, list):
        doc["default"] = [d for d in default if isinstance(d, str)]
    else:
        doc["default"] = []
    doc["version"] = 2
    return doc


def _save_styles(doc: dict) -> None:
    """Atomically write the styles doc (temp file + os.replace)."""
    path = _styles_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(doc, ensure_ascii=False, indent=2) + "\n",
                   encoding="utf-8")
    os.replace(tmp, path)


def _load_styles() -> dict:
    """Read the styles doc. A fresh install starts with an empty library (styles
    come from the gallery, not from built-ins). Raises SystemExit (clear message)
    on a corrupt/unreadable file rather than clobbering it."""
    path = _styles_path()
    if not path.exists():
        doc = _default_styles_doc()
        _save_styles(doc)            # write the empty library
        return _normalize_doc(doc)   # hand callers the normalized v2 shape
    try:
        doc = json.loads(path.read_text(encoding="utf-8"))
    except (ValueError, OSError) as e:
        raise SystemExit(f"error: cannot read styles file {path}: {e}")
    if not isinstance(doc, dict) or not isinstance(doc.get("styles"), dict):
        raise SystemExit(
            f"error: malformed styles file {path} "
            f"(expected an object with a 'styles' map). "
            f"Fix it by hand or run `image-use style reset`.")
    # Normalize immediately so every downstream site sees v2 objects + a list
    # `default` — legacy bare-string entries and a string `default` included.
    return _normalize_doc(doc)


def _die_unknown_style(name: str, styles: dict) -> None:
    """Exit on a style name that isn't local. Points at the gallery, since that's
    now the only source of styles (there are no built-ins to fall back on)."""
    avail = ", ".join(sorted(styles)) or "(none)"
    raise SystemExit(
        f"error: unknown style {name!r}. local styles: {avail}\n"
        f"  browse the gallery: image-use style search {name}\n"
        f"  fetch + keep it:    image-use style pull {name}\n"
        f"  use once (no save): image-use --style-online {name} ...")


def _resolve_style_name(doc: dict, *, style_arg: str | None,
                        no_style: bool) -> str | None:
    """Pick the style NAME to apply (or None). Order:
    1. --no-style       → None
    2. --style NAME     → NAME (error if unknown)
    3. active default   → it
    4. otherwise        → None
    """
    if no_style:
        return None
    styles = doc.get("styles", {})
    name = style_arg or (doc.get("default") or "")
    if not name:
        return None
    if name not in styles:
        _die_unknown_style(name, styles)
    return name


def _resolve_active_styles(doc: dict, *, style_args: list[str] | None,
                           no_style: bool) -> list[str]:
    """The active asset set (ordered) for a run. Stacking-aware successor to
    `_resolve_style_name`:

    1. --no-style          → []  (disables all asset application)
    2. explicit --style …  → those names, in order
    3. else                → the saved `default` list, in order

    Unknown names raise SystemExit (reusing `_die_unknown_style`).
    """
    if no_style:
        return []
    styles = doc.get("styles", {})
    names = list(style_args) if style_args else list(doc.get("default") or [])
    for n in names:
        if n not in styles:
            _die_unknown_style(n, styles)
    return names


# Names ever shipped as text-only built-ins (removed in 0.18.0). Their gallery
# equivalents carry reference images, so a leftover text-only copy in an old
# install is strictly weaker and silently shadows the good version. We
# transparently upgrade such a copy to the gallery version when the user applies
# or pulls that name — but ONLY when the entry still looks untouched (no pinned
# refs, no gallery origin), so a user's own edits/pinned images are never
# clobbered.
_LEGACY_BUILTIN_NAMES = frozenset({"doodle", "xiaohei", "snoopy"})


def _is_stale_legacy_builtin(name: str, entry: dict) -> bool:
    """True if ``entry`` is an untouched leftover of a removed text-only built-in.

    Untouched means: one of the known legacy names, no gallery ``origin`` (never
    pulled), and no pinned ``refs`` (user never added images). Such an entry is
    safe to replace with the gallery version of the same slug.
    """
    return (name in _LEGACY_BUILTIN_NAMES
            and not entry.get("origin")
            and not entry.get("refs"))


def _ensure_styles_local(doc: dict, names: list[str]) -> bool:
    """Make each requested style name resolve to the best local copy.

    Two self-healing behaviors, both keyed off the gallery:
    - **missing** name → fetched from the gallery and persisted (so `--style
      snoopy` "just works" without a prior `style pull`, and is offline-usable
      next time). Missing + not-on-gallery → `_die_unknown_style`.
    - **stale legacy built-in** (an untouched text-only leftover, see
      `_is_stale_legacy_builtin`) → upgraded in place to the gallery version
      (which carries a reference image). If the gallery is unreachable, the
      existing text-only copy is kept — a working-but-weaker style must never
      break offline.

    A name that's already a real local style (pulled or user-created) is left
    untouched with no network call. Returns True if it changed the doc.
    """
    styles = doc.setdefault("styles", {})
    changed = False
    for name in names:
        entry = styles.get(name)
        upgrade = entry is not None and _is_stale_legacy_builtin(name, entry)
        if entry is not None and not upgrade:
            continue
        if not _valid_style_name(name):
            _die_unknown_style(name, styles)
        try:
            pkg = _platform_request("GET", f"/api/styles/{name}/package")
        except SystemExit:
            if upgrade:
                # Offline / not on the gallery: keep the legacy text-only copy
                # rather than breaking a style that still works.
                continue
            # Missing locally AND unreachable/404 — fall back to the standard
            # unknown-style guidance rather than a bare platform error.
            _die_unknown_style(name, styles)
        _apply_package(doc, name, pkg)
        _save_styles(doc)
        changed = True
        if upgrade:
            print(f"upgraded legacy built-in {name!r} → gallery v{pkg.get('version')} "
                  f"(now with a reference image; saved locally)", file=sys.stderr)
        else:
            print(f"pulled {name!r} v{pkg.get('version')} from gallery "
                  f"(saved to your local library)", file=sys.stderr)
    return changed


def _collect_refs(doc: dict, active_names: list[str],
                  adhoc_refs: list[str] | None,
                  adhoc_role: str = "character",
                  adhoc_style_refs: list[str] | None = None,
                  adhoc_composition_refs: list[str] | None = None) -> list[dict]:
    """Build the ordered reference list for a run.

    Each item is ``{ref, group, label}`` where ``ref`` is a path/URL to attach,
    ``group`` is "character", "style" or "composition", and ``label`` names it
    for logging. Ordering (deterministic): character group, then style, then
    composition. Within the character group: character assets in active order,
    then the ad-hoc ``--ref`` images last (treated as character/subject by
    default, preserving the old is_edit behavior). Within the style group:
    active order, then ad-hoc ``--style-ref``.

    ``adhoc_role`` re-homes the plain ``--ref`` images (``--ref-role``), while
    ``--style-ref`` / ``--composition-ref`` name a role per image. All three
    exist because a bare ``--ref`` used to be unconditionally the canonical
    subject, which made "borrow the framing, replace the person" impossible to
    express (issue #26).

    Asset reference files must exist on disk — a missing one exits with an error
    naming the asset and the expected path (never silently skipped).
    """
    styles = doc.get("styles", {})
    char_items: list[dict] = []
    style_items: list[dict] = []
    comp_items: list[dict] = []
    for name in active_names:
        entry = styles[name]
        group = "character" if entry.get("kind") == "character" else "style"
        adir = _asset_dir(name)
        for fn in (entry.get("refs") or []):
            fpath = adir / fn
            if not fpath.is_file():
                raise SystemExit(
                    f"error: asset {name!r} references {fn!r} but the file is "
                    f"missing: {fpath}. Re-pin it (`image-use style "
                    f"add-ref {name} <img>`) or drop it "
                    f"(`image-use style rm-ref {name} {fn}`).")
            rec = {"ref": str(fpath), "group": group, "label": f"{name}/{fn}"}
            (char_items if group == "character" else style_items).append(rec)
    buckets = {"character": char_items, "style": style_items,
               "composition": comp_items}
    for r in (adhoc_refs or []):
        buckets[adhoc_role].append({"ref": r, "group": adhoc_role, "label": r})
    for r in (adhoc_style_refs or []):
        style_items.append({"ref": r, "group": "style", "label": r})
    for r in (adhoc_composition_refs or []):
        comp_items.append({"ref": r, "group": "composition", "label": r})
    return char_items + style_items + comp_items


def _cap_refs(ordered: list[dict], cap: int) -> tuple[list[dict], list[dict]]:
    """Split an ordered ref list at ``cap`` → (kept, dropped). cap<=0 disables."""
    if cap and len(ordered) > cap:
        return ordered[:cap], ordered[cap:]
    return list(ordered), []


def _ref_sha256(path: str) -> str:
    """Full sha256 hex of a reference file (or '?' if unreadable). Used only for
    the provenance log — an online ref's hash should equal the sha256 in its
    gallery URL filename, letting the user verify exactly what was attached."""
    try:
        return hashlib.sha256(Path(path).read_bytes()).hexdigest()
    except OSError:
        return "?"


def _format_ref_provenance(kept_refs: list[dict]) -> list[str]:
    """One provenance line per attached reference, for the pre-generation log.

    Answers "what exactly got sent": which asset/online slug (label), whether
    it's a character or style ref (group), its on-disk path or gallery source
    URL, and a sha256 prefix to pin the actual bytes. Local asset refs and
    ad-hoc ``--ref`` images show their path; online refs show ``source=<url>``.
    """
    lines: list[str] = []
    for r in kept_refs:
        sha = _ref_sha256(r["ref"])
        sha_bit = f"sha256={sha[:16]}…" if sha != "?" else "sha256=?"
        src = r.get("source")
        loc = f"source={src}" if src else f"path={r['ref']}"
        lines.append(f"[{r.get('group', 'style')}] {r.get('label', r['ref'])}  "
                     f"{sha_bit}  {loc}")
    return lines


def _upload_command(argv: list[str]) -> int:
    """`image-use upload <IMG> [--style SLUG]`.

    The ONLY path that posts an image to the platform: uploading is the user's
    call, made after they've seen the result — generation never auto-pushes.
    """
    p = argparse.ArgumentParser(
        prog="image-use upload",
        description="Push one image to a drawstyle style's player gallery "
                    f"(anonymous — no login; ≤{UPLOAD_MAX_BYTES // (1024 * 1024)} "
                    f"MB/file, {UPLOAD_DAILY_LIMIT}/machine/day).",
    )
    p.add_argument("image", metavar="IMG")
    p.add_argument("--style", dest="upload_style", default=None, metavar="SLUG",
                   help="associate the upload with this style slug so it shows "
                        "up in that style's player gallery")
    a = p.parse_args(argv)
    upload = _upload_gallery_image(a.image, a.upload_style)
    print(_format_upload_line(upload, a.upload_style), file=sys.stderr)
    print(upload["url"])          # stdout: the public URL, pipeable
    return 0


def _style_command(argv: list[str]) -> int:
    """`image-use style <verb> ...` — manage style presets."""
    p = argparse.ArgumentParser(
        prog="image-use style",
        description="Manage reusable prompt-style presets "
                    f"(stored in {_styles_path()}).")
    sub = p.add_subparsers(dest="verb")
    sub.add_parser("list", help="list all assets (kind, 📎ref count, active *)")
    sp = sub.add_parser("show", help="print one asset's kind, snippet, refs, path")
    sp.add_argument("name")
    sp = sub.add_parser("add", help="create or overwrite an asset (snippet and/or refs)")
    sp.add_argument("name")
    sp.add_argument("snippet", nargs="?", default=None)
    sp.add_argument("--ref", action="append", default=None, metavar="IMG",
                    help="reference image to pin (repeatable); copied into the library")
    sp.add_argument("--kind", choices=list(_STYLE_KINDS), default="style",
                    help="character (reproduce as subject) or style (match aesthetic)")
    sp.add_argument("--from-last", action="store_true",
                    help="pin the most recently generated image as a reference")
    sp = sub.add_parser("add-ref", help="append reference image(s) to an asset")
    sp.add_argument("name")
    sp.add_argument("img", nargs="*")
    sp.add_argument("--from-last", action="store_true",
                    help="pin the most recently generated image")
    sp = sub.add_parser("rm-ref", help="remove one reference image from an asset")
    sp.add_argument("name")
    sp.add_argument("file")
    sp = sub.add_parser("rm", help="delete an asset (entry + its reference images)")
    sp.add_argument("name")
    sp = sub.add_parser("use", help="set the active default asset set (accepts multiple)")
    sp.add_argument("name", nargs="+")
    sub.add_parser("clear", help="empty the active default asset set")
    rp = sub.add_parser("reset", help="wipe the style library and all pinned refs (empty it)")
    rp.add_argument("-y", "--yes", action="store_true", help="skip the confirmation")
    sp = sub.add_parser("search", help="search the drawstyle platform")
    sp.add_argument("query", nargs="?", default="")
    sp.add_argument("--category", default=None)
    sp.add_argument("--tag", action="append", default=None)
    sp = sub.add_parser("pull", help="fetch a style from the drawstyle platform")
    sp.add_argument("slug")
    sp.add_argument("--as", dest="local_name", default=None, metavar="NAME",
                    help="store under a different local name")
    sp = sub.add_parser("update",
                        help="re-pull platform styles that have a newer version")
    sp.add_argument("name", nargs="?", default=None)
    sp = sub.add_parser("publish", help="submit a local style to the platform")
    sp.add_argument("name")
    sp.add_argument("--category", default=None)
    sp.add_argument("--tag", action="append", default=None)
    sp.add_argument("--example", action="append", default=None, metavar="IMG")
    sp.add_argument("--from-last", action="store_true",
                    help="use the most recently generated image as an example")
    a = p.parse_args(argv)

    if not a.verb:
        p.print_help()
        return 2

    if a.verb == "search":
        params = {"q": a.query} if a.query else {}
        if a.category:
            params["category"] = a.category
        for tag in (a.tag or []):
            params.setdefault("tag", []).append(tag)
        qs = urllib.parse.urlencode(params, doseq=True)
        data = _platform_request(
            "GET", "/api/styles" + (f"?{qs}" if qs else ""))
        rows = data.get("styles") or []
        if not rows:
            print("no styles found")
            return 0
        for style in rows:
            preview = " ".join((style.get("snippet") or "").split())[:60]
            print(f"{style['slug']} [{style['kind']}] ({style['category']}) "
                  f"♥{style.get('likes_count', 0)} "
                  f"⇩{style.get('pulls_count', 0)} — {preview}")
            print(f"    image-use style pull {style['slug']}")
        return 0

    doc = _load_styles()
    styles = doc["styles"]

    if a.verb == "publish":
        if a.name not in styles:
            _die_unknown_style(a.name, styles)
        entry = styles[a.name]
        origin = entry.get("origin")
        if isinstance(origin, dict) and origin.get("slug"):
            slug = origin["slug"]
            raise SystemExit(
                f"error: {a.name!r} already published as {slug!r} — "
                f"edit it on the web: {_platform_base()}/submit?edit={slug}")
        if a.category not in _PLATFORM_CATEGORIES:
            cats = ", ".join(_PLATFORM_CATEGORIES)
            raise SystemExit(
                f"error: --category is required and must be one of: {cats}\n"
                f"  e.g. image-use style publish {a.name} "
                f"--category {_PLATFORM_CATEGORIES[0]} --from-last")
        examples = list(a.example or [])
        if a.from_last:
            examples.append(_resolve_from_last())
        if not examples:
            raise SystemExit(
                "error: a submission needs at least one example image.\n"
                "  • use the image you just generated:  "
                f"image-use style publish {a.name} "
                f"--category {a.category} --from-last\n"
                "  • or pass one explicitly:            "
                f"image-use style publish {a.name} "
                f"--category {a.category} --example path/to.png")
        if len(examples) > 3:
            raise SystemExit("error: at most 3 --example images are allowed")

        fields = [
            ("slug", a.name),
            ("name", a.name),
            ("kind", entry.get("kind", "style")),
            ("snippet", entry.get("snippet") or ""),
            ("category", a.category),
        ]
        for tag in (a.tag or []):
            fields.append(("tag", tag))

        files: list[tuple[str, Path, str, bytes]] = []
        for path in examples:
            files.append(("example[]", *_read_publish_image(path, "example")))
        asset_dir = _asset_dir(a.name)
        for ref in (entry.get("refs") or []):
            files.append(("ref[]", *_read_publish_image(
                str(asset_dir / ref), "reference")))

        # Show what's about to be submitted before the (login-gated) upload.
        n_ex = len(examples)
        n_ref = sum(1 for f in files if f[0] == "ref[]")
        tag_str = ", ".join(a.tag) if a.tag else "(none)"
        print(
            f"publishing {a.name!r} → {_platform_base()}\n"
            f"  category: {a.category}   tags: {tag_str}\n"
            f"  examples: {n_ex}   references: {n_ref}",
            file=sys.stderr)
        body, boundary = _multipart_form(fields, files)
        token = _platform_access_token()
        resp = _platform_request(
            "POST", "/api/styles", data=body,
            headers={"Authorization": f"Bearer {token}",
                     "Content-Type": f"multipart/form-data; boundary={boundary}"},
        )
        # Record the platform origin so a second `publish` hits the friendly
        # already-published guard above rather than the server's generic
        # "slug taken". Prefer the server's canonical slug when it returns one.
        slug = a.name
        if isinstance(resp, dict) and isinstance(resp.get("slug"), str) and resp["slug"]:
            slug = resp["slug"]
        entry["origin"] = {"platform": "drawstyle", "slug": slug, "version": 1}
        _save_styles(doc)
        print(
            f"submitted {a.name!r} for review 🎉\n"
            f"  track approval: {_platform_base()}/zh/me",
            file=sys.stderr)
        return 0

    if a.verb == "pull":
        if not _valid_style_name(a.slug):
            raise SystemExit(f"error: invalid slug {a.slug!r}")
        name = a.local_name or a.slug
        if not _valid_style_name(name):
            raise SystemExit(f"error: invalid local name {name!r}")
        existing = styles.get(name)
        replacing_legacy = existing is not None and _is_stale_legacy_builtin(name, existing)
        if existing is not None and not replacing_legacy:
            raise SystemExit(
                f"error: local style {name!r} already exists — "
                f"pass --as OTHERNAME or `style rm {name}` first.")
        pkg = _platform_request("GET", f"/api/styles/{a.slug}/package")
        stored = _apply_package(doc, name, pkg)
        _save_styles(doc)
        note = " (replaced the legacy text-only built-in)" if replacing_legacy else ""
        print(f"pulled {a.slug!r} v{pkg['version']} as {name!r} "
              f"({len(stored)} ref{'s' if len(stored) != 1 else ''}){note}",
              file=sys.stderr)
        return 0

    if a.verb == "update":
        if a.name:
            if a.name not in styles:
                _die_unknown_style(a.name, styles)
            origin = styles[a.name].get("origin")
            if not isinstance(origin, dict) or not origin.get("slug"):
                raise SystemExit(
                    f"error: {a.name!r} has no platform origin")
            candidates = [(a.name, origin)]
        else:
            candidates = [
                (name, entry["origin"])
                for name, entry in styles.items()
                if isinstance(entry.get("origin"), dict)
                and entry["origin"].get("slug")
            ]
        if not candidates:
            print("no pulled styles")
            return 0

        for name, origin in candidates:
            slug = origin["slug"]
            current = int(origin.get("version") or 0)
            detail = _platform_request("GET", f"/api/styles/{slug}")
            remote = int(detail.get("version") or 0)
            if remote <= current:
                print(f"{name}: up to date (v{current})")
                continue
            pkg = _platform_request("GET", f"/api/styles/{slug}/package")
            stored = _apply_package(doc, name, pkg)
            # Save after each entry so a later network failure leaves a
            # consistent partial state (earlier entries' on-disk refs match the
            # saved doc) instead of unsaved edits diverging from disk.
            _save_styles(doc)
            print(f"{name}: updated v{current} -> v{pkg['version']} "
                  f"({len(stored)} ref{'s' if len(stored) != 1 else ''})")
        return 0

    if a.verb == "list":
        if not styles:
            print("(no styles)")
            return 0
        default = doc.get("default") or []
        for name in sorted(styles):
            entry = styles[name]
            preview = " ".join((entry.get("snippet") or "").split())
            if len(preview) > 60:
                preview = preview[:59] + "…"
            nrefs = len(entry.get("refs") or [])
            badge = f" 📎{nrefs}" if nrefs else ""
            mark = "*" if name in default else " "
            print(f"{mark} {name} [{entry.get('kind', 'style')}]{badge}: {preview}")
        if default:
            print(f"\n* = active default ({', '.join(default)})")
        else:
            print("\n(no active default — pass --style NAME to apply one)")
        return 0

    if a.verb == "show":
        if a.name not in styles:
            _die_unknown_style(a.name, styles)
        entry = styles[a.name]
        print(f"kind: {entry.get('kind', 'style')}")
        if entry.get("snippet"):
            print(f"snippet: {entry['snippet']}")
        refs = entry.get("refs") or []
        if refs:
            print(f"refs: {', '.join(refs)}")
        print(f"path: {_asset_dir(a.name)}")
        return 0

    if a.verb == "add":
        if not _valid_style_name(a.name):
            raise SystemExit(
                f"error: invalid style name {a.name!r}; use lowercase letters, "
                f"digits, '-' or '_', starting with a letter or digit.")
        srcs = list(a.ref or [])
        if a.from_last:
            srcs.append(_resolve_from_last())
        snippet = (a.snippet or "").strip()
        if not snippet and not srcs:
            raise SystemExit(
                "error: `style add` needs a snippet and/or at least one "
                "--ref/--from-last image.")
        existed = a.name in styles
        asset_dir = _asset_dir(a.name)
        # Overwrite cleanly: drop any prior reference files for this name so a
        # rebuilt asset never inherits stale refs.
        if asset_dir.exists():
            shutil.rmtree(asset_dir, ignore_errors=True)
        stored: list[str] = []
        for src in srcs:
            stored.append(_copy_ref_into_asset(asset_dir, src, stored))
        styles[a.name] = {"kind": a.kind, "snippet": snippet, "refs": stored}
        _save_styles(doc)
        extra = f" ({len(stored)} ref{'s' if len(stored) != 1 else ''})" if stored else ""
        print(f"{'updated' if existed else 'added'} {a.kind} asset {a.name!r}{extra}",
              file=sys.stderr)
        return 0

    if a.verb == "add-ref":
        if a.name not in styles:
            _die_unknown_style(a.name, styles)
        srcs = list(a.img or [])
        if a.from_last:
            srcs.append(_resolve_from_last())
        if not srcs:
            raise SystemExit(
                "error: `style add-ref` needs at least one image (or --from-last).")
        entry = styles[a.name]
        refs = entry.setdefault("refs", [])
        asset_dir = _asset_dir(a.name)
        added = []
        for src in srcs:
            fn = _copy_ref_into_asset(asset_dir, src, refs)
            refs.append(fn)
            added.append(fn)
        _save_styles(doc)
        print(f"added {len(added)} ref(s) to {a.name!r}: {', '.join(added)}",
              file=sys.stderr)
        return 0

    if a.verb == "rm-ref":
        if a.name not in styles:
            _die_unknown_style(a.name, styles)
        entry = styles[a.name]
        refs = entry.get("refs") or []
        if a.file not in refs:
            avail = ", ".join(refs) or "(none)"
            raise SystemExit(
                f"error: {a.name!r} has no reference {a.file!r}. available: {avail}")
        refs.remove(a.file)
        entry["refs"] = refs
        try:
            (_asset_dir(a.name) / a.file).unlink(missing_ok=True)
        except OSError:
            pass
        _save_styles(doc)
        print(f"removed ref {a.file!r} from {a.name!r}", file=sys.stderr)
        return 0

    if a.verb == "rm":
        if a.name not in styles:
            _die_unknown_style(a.name, styles)
        del styles[a.name]
        shutil.rmtree(_asset_dir(a.name), ignore_errors=True)
        default = doc.get("default") or []
        cleared = a.name in default
        if cleared:
            doc["default"] = [d for d in default if d != a.name]
        _save_styles(doc)
        tail = " (was in the active default; removed from it)" if cleared else ""
        print(f"removed asset {a.name!r}{tail}", file=sys.stderr)
        return 0

    if a.verb == "use":
        for name in a.name:
            if name not in styles:
                _die_unknown_style(name, styles)
        doc["default"] = list(a.name)
        _save_styles(doc)
        print(f"active default set to {', '.join(a.name)}", file=sys.stderr)
        return 0

    if a.verb == "clear":
        doc["default"] = []
        _save_styles(doc)
        print("active default cleared", file=sys.stderr)
        return 0

    if a.verb == "reset":
        if not a.yes:
            sys.stderr.write(
                "This discards all local styles AND deletes every pinned "
                "reference image, leaving an empty library. Continue? [y/N] ")
            sys.stderr.flush()
            if sys.stdin.readline().strip().lower() not in ("y", "yes"):
                print("aborted", file=sys.stderr)
                return 1
        shutil.rmtree(_assets_root(), ignore_errors=True)
        _save_styles(_default_styles_doc())
        print("style library reset to empty (re-pull styles from the gallery)",
              file=sys.stderr)
        return 0

    return 0


# ---------- doctor (preflight backend check) ----------

def _web_ready(chrome_use_installed: bool, relay: bool, n_profiles: int) -> bool:
    """The web backend can run if chrome-use is installed AND there's a logged-in
    browser to reach — the connected relay (your open Chrome) or at least one
    offline-detected logged-in profile we can launch."""
    return chrome_use_installed and (relay or n_profiles > 0)


def _auto_backend_pick(web_ready: bool, codex_ready: bool) -> str:
    """Which backend `--backend auto` would use, given each one's readiness."""
    if web_ready:
        return "web"
    if codex_ready:
        return "codex"
    return "neither"


_AB_INSTALL_ONELINE = (
    "not installed — curl -fsSL https://raw.githubusercontent.com/leeguooooo/"
    "chrome-use/main/install.sh | sh"
)


def _doctor_command(argv: list[str]) -> int:
    """`image-use doctor` — preflight check of both backends.

    Reports whether each backend is set up and which one `auto` would pick, so a
    "no logged-in browser" / "no token" failure is diagnosable BEFORE a real run
    (issue #15). Read-only; exits 0 if at least one backend is ready, else 1."""
    color = _use_color(sys.stdout)
    sym = {
        "ok":   _green("✓") if color else "[ok]  ",
        "warn": _yellow("⚠") if color else "[warn]",
        "fail": _red("✗") if color else "[fail]",
    }

    def line(status: str, label: str, detail: str) -> None:
        print(f"  {sym[status]}  {label:<11}{detail}")

    print("image-use doctor\n")

    pv = f"{sys.version_info.major}.{sys.version_info.minor}.{sys.version_info.micro}"
    ok_py = sys.version_info >= (3, 10)
    line("ok" if ok_py else "fail", "python", pv + ("" if ok_py else "  (need 3.10+)"))

    latest, notes = _fetch_latest_info()  # always fresh here (no throttle)
    if latest and _version_tuple(latest) > _version_tuple(__version__):
        line("warn", "version",
             f"{__version__} → {latest} 可用 (image-use update)")
        for ver, note in _changes_since(notes)[:5]:
            print(f"               • {ver}:{note}")
    else:
        line("ok", "version", __version__ + (" (latest)" if latest else ""))

    codex_ready = _codex_token_present()
    line("ok" if codex_ready else "fail", "codex",
         "OAuth token present (~/.codex/auth.json)" if codex_ready
         else "no token — run `codex login`")

    print("\n  animation:")
    magick = shutil.which("magick")
    img2webp = shutil.which("img2webp")
    line("ok" if magick else "warn", "magick",
         magick or "not installed — needed for sprite cropping and GIF")
    line("ok" if img2webp else "warn", "img2webp",
         img2webp or "not installed — needed for animated WebP")

    print("\n  web backend:")
    ab = _find_agent_browser()
    relay = False
    profiles: list[str] = []
    if ab is None:
        line("fail", "chrome-use", _AB_INSTALL_ONELINE)
    else:
        v = _chrome_use_version(ab)
        if v and _version_tuple(v) < _version_tuple(AB_MIN_VERSION):
            line("warn", "chrome-use",
                 f"{v} < {AB_MIN_VERSION} — update it (img2img/model-switch may fail)")
        else:
            line("ok", "chrome-use", v or "installed")
        relay = _relay_connected(ab)
        line("ok" if relay else "fail", "relay",
             "connected (drives your open Chrome)" if relay
             else "not connected — load the ab-connect extension, restart Chrome")
        profiles = _detect_logged_in_profiles()
        if profiles:
            shown = ", ".join(profiles[:4]) + ("…" if len(profiles) > 4 else "")
            line("ok", "profiles", f"{len(profiles)} logged-in: {shown}")
        else:
            line("fail", "profiles", "none detected — sign in to chatgpt.com")

    print("\n  gemini backends (opt-in — never chosen by auto):")
    g_profiles = _detect_google_profiles() if ab is not None else []
    pinned = _env("IMAGE_USE_GEMINI_PROFILE")
    if ab is None:
        line("fail", "gemini", "needs chrome-use (see above)")
    elif pinned:
        line("ok", "gemini", f"profile pinned: {pinned!r}")
    elif g_profiles:
        # Deliberately a warning, not an ok: a Google cookie proves a sign-in,
        # not a subscription, and a probe run landed on an expired account.
        line("warn", "gemini",
             f"{len(g_profiles)} Google profile(s), but none pinned — set "
             "IMAGE_USE_GEMINI_PROFILE")
    else:
        line("fail", "gemini", "no Google-signed-in Chrome profile detected")
    agy = _find_agy()
    line("ok" if agy else "fail", "agy",
         agy or "not installed — the Antigravity CLI provides `agy`")

    web_ready = _web_ready(ab is not None, relay, len(profiles))
    pick = _auto_backend_pick(web_ready, codex_ready)
    arrow = _dim("→", stream=sys.stdout) if color else "→"
    print()
    if pick == "neither":
        print(f"  {arrow} auto: no backend ready — set up one of the above.\n")
        return 1
    note = "spares Codex-usage" if pick == "web" else "bills Codex-usage"
    print(f"  {arrow} auto would use: {pick}  ({note})\n")
    return 0


def _open_file(path: Path, progress: bool) -> None:
    """Best-effort: open the saved image in the OS default viewer (`--open`).
    Never fails the run — a failure to launch the viewer only warns."""
    try:
        if sys.platform == "darwin":
            opener: list[str] = ["open", str(path)]
        elif sys.platform.startswith("win"):
            os.startfile(str(path))  # type: ignore[attr-defined]  # noqa: PLW1510
            return
        else:
            opener = ["xdg-open", str(path)]
        subprocess.Popen(opener, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception as e:  # noqa: BLE001
        if progress:
            print(f"warning: could not open {path}: {e}", file=sys.stderr)


