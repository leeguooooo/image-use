def _update_runner() -> list[str] | None:
    """argv that refreshes the install, or None when nothing can run it.

    Delivery is the `skills` manager. A global `skills` on PATH is the happy
    path, but it is NOT the common one — `skills` is normally invoked as
    `npx skills ...` and never lands on PATH, so requiring it made `update` a
    dead end on an otherwise perfectly working machine (it just printed a
    command the user also could not run). npx runs the same manager with no
    global install, so it is the fallback rather than a second error message.
    """
    name = _installed_skill_name()
    skills = shutil.which("skills")
    if skills:
        return [skills, "update", name]
    npx = shutil.which("npx")
    if npx:
        return [npx, "-y", "skills", "update", name]
    return None


SKILL_NAME = "image-use"
LEGACY_SKILL_NAME = "chatgpt-imagegen"


def _installed_skill_name() -> str:
    """The name the `skills` manager knows this install by.

    Installs made before the rename live in a `.../skills/chatgpt-imagegen/`
    directory and are recorded under that name, so `skills update image-use`
    would miss them; everything else (including a git checkout that happens
    to be named chatgpt-imagegen) is `image-use`."""
    try:
        here = Path(__file__).resolve().parent
    except OSError:
        return SKILL_NAME
    if here.name == LEGACY_SKILL_NAME and here.parent.name == "skills":
        return LEGACY_SKILL_NAME
    return SKILL_NAME


def _self_update() -> int:
    """`image-use update` / `upgrade` — refresh the installed CLI.

    Reserving these words as a subcommand fixes a real trap: without it,
    `image-use upgrade` silently became an image prompt (drawing the word
    "upgrade" and burning quota). Delivery is the `skills` manager (what the
    daily update reminder points at) — run directly when it is on PATH, else
    through npx; only when neither exists does this print the command instead
    of running it. On success it reports the latest known version — noting that
    the running process stays on the old code until the next invocation (this
    .py file was just replaced underneath it).
    """
    argv = _update_runner()
    if argv is None:
        print("`skills` 和 `npx` 都不在 PATH 上,无法自动升级。"
              "装上 Node 后执行:\n"
              f"  npx -y skills update {_installed_skill_name()}", file=sys.stderr)
        return 1
    print("升级中:" + " ".join(argv), file=sys.stderr)
    try:
        rc = subprocess.run(argv).returncode
    except OSError as e:
        print(f"error: 无法运行 `skills update`:{e}", file=sys.stderr)
        return 1
    if rc == 0:
        latest, _ = _fetch_latest_info()
        if latest and _version_tuple(latest) > _version_tuple(__version__):
            print(f"完成 → v{latest}(当前进程仍是 v{__version__},下次运行即为新版)。",
                  file=sys.stderr)
        elif latest:
            print(f"已是最新(v{__version__})。", file=sys.stderr)
    return rc


def main() -> int:
    if len(sys.argv) > 1 and sys.argv[1] in ("style", "styles"):
        return _style_command(sys.argv[2:])
    if len(sys.argv) > 1 and sys.argv[1] == "upload":
        return _upload_command(sys.argv[2:])
    if len(sys.argv) > 1 and sys.argv[1] == "doctor":
        return _doctor_command(sys.argv[2:])
    if len(sys.argv) > 1 and sys.argv[1] in ("update", "upgrade"):
        return _self_update()
    argv = sys.argv[1:]
    animate_mode = bool(argv and argv[0] == "animate")
    if animate_mode:
        argv = argv[1:]
    parser = argparse.ArgumentParser(
        description=(
            "Generate an 8-frame looping animation with your ChatGPT subscription."
            if animate_mode else
            "Generate an image with your ChatGPT subscription (no API key)."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=_HELP_EPILOG,
    )
    parser.add_argument(
        "-V", "--version", action="version",
        version=f"image-use {__version__}",
    )
    parser.add_argument("prompt", help="Description of the image to generate")
    style_grp = parser.add_mutually_exclusive_group()
    style_grp.add_argument(
        "--style", action="append", default=None, metavar="NAME",
        help="Apply a saved asset (style or character) to this prompt — its text "
             "snippet and any pinned reference images (see `image-use "
             "style list`). A name that isn't local yet is auto-pulled from the "
             "gallery and saved. Repeatable: multiple assets stack. Overrides the "
             "active default set for this run.",
    )
    style_grp.add_argument(
        "--no-style", action="store_true",
        help="Skip all assets (text + refs) for this run even if a default set "
             "is configured.",
    )
    parser.add_argument(
        "--style-online", action="append", default=None, metavar="SLUG",
        help="Apply a drawstyle.leeguoo.com style by slug for THIS generation "
             "only, without saving it to the local library (fetched on the fly). "
             "Repeatable; stacks with --style. Great for one-off use of a "
             "gallery style: `image-use \"a cat\" --style-online xiaohei`.",
    )
    parser.add_argument(
        "-o", "--out",
        help=("Primary GIF/WebP output path (sprite PNG is saved beside it)"
              if animate_mode else
              "Output file path (default: assets/generated/<slug>.<ext>)"),
    )
    parser.add_argument(
        "--size",
        default="1536x1024" if animate_mode else "auto",
        help="auto | WIDTHxHEIGHT (e.g. 1024x1024, 1536x1024, 1024x1536). "
             "Forwarded as-is; the backend decides what it accepts.",
    )
    if animate_mode:
        parser.add_argument(
            "--animation-format", choices=["webp", "gif"], default=None,
            help="Primary animation format (default: inferred from -o, otherwise webp)",
        )
        parser.add_argument(
            "--also-gif", action="store_true",
            help="Also write a GIF beside the primary WebP",
        )
        parser.add_argument(
            "--fps", type=_positive_int, default=ANIMATION_DEFAULT_FPS,
            help=f"Playback rate (default: {ANIMATION_DEFAULT_FPS})",
        )
        parser.add_argument(
            "--keep-frames", action="store_true",
            help="Keep the eight cropped PNG frames beside the output",
        )
        parser.add_argument(
            "--no-ping-pong", action="store_true",
            help="Play frames 1→8 directly instead of the smoother 1→8→2 loop",
        )
        parser.add_argument(
            "--max-drift", type=float, default=ANIMATION_DEFAULT_MAX_DRIFT,
            help=f"Reject detected subject drift above this many pixels "
                 f"(default: {ANIMATION_DEFAULT_MAX_DRIFT:g})",
        )
        parser.add_argument(
            "--allow-drift", action="store_true",
            help="Encode even when the subject intentionally translates across frames",
        )
        parser.set_defaults(format="png")
    else:
        parser.add_argument("--format", default="png", choices=["png", "jpeg", "webp"])
    parser.add_argument("--model", default=_env("IMAGE_USE_MODEL", CODEX_MODEL_DEFAULT),
                        help="(codex backend) the DRIVER model that calls the "
                             "image tool — NOT the image model (the server "
                             "renders with its own, e.g. gpt-image-2-codex). "
                             "Pick a Codex-account model; the fast/affordable "
                             f"ones cost the metered Codex bucket less (default: "
                             f"{CODEX_MODEL_DEFAULT}). Also settable via "
                             "IMAGE_USE_MODEL.")
    # GPT Image 2.5 tool knobs. All codex-only (the web/gemini surfaces expose
    # no such controls), all optional: unset means "keep the backend default".
    parser.add_argument(
        "--image-model",
        default=_env("IMAGE_USE_IMAGE_MODEL"),
        metavar="MODEL",
        help="(codex backend) which GPT Image model the image_generation tool "
             "runs — gpt-image-2.5-sunburst (precise editing) or "
             "gpt-image-2.5-flare (fast, high quality); older gpt-image-2 / "
             "gpt-image-1.5 / gpt-image-1 / gpt-image-1-mini also work. Omit "
             "(or pass 'auto') for the backend default. Also settable via "
             "IMAGE_USE_IMAGE_MODEL. Subject to backend support: the "
             "Codex OAuth path may normalise the model server-side.",
    )
    parser.add_argument(
        "--quality",
        choices=["auto", "low", "medium", "high", "xhigh", "max"],
        default=_env("IMAGE_USE_QUALITY"),
        help="(codex backend) rendering quality for the image_generation "
             "tool. 'xhigh' and 'max' require gpt-image-2.5-sunburst/flare "
             "and are rejected by older models. Omit (or 'auto') for the "
             "backend default. Also settable via IMAGE_USE_QUALITY.",
    )
    parser.add_argument(
        "--background",
        choices=["auto", "transparent", "opaque"],
        default=_env("IMAGE_USE_BACKGROUND"),
        help="(codex backend) background for the image_generation tool. "
             "'transparent' needs png/webp (not jpeg). Omit (or 'auto') for "
             "the backend default. Also settable via "
             "IMAGE_USE_BACKGROUND.",
    )
    parser.add_argument(
        "--compression",
        type=_compression_int,
        default=_opt_int_env("IMAGE_USE_COMPRESSION"),
        metavar="0-100",
        help="(codex backend) output compression percentage for jpeg/webp "
             "(ignored for png). Also settable via "
             "IMAGE_USE_COMPRESSION.",
    )
    parser.add_argument(
        "--action",
        choices=["auto", "generate", "edit"],
        default=_env("IMAGE_USE_ACTION"),
        help="(codex backend) force the image tool to generate a new image "
             "('generate') or edit the attached reference(s) ('edit'); 'auto' "
             "lets the model decide. Also settable via "
             "IMAGE_USE_ACTION.",
    )
    parser.add_argument(
        "--partial-images",
        type=_partial_images_int,
        default=_opt_int_env("IMAGE_USE_PARTIAL_IMAGES"),
        metavar="1-3",
        help="(codex backend) stream 1-3 progressive partial images while the "
             "final image renders (they appear in the progress timeline). "
             "Also settable via IMAGE_USE_PARTIAL_IMAGES.",
    )
    parser.add_argument(
        "-i", "--ref",
        action="append",
        default=None,
        metavar="PATH_OR_URL",
        help="Reference image for image-to-image (repeatable). A local path or "
             "http(s) URL. When given, generation edits the reference(s) instead "
             "of rendering from text. Works on both backends: web attaches it to "
             "the composer (no Codex-usage), codex sends it as an input_image. "
             "Its role defaults to subject; see --ref-role.",
    )
    parser.add_argument(
        "--ref-role",
        choices=["subject", "style", "composition"],
        default="subject",
        help="What every --ref image IS (default: subject). subject: preserve "
             "its identity/appearance. style: match the aesthetic, do not copy "
             "the content. composition: borrow framing/crop/camera only and "
             "render a different subject.",
    )
    parser.add_argument(
        "--style-ref", action="append", default=None, metavar="PATH_OR_URL",
        help="Shorthand for a --ref with role=style (repeatable). Mixes freely "
             "with --ref and --composition-ref.",
    )
    parser.add_argument(
        "--composition-ref", action="append", default=None, metavar="PATH_OR_URL",
        help="Shorthand for a --ref with role=composition (repeatable): borrow "
             "framing/crop/camera angle, do NOT reproduce the subject.",
    )
    parser.add_argument(
        "--backend",
        choices=["auto", "web", "codex", "gemini", "agy"],
        default=_env("IMAGE_USE_BACKEND", "auto"),
        help="auto (default): prefer web (spares Codex-usage limits); fall back "
             "to codex only if the browser isn't available/logged in. "
             "web: force the logged-in-browser path (chrome-use). "
             "codex: force the headless codex/responses path (bills Codex-usage). "
             "gemini: drive a logged-in gemini.google.com browser (a Google "
             "account, not OpenAI — text-to-image results carry a visible "
             "watermark and --size is only a hint). "
             "agy: the Antigravity CLI, headless (slower, square output, keeps "
             "Google's C2PA provenance metadata). Neither gemini nor agy is ever "
             "chosen by auto — ask for them by name. "
             "Also settable via IMAGE_USE_BACKEND.",
    )
    parser.add_argument(
        "--gemini-profile",
        default=_env("IMAGE_USE_GEMINI_PROFILE"),
        help="(gemini backend) Chrome profile to drive, overriding --profile. "
             "Worth setting: nearly every Chrome profile is signed in to SOME "
             "Google account, so auto-detection cannot tell which one holds the "
             "Gemini subscription. Also settable via "
             "IMAGE_USE_GEMINI_PROFILE.",
    )
    parser.add_argument(
        "--no-gemini-image-tool",
        dest="gemini_image_tool",
        action="store_false",
        default=True,
        help="(gemini backend) don't switch the composer to Gemini's dedicated "
             "image tool (Nano Banana 2) — leave whatever chat model is "
             "selected. Enabling the tool is best-effort already; this only "
             "skips the attempt.",
    )
    parser.add_argument(
        "--no-agy-yolo",
        dest="agy_yolo",
        action="store_false",
        default=True,
        help="(agy backend) don't pass --dangerously-skip-permissions. Headless "
             "agy cannot prompt for tool permissions, so without it every run "
             "fails unless you have added your own permissions.allow rules.",
    )
    parser.add_argument(
        "--session",
        default=None,
        help="(web backend) chrome-use session name to reuse a Chrome tab "
             "group across runs (default: imagegen-<pid>).",
    )
    parser.add_argument(
        "--project",
        default=_env("IMAGE_USE_PROJECT", DEFAULT_PROJECT),
        help="(web backend) ChatGPT Project to file the conversation under — "
             f"found by exact name, created if absent (default: {DEFAULT_PROJECT!r}; "
             "also settable via IMAGE_USE_PROJECT). Pass an empty string "
             "to use a plain top-level chat instead.",
    )
    parser.add_argument(
        "--web-model",
        default=_env("IMAGE_USE_WEB_MODEL", WEB_MODEL_DEFAULT),
        help="(web backend) composer model/effort to select before generating — "
             "a comma-separated candidate list, first one present in the picker "
             f"wins (default: {WEB_MODEL_DEFAULT!r}; also settable via "
             "IMAGE_USE_WEB_MODEL). Labels must match the picker exactly. "
             "The 'Pro' tier has no native image generator, so leaving it on Pro "
             "makes the page write Python instead of an image — hence the switch. "
             "Pass an empty string to keep whatever model is already selected.",
    )
    parser.add_argument(
        "--profile",
        default="auto",
        help="(web backend) which Chrome profile to drive. auto (default): "
             "offline-detect a profile that's logged in to chatgpt.com and use "
             "the freshest; relay: use your currently-open Chrome via the "
             "extension; or a profile name like \"Profile 3\".",
    )
    parser.add_argument(
        "--keep-tab",
        action="store_true",
        help="(web backend) leave the ChatGPT tab open after generating instead "
             "of closing it. Implies --keep-conversation (an open tab on a "
             "deleted chat is useless).",
    )
    parser.add_argument(
        "--keep-conversation",
        action="store_true",
        default=_env_bool("IMAGE_USE_KEEP_CONVERSATION"),
        help="(web backend) keep the ChatGPT conversation after generating. "
             "Default: the conversation is DELETED so the run leaves no history "
             "(it's filed under the project only transiently). Also settable via "
             "IMAGE_USE_KEEP_CONVERSATION=1.",
    )
    parser.add_argument(
        "--timeout",
        type=_positive_int,
        default=DEFAULT_TOTAL_TIMEOUT,
        help=f"Total wall-clock budget for the request, in seconds "
             f"(default: {DEFAULT_TOTAL_TIMEOUT}). Large images can take 2-3 min.",
    )
    parser.add_argument(
        "--stall-timeout",
        type=_non_negative_int,
        default=int(DEFAULT_STALL_TIMEOUT),
        help=f"Max seconds of silence (no SSE data / no agy output) before the "
             f"request is declared stalled (default: "
             f"{int(DEFAULT_STALL_TIMEOUT)}). Clamped to --timeout; 0 disables "
             f"stall detection and waits out the full --timeout.",
    )
    parser.add_argument(
        "--quiet",
        action="store_true",
        help="Print only the saved path on stdout (stderr progress is unaffected; "
             "use --no-progress to silence it).",
    )
    parser.add_argument(
        "--no-progress",
        action="store_true",
        help="Suppress the stderr progress timeline (errors are still shown).",
    )
    parser.add_argument(
        "--open",
        dest="open_after",
        action="store_true",
        help="Open the saved image in the OS default viewer after generating "
             "(macOS `open`, Linux `xdg-open`, Windows default). Best-effort.",
    )
    args = parser.parse_args(argv)
    # '' / 'auto' / 'default' mean "backend decides" for the image-tool string
    # knobs; collapse them to None once so every consumer agrees.
    for _attr in ("image_model", "quality", "background", "action"):
        setattr(args, _attr, _image_opt(getattr(args, _attr, None)))
    if animate_mode and args.max_drift < 0:
        parser.error("--max-drift must be zero or greater")
    if animate_mode:
        try:
            animation_out_path, animation_format = _animation_output_path(
                args.prompt, args.out, args.animation_format)
            _animation_preflight(animation_format, args.also_gif)
        except AnimationError as error:
            parser.error(str(error))
    progress = not args.no_progress
    _styles_doc = _load_styles()
    # Self-heal the styles that are about to be applied — explicit `--style NAME`
    # if given, otherwise the saved default set. A missing name is auto-pulled
    # from the gallery; an untouched text-only leftover of a removed built-in is
    # upgraded to the gallery version (with its reference image). Already-good
    # local styles need no network call. `--no-style` short-circuits.
    if not args.no_style:
        _wanted = list(args.style) if args.style else list(_styles_doc.get("default") or [])
        if _wanted:
            _ensure_styles_local(_styles_doc, _wanted)
    # Resolve the active asset set (stacking-aware), fold each asset's snippet
    # into the prompt, then partition the assets' reference images into
    # character/style groups in deterministic order.
    _active = _resolve_active_styles(
        _styles_doc, style_args=args.style, no_style=args.no_style)
    # One-shot online styles (fetched, not persisted) stack on top of local ones.
    _online_snippets, _online_refs = _resolve_online_styles(args.style_online or [])
    _gen_prompt = args.prompt
    for _name in _active:
        _gen_prompt = _compose_prompt(
            _gen_prompt, _styles_doc["styles"][_name].get("snippet"))
    for _snip in _online_snippets:
        _gen_prompt = _compose_prompt(_gen_prompt, _snip)
    args.gen_prompt = _build_animation_prompt(_gen_prompt) if animate_mode else _gen_prompt

    _ordered_refs = _collect_refs(
        _styles_doc, _active, args.ref,
        adhoc_role={"subject": "character"}.get(
            getattr(args, "ref_role", "subject"), getattr(args, "ref_role", "subject")),
        adhoc_style_refs=getattr(args, "style_ref", None),
        adhoc_composition_refs=getattr(args, "composition_ref", None))
    if _online_refs:
        # Keep the character → style → composition grouping stable after
        # merging online refs (sorted() is stable, so intra-group order holds).
        _group_rank = {"character": 0, "style": 1, "composition": 2}
        _ordered_refs = sorted(_ordered_refs + _online_refs,
                               key=lambda r: _group_rank.get(r["group"], 1))
    _kept_refs, _dropped_refs = _cap_refs(_ordered_refs, REF_ATTACH_CAP)
    args.resolved_refs = [r["ref"] for r in _kept_refs]
    args.n_character_refs = sum(1 for r in _kept_refs if r["group"] == "character")
    args.n_style_refs = sum(1 for r in _kept_refs if r["group"] == "style")
    args.n_composition_refs = sum(
        1 for r in _kept_refs if r["group"] == "composition")

    # 0 means "no stall detection"; anything else is clamped to the total budget.
    stall_timeout = (0.0 if args.stall_timeout <= 0
                     else float(min(args.stall_timeout, args.timeout)))
    start = time.monotonic()

    # Over-cap drops are a data-affecting event, not progress chatter: the spec
    # requires we "never silently truncate" and log exactly which refs were
    # dropped. Emit unconditionally to stderr so scripted/`--no-progress`
    # callers still see it (errors/warnings survive `--no-progress`).
    if _dropped_refs:
        names = ", ".join(r["label"] for r in _dropped_refs)
        print(_fmt_progress(
            0.0,
            f"warning: more than {REF_ATTACH_CAP} reference images resolved; "
            f"attaching the first {REF_ATTACH_CAP} (character-first), dropped: "
            f"{names}"), file=sys.stderr)

    # Once-a-day auto-update for interactive runs. Stderr only (stdout stays
    # exactly the saved path), and skipped under --quiet/--no-progress so machine
    # callers stay deterministic. `doctor` checks unconditionally for a deliberate
    # look; failures here degrade to the previous one-line update notice.
    if progress and not args.quiet:
        _maybe_notify_update(
            lambda m: print(_yellow(m), file=sys.stderr), auto_update=True)

    if progress:
        prompt_preview = f"{args.prompt[:60]}{'…' if len(args.prompt) > 60 else ''}"
        mode_bit = " animation-sprite" if animate_mode else ""
        _opt_bit = ""
        if getattr(args, "image_model", None):
            _opt_bit += f" image-model={args.image_model}"
        if getattr(args, "quality", None):
            _opt_bit += f" quality={args.quality}"
        meta_bit = _dim(f"(backend={args.backend} size={args.size} "
                        f"format={args.format}{_opt_bit} "
                        f"timeout={args.timeout}s)")
        print(_fmt_progress(0.0, f"requesting{mode_bit} image  {meta_bit}"), file=sys.stderr)
        print(_dim(f"           prompt: {prompt_preview}"), file=sys.stderr)
        _shown = list(_active) + [f"{s} (online)" for s in (args.style_online or [])]
        if _shown:
            print(_dim(f"           styles: {', '.join(_shown)}"), file=sys.stderr)
        # Provenance for every attached reference (issue #18): make it visible
        # which exact image was sent — a local asset ref, an online gallery ref
        # (with source URL), or an ad-hoc --ref — never leaving the user to guess
        # from a bare "N reference(s)" count.
        if _kept_refs:
            print(_dim(f"           refs: {len(_kept_refs)} attached"), file=sys.stderr)
            for _line in _format_ref_provenance(_kept_refs):
                print(_dim(f"             • {_line}"), file=sys.stderr)

    image_bytes, meta = _dispatch(args, progress, stall_timeout, start)
    _warn_codex_tool_overrides(args, meta.get("effective_tool") or {})

    if animate_mode:
        out_path = animation_out_path
        sprite_path = out_path.with_name(f"{out_path.stem}-sprite.png")
        sprite_path.parent.mkdir(parents=True, exist_ok=True)
        sprite_path.write_bytes(image_bytes)
        try:
            animation_outputs = _render_animation(
                sprite_path=sprite_path,
                sprite_bytes=image_bytes,
                out_path=out_path,
                fmt=animation_format,
                fps=args.fps,
                also_gif=args.also_gif,
                keep_frames=args.keep_frames,
                ping_pong=not args.no_ping_pong,
                max_drift=args.max_drift,
                allow_drift=args.allow_drift,
                progress=progress,
            )
        except AnimationError as error:
            sys.exit(f"animation error: {error}\nsprite sheet kept at {sprite_path}")
    else:
        # What the bytes actually ARE beats what was asked for: when the caller
        # left the filename to us, name the file after the sniffed type so a
        # backend that ignored --format can't produce a .jpg full of PNG.
        _actual_fmt = _fmt_from_mime(meta.get("content_type")) or args.format
        if args.out:
            out_path = Path(args.out)
            if progress:
                _maybe_warn_extension_mismatch(out_path, args.format)
            # Data-affecting, so unconditional (like the over-cap ref warning):
            # a silently mistyped file breaks downstream image pipelines.
            _warn_content_type_mismatch(out_path, args.format,
                                        meta.get("content_type"))
        else:
            out_path = _default_out_path(args.prompt, _actual_fmt)
        out_path.parent.mkdir(parents=True, exist_ok=True)
        out_path.write_bytes(image_bytes)
    # Record this image so `style add --from-last` / `add-ref --from-last` can
    # pin it. The `style` subcommand returns early above, so it never records.
    _record_last_output(out_path)

    if progress:
        size_info = f"  size={meta.get('size')}" if meta.get("size") else ""
        quality_info = f"  quality={meta.get('quality')}" if meta.get("quality") else ""
        # The image model lives in the image_generation_call item when the tool
        # reports it, else in the server's effective tool config (captured from
        # response.created) — which is also where a codex rewrite shows up.
        _eff = meta.get("effective_tool") or {}
        _model = meta.get("model") or _eff.get("model")
        model_info = f"  model={_model}" if _model else ""
        # Codex reports token usage; surface it so the metered cost is visible.
        _usage = meta.get("usage") or {}
        tokens_info = ""
        if _usage.get("total_tokens") is not None:
            tokens_info = (f"  tokens={_usage.get('total_tokens')}"
                           f" (in {_usage.get('input_tokens', '?')}"
                           f" / out {_usage.get('output_tokens', '?')})")
        print(
            _fmt_progress(
                time.monotonic() - start,
                _green(f"✓ saved → {out_path}")
                + _dim(f"  ({len(image_bytes):,} bytes)"
                       f"{size_info}{quality_info}{model_info}{tokens_info}"),
            ),
            file=sys.stderr,
        )
        if animate_mode:
            print(_dim(f"           sprite: {sprite_path}"), file=sys.stderr)
            for extra in animation_outputs[1:]:
                print(_dim(f"           extra: {extra}"), file=sys.stderr)
    if getattr(args, "open_after", False):
        _open_file(out_path, progress)
    # stdout is always exactly the saved path, one line — safe for `$(...)` capture.
    print(out_path)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
