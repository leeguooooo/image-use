ENV_PREFIX = "IMAGE_USE_"
LEGACY_ENV_PREFIX = "CHATGPT_IMAGEGEN_"


def _env(name: str, default: str | None = None) -> str | None:
    """``os.environ.get`` for an IMAGE_USE_* name, falling back to the legacy
    CHATGPT_IMAGEGEN_* spelling, then to ``default``."""
    value = os.environ.get(name)
    if value is not None:
        return value
    if name.startswith(ENV_PREFIX):
        value = os.environ.get(LEGACY_ENV_PREFIX + name[len(ENV_PREFIX):])
        if value is not None:
            return value
    return default

